  let τ := reductionLaw s d c ⟨hs.1.le,hs.2.le⟩ ⟨hd.1.le,hd.2.le⟩ ⟨hc.1.le,hc.2.le⟩
  have hμ := reductionLaw_pos hs hc hd
  have hcost : finiteKL τ μ = ENNReal.ofReal (s*D c d+(1-s)*D d c) := by
    rw [finiteKL_of_supported _ _ (fun z hz => ((hμ z).ne' hz).elim)]
    exact congrArg ENNReal.ofReal (reductionLaw_KL hs hc hd d c _ _)
  have hfirst : finiteFirst τ = finiteFirst μ := by
