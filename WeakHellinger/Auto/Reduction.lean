/-- The two marginal parameters are interior, and differ by d-c. -/
theorem reduction_pq_interior {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    p s c d ∈ Set.Ioo (0 : ℝ) 1 ∧ q s c d ∈ Set.Ioo (0 : ℝ) 1 := by
  have hmix {x y : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 1) (hy : y ∈ Set.Ioo (0 : ℝ) 1) :
      s*x+(1-s)*y ∈ Set.Ioo (0 : ℝ) 1 := by
    constructor
    · nlinarith [mul_nonneg hs.1 hx.1.le,mul_nonneg (sub_nonneg.mpr hs.2) hy.1.le,
        mul_pos (by linarith : 0 < 1-s+s) hx.1,
        mul_nonneg hs.1 (sub_nonneg.mpr (min_le_left x y)),
        mul_nonneg (sub_nonneg.mpr hs.2) (sub_nonneg.mpr (min_le_right x y)),lt_min hx.1 hy.1]
    · have h := mul_nonneg hs.1 (sub_nonneg.mpr hx.2.le)
      have h' := mul_nonneg (sub_nonneg.mpr hs.2) (sub_nonneg.mpr hy.2.le)
      by_cases hzero : s=0
      · subst s; simpa using hy.2
      · have hp := mul_pos (lt_of_le_of_ne hs.1 (Ne.symm hzero)) (sub_pos.mpr hx.2)
        nlinarith
  exact ⟨hmix ⟨by linarith [hc.2],by linarith [hc.1]⟩ hd,
    hmix ⟨by linarith [hd.2],by linarith [hd.1]⟩ hc⟩

/-- Off the diagonal, the source's normalized R is exactly its divergence quotient. -/
theorem reduction_R_quotient {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) (hne : c ≠ d) :
    R s c d = Real.sqrt (D (p s c d) (q s c d)/(s*D c d+(1-s)*D d c)) := by
  have hpq := reduction_pq_interior hs hc hd
  have he : p s c d-q s c d = d-c := by unfold p q; ring
  have hpqne : p s c d ≠ q s c d := by intro h; apply hne; rw [h,sub_self] at he; linarith
  have hsq : (d-c)^2 = (c-d)^2 := by ring
  have hsqne : (c-d)^2 ≠ 0 := pow_ne_zero _ (sub_ne_zero.mpr hne)
  unfold R Rdenominator K
  simp only [hs,hc,hd,hpq.1,hpq.2,hs.1,hs.2,hc.1.le,hc.2.le,hd.1.le,hd.2.le,
    Set.mem_Icc,Set.mem_Ioo,and_self,ite_true,hne,Ne.symm hne,hpqne,ite_false,he,hsq]
  congr 1
  rw [← mul_div_assoc,← mul_div_assoc,← add_div]
  exact div_div_div_cancel_right₀ hsqne _ _

/-- The defining infimum bounds the explicit swapped-law quotient when c differs from d. -/
theorem reduction_complement_quotient {s c d : ℝ} (hs : s ∈ Set.Ioo (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) (hne : c ≠ d) :
    1-sDagger (reductionLaw s c d ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩) ≤
      D (p s c d) (q s c d)/(s*D c d+(1-s)*D d c) := by
  let μ := reductionLaw s c d ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩
  let τ := reductionLaw s d c ⟨hs.1.le,hs.2.le⟩ ⟨hd.1.le,hd.2.le⟩ ⟨hc.1.le,hc.2.le⟩
  have hμ := reductionLaw_pos hs hc hd
  have hadm : reverseAdmissible μ (finiteSecond τ) := by
    apply reverseAdmissible_of_ne _ _ hμ
    intro he
    have he' := congrArg (fun ν : FiniteLaw Bool => ν.mass true) he
    have hq1 := reductionLaw_second_true s d c ⟨hs.1.le,hs.2.le⟩ ⟨hd.1.le,hd.2.le⟩ ⟨hc.1.le,hc.2.le⟩
    have hq2 := reductionLaw_second_true s c d ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩
    have hq : q s d c = q s c d := hq1.symm.trans (he'.trans hq2)
    apply hne
    unfold q at hq
    nlinarith
  have hn : finiteKLReal (finiteSecond τ) (finiteSecond μ) = D (p s c d) (q s c d) := by
    rw [finiteLaw_bool_eq_bernoulli (finiteSecond τ),finiteLaw_bool_eq_bernoulli (finiteSecond μ)]
    trans finiteBinaryKL ((finiteSecond τ).mass true) ((finiteSecond μ).mass true)
    · convert! finiteKLReal_bernoulli
        ⟨(finiteSecond τ).nonneg true,finiteLaw_mass_le_one _ _⟩
        ⟨(finiteSecond μ).nonneg true,finiteLaw_mass_le_one _ _⟩ using 1
    have hq1 := reductionLaw_second_true s d c ⟨hs.1.le,hs.2.le⟩ ⟨hd.1.le,hd.2.le⟩ ⟨hc.1.le,hc.2.le⟩
    have hq2 := reductionLaw_second_true s c d ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩
    change finiteBinaryKL ((finiteSecond τ).mass true) ((finiteSecond μ).mass true) = _
    rw [hq1,hq2]
    rfl
  have h := ENNReal.toReal_mono
    (ENNReal.div_ne_top (by rw [finiteKL_of_supported _ _ hadm.2]; exact ENNReal.ofReal_ne_top)
      (finiteTransportCost_pos _ _ hadm).ne') (reverseComplement_le_ratio μ (finiteSecond τ) hadm)
  rw [ENNReal.toReal_div,finiteKL_toReal _ _ hadm.2,hn] at h
  have hcst := reduction_swap_transport hs hc hd
  have hcst' : (finiteTransportCost μ (finiteSecond τ)).toReal = s*D c d+(1-s)*D d c := by
    rw [hcst,ENNReal.toReal_ofReal]
    exact add_nonneg (mul_nonneg hs.1.le (reduction_D_nonneg ⟨hc.1.le,hc.2.le⟩ hd))
      (mul_nonneg (by linarith [hs.2]) (reduction_D_nonneg ⟨hd.1.le,hd.2.le⟩ hc))
  rw [hcst'] at h
  simpa [sDagger] using h

/-- The three-point theorem yields weak Hellinger for every off-diagonal positive table. -/
theorem reduction_off_diagonal {s c d ρ : ℝ} (hs : s ∈ Set.Ioo (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) (hne : c ≠ d)
    (hchannel : sDagger (reductionLaw s c d ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩) ≤ ρ^2) :
    r (2*q s c d-1)-s*r (2*d-1)-(1-s)*r (2*c-1) ≤ 1-Real.sqrt (1-ρ^2) := by
  have hquot := reduction_complement_quotient hs hc hd hne
  have hr : Real.sqrt (1-ρ^2) ≤ R s c d := by
    rw [reduction_R_quotient ⟨hs.1.le,hs.2.le⟩ hc hd hne]
    exact Real.sqrt_le_sqrt (by linarith)
  have h := three_point_inequality ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩
  linarith

/-- With probability epsilon resample V from a biased sign of probability 3/4. -/
def reductionPerturbation (ε : ℝ) (hε : ε ∈ Set.Icc (0 : ℝ) 1) (v : Bool) : FiniteLaw Bool :=
  bernoulliLaw (if v then 1-ε/4 else 3*ε/4) (by
    cases v <;> simp <;> constructor <;> linarith [hε.1,hε.2])

/-- Every transition of the perturbation is strictly positive when 0<epsilon<1. -/
theorem reductionPerturbation_pos {ε : ℝ} (hε : ε ∈ Set.Ioo (0 : ℝ) 1) (v w : Bool) :
    0 < (reductionPerturbation ε ⟨hε.1.le,hε.2.le⟩ v).mass w := by
  cases v <;> cases w <;> simp [reductionPerturbation,bernoulliLaw] <;> linarith [hε.1,hε.2]

/-- The perturbed conditional probabilities remain interior. -/
theorem reduction_perturbed_interior {x ε : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 1)
    (hε : ε ∈ Set.Ioo (0 : ℝ) 1) (a : ℝ) (ha : a ∈ Set.Ioo (0 : ℝ) 1) :
    (1-ε)*x+a*ε ∈ Set.Ioo (0 : ℝ) 1 := by
  constructor
  · exact add_pos (mul_pos (sub_pos.mpr hε.2) hx.1) (mul_pos ha.1 hε.1)
  · nlinarith [mul_pos (sub_pos.mpr hε.2) (sub_pos.mpr hx.2),
      mul_pos hε.1 (sub_pos.mpr ha.2)]

/-- The perturbation changes c,d by different biases, breaking the diagonal. -/
theorem reduction_perturb_table {s c d ε : ℝ}
    (hs : s ∈ Set.Ioo (0 : ℝ) 1) (hc : c ∈ Set.Ioo (0 : ℝ) 1)
    (hd : d ∈ Set.Ioo (0 : ℝ) 1) (hε : ε ∈ Set.Ioo (0 : ℝ) 1) :
    finiteRightChannel
      (reductionLaw s c d ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩)
      (reductionPerturbation ε ⟨hε.1.le,hε.2.le⟩) =
    reductionLaw s ((1-ε)*c+(3/4)*ε) ((1-ε)*d+(1/4)*ε) ⟨hs.1.le,hs.2.le⟩
      ⟨(reduction_perturbed_interior hc hε (3/4) (by constructor <;> norm_num)).1.le,
       (reduction_perturbed_interior hc hε (3/4) (by constructor <;> norm_num)).2.le⟩
      ⟨(reduction_perturbed_interior hd hε (1/4) (by constructor <;> norm_num)).1.le,
       (reduction_perturbed_interior hd hε (1/4) (by constructor <;> norm_num)).2.le⟩ := by
  classical
  ext ⟨u,v⟩
  cases u <;> cases v <;>
    simp [finiteRightChannel,finiteMap,finiteExtendRight,reductionLaw,finiteJoint,
      reductionPerturbation,bernoulliLaw,Fintype.sum_prod_type] <;> ring

/-- Weak Hellinger for a diagonal positive table, by stochastic perturbation and continuity. -/
theorem reduction_diagonal {s c ρ : ℝ} (hs : s ∈ Set.Ioo (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1)
    (hchannel : sDagger (reductionLaw s c c ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hc.1.le,hc.2.le⟩) ≤ ρ^2) :
    r (2*q s c c-1)-s*r (2*c-1)-(1-s)*r (2*c-1) ≤ 1-Real.sqrt (1-ρ^2) := by
  have hbound (ε : ℝ) (hε : ε ∈ Set.Ioo (0 : ℝ) 1) :
      r (2*q s ((1-ε)*c+(3/4)*ε) ((1-ε)*c+(1/4)*ε)-1)-
        s*r (2*((1-ε)*c+(1/4)*ε)-1)-(1-s)*r (2*((1-ε)*c+(3/4)*ε)-1) ≤
      1-Real.sqrt (1-ρ^2) := by
    have hcε := reduction_perturbed_interior hc hε (3/4) (by constructor <;> norm_num)
    have hdε := reduction_perturbed_interior hc hε (1/4) (by constructor <;> norm_num)
    have h := (sDagger_rightChannel_le _ _ (reductionLaw_pos hs hc hc)
      (reductionPerturbation_pos hε)).trans hchannel
    have he := congrArg sDagger (reduction_perturb_table hs hc hc hε)
    apply reduction_off_diagonal hs hcε hdε (by intro he; linarith [hε.1])
    convert! he ▸ h using 1
  have hcont : Continuous (fun ε : ℝ =>
      r (2*q s ((1-ε)*c+(3/4)*ε) ((1-ε)*c+(1/4)*ε)-1)-
        s*r (2*((1-ε)*c+(1/4)*ε)-1)-(1-s)*r (2*((1-ε)*c+(3/4)*ε)-1)) := by
    unfold r q
    fun_prop
  have ht := hcont.continuousAt.tendsto.mono_left
    (show nhdsWithin (0 : ℝ) (Set.Ioi 0) ≤ nhds 0 from nhdsWithin_le_nhds)
  have hb : ∀ᶠ ε in nhdsWithin (0 : ℝ) (Set.Ioi 0), ε ∈ Set.Ioo (0 : ℝ) 1 := by
    filter_upwards [self_mem_nhdsWithin, nhdsWithin_le_nhds (Iio_mem_nhds (by norm_num : (0 : ℝ) < 1))] with ε hε hε'
    exact ⟨hε,hε'⟩
  have h := le_of_tendsto ht (hb.mono fun ε hε => hbound ε hε)
  simpa using h

/-- Every positive binary law satisfies weak Hellinger at its channel bound. -/
theorem reduction_positive_law (μ : FiniteLaw (Bool × Bool)) (hμ : ∀ z, 0 < μ.mass z)
    (ρ : ℝ) (hchannel : sDagger μ ≤ ρ^2) :
    r (finiteExpectation μ (fun z => boolSign z.2)) -
      conditionalSemicircle μ (fun z => boolSign z.2) Prod.fst ≤ 1-Real.sqrt (1-ρ^2) := by
  obtain ⟨s,c,d,hs,hc,hd,he⟩ := reductionLaw_representation μ hμ
  subst μ
  have hm := reductionLaw_mean s c d ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩
  have hec := reductionLaw_semicircle s c d hs ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩
  rw [hm,hec]
  have h : r (2*q s c d-1)-s*r (2*d-1)-(1-s)*r (2*c-1) ≤ 1-Real.sqrt (1-ρ^2) := by
    by_cases hcd : c=d
    · subst d; exact reduction_diagonal hs hc hchannel
    · exact reduction_off_diagonal hs hc hd hcd hchannel
  linarith

/-- The conditional semicircle expectation is nonnegative, including null fibers. -/
theorem reduction_semicircle_nonneg {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (f : α → ℝ) (g : α → β) : 0 ≤ conditionalSemicircle μ f g := by
  exact Finset.sum_nonneg (fun b _ => mul_nonneg ((finiteMap μ g).nonneg b) (Real.sqrt_nonneg _))

/-- Every real semicircle value is at most one under Lean's real square-root convention. -/
theorem reduction_r_le_one (x : ℝ) : r x ≤ 1 := by
  unfold r
  exact (Real.sqrt_le_one).mpr (by nlinarith [sq_nonneg x])

/-- The endpoint correlations have right-hand side one, which always bounds the gap. -/
theorem reduction_endpoint {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (f : α → ℝ) (g : α → β) {ρ : ℝ} (hρ : ρ = -1 ∨ ρ = 1) :
    r (finiteExpectation μ f)-conditionalSemicircle μ f g ≤ 1-Real.sqrt (1-ρ^2) := by
  have h := reduction_r_le_one (finiteExpectation μ f)
  have h' := reduction_semicircle_nonneg μ f g
  have he : Real.sqrt (1-ρ^2) = 0 := by rcases hρ with rfl | rfl <;> norm_num
  rw [he]
  linarith

/-- The desired right-hand side is nonnegative for every real correlation. -/
theorem reduction_rhs_nonneg (ρ : ℝ) : 0 ≤ 1-Real.sqrt (1-ρ^2) := by
  have h := reduction_r_le_one ρ
  exact sub_nonneg.mpr h

/-- A constant Boolean f has zero unconditional semicircle and a nonpositive gap. -/
theorem reduction_constant_f {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (b : Bool) (g : α → β) (ρ : ℝ) :
    r (finiteExpectation μ (fun _ => boolSign b)) -
      conditionalSemicircle μ (fun _ => boolSign b) g ≤ 1-Real.sqrt (1-ρ^2) := by
  have he : finiteExpectation μ (fun _ => boolSign b) = boolSign b := by
    unfold finiteExpectation
    rw [← Finset.sum_mul, μ.total,one_mul]
  have hr : r (boolSign b) = 0 := by cases b <;> norm_num [r,boolSign]
  rw [he,hr]
  linarith [reduction_semicircle_nonneg μ (fun _ => boolSign b) g,reduction_rhs_nonneg ρ]

/-- With a constant observation the conditional mean equals the unconditional mean
on its only positive-mass fiber; all other fibers contribute zero. -/
theorem reduction_constant_g {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (f : α → ℝ) (b : β) :
    conditionalSemicircle μ f (fun _ => b) = r (finiteExpectation μ f) := by
  classical
  have hm (u : β) : (finiteMap μ (fun _ => b)).mass u = if b=u then 1 else 0 := by
    by_cases he : b=u
    · simp [finiteMap,he,μ.total]
    · simp [finiteMap,he]
  have hc : finiteConditionalMean μ f (fun _ => b) b = finiteExpectation μ f := by
    simp [finiteConditionalMean,hm,finiteExpectation]
  unfold conditionalSemicircle finiteExpectation
  simp_rw [hm]
  simp only [ite_mul,one_mul,zero_mul]
  simp only [Finset.sum_ite_eq,Finset.mem_univ,ite_true,hc]
  rfl

/-- Weak Hellinger for a constant Boolean observation, with the null fibers explicit. -/
theorem reduction_constant_observation {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (f : α → ℝ) (b : β) (ρ : ℝ) :
    r (finiteExpectation μ f)-conditionalSemicircle μ f (fun _ => b) ≤ 1-Real.sqrt (1-ρ^2) := by
  rw [reduction_constant_g,sub_self]
  exact reduction_rhs_nonneg ρ

/-- Weak Hellinger, source `thm:main`, for uniformly distributed rho-correlated
Boolean cubes. `true` denotes +1 and `false` denotes -1, so `boolSign ∘ f` and
`boolSign ∘ g` are exactly the source's sign-valued Boolean functions.
`cubeNoiseLaw` is the uniform independent-bit-flip joint law; `conditionalSemicircle`
is the finite expectation of sqrt(1-E[f(X)|g(Y)]²), with zero-mass fibers omitted
by their zero weight. No nonconstancy or nondegeneracy hypotheses are needed.
The proof actually includes the zero-dimensional cube as well. -/
theorem weak_hellinger (n : ℕ) (ρ : ℝ) (hρ : ρ ∈ Set.Icc (-1 : ℝ) 1)
    (f g : BooleanCube n → Bool) :
    Real.sqrt (1-(finiteExpectation (cubeNoiseLaw n ρ hρ) (fun z => boolSign (f z.1)))^2) -
      conditionalSemicircle (cubeNoiseLaw n ρ hρ) (fun z => boolSign (f z.1)) (fun z => g z.2) ≤
      1-Real.sqrt (1-ρ^2) := by
  classical
  change r (finiteExpectation _ _) - _ ≤ _
  by_cases hf : ∃ b, ∀ x, f x=b
  · obtain ⟨b,hb⟩ := hf
    have he : f = fun _ => b := funext hb
    subst f
    exact reduction_constant_f _ b _ ρ
  by_cases hg : ∃ b, ∀ y, g y=b
  · obtain ⟨b,hb⟩ := hg
    have he : g = fun _ => b := funext hb
    subst g
    exact reduction_constant_observation _ _ b ρ
  by_cases he : ρ=-1 ∨ ρ=1
  · exact reduction_endpoint _ _ _ he
  have hρ' : ρ ∈ Set.Ioo (-1 : ℝ) 1 := by
    constructor <;> rcases hρ with ⟨hl,hu⟩ <;> push Not at he <;> grind
  have hfs := reduction_bool_surjective f hf
  have hgs := reduction_bool_surjective g hg
  let μ := finiteMap (cubeNoiseLaw n ρ hρ) (fun z => (g z.2,f z.1))
  have hsurj : Function.Surjective (fun z : BooleanCube n × BooleanCube n => (g z.2,f z.1)) := by
    rintro ⟨u,v⟩
    obtain ⟨x,hx⟩ := hfs v
    obtain ⟨y,hy⟩ := hgs u
    exact ⟨(x,y),by simp [hx,hy]⟩
  have hμ : ∀ z, 0 < μ.mass z := finiteMap_pos _ (cubeNoiseLaw_pos n hρ') _ hsurj
  have hchannel : sDagger μ ≤ ρ^2 := reduction_output_bound n hρ' f g hfs hgs
  have h := reduction_positive_law μ hμ ρ hchannel
  have hm := finiteExpectation_map (cubeNoiseLaw n ρ hρ) (fun z => (g z.2,f z.1))
    (fun z => boolSign z.2)
  have hc := reduction_semicircle_map (cubeNoiseLaw n ρ hρ) (fun z => f z.1) (fun z => g z.2) boolSign
  change finiteExpectation μ (fun z => boolSign z.2) = _ at hm
  change conditionalSemicircle μ (fun z => boolSign z.2) Prod.fst = _ at hc
  rw [hm,hc] at h
  exact h

end

