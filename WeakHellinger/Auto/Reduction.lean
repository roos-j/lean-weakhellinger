/-- Exact conditional entropy cost between two tables with the same U marginal. -/
theorem reductionLaw_KL {s c d : ℝ} (hs : s ∈ Set.Ioo (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1)
    (e f : ℝ) (he : e ∈ Set.Icc (0 : ℝ) 1) (hf : f ∈ Set.Icc (0 : ℝ) 1) :
    finiteKLReal (reductionLaw s e f ⟨hs.1.le,hs.2.le⟩ he hf)
      (reductionLaw s c d ⟨hs.1.le,hs.2.le⟩ ⟨hc.1.le,hc.2.le⟩ ⟨hd.1.le,hd.2.le⟩) =
      s*D f d+(1-s)*D e c := by
  unfold reductionLaw
  rw [finiteKLReal_joint]
  · rw [finiteKLReal_self,zero_add]
    simp only [Fintype.sum_bool,bernoulliLaw,Bool.false_eq_true,ite_true,ite_false,finiteKLReal]
    change s*finiteBinaryKL (1-f) (1-d)+(1-s)*finiteBinaryKL e c = _
    change s*D (1-f) (1-d)+(1-s)*D e c = _
    rw [reduction_D_complement]
  · intro u; cases u <;> simp [bernoulliLaw] <;> linarith [hs.1,hs.2]
  · intro u v; cases u <;> cases v <;> simp [bernoulliLaw] <;> linarith [hc.1,hc.2,hd.1,hd.2]

