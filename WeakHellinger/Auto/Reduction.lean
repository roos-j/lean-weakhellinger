  apply le_sInf
  rintro v ⟨κ,hκ,rfl⟩
  have hkfirst : finiteFirst κ = bernoulliLaw s ⟨hs.1.le,hs.2.le⟩ :=
    hκ.1.trans (finiteFirst_joint _ _)
