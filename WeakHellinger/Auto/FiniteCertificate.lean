/-- Extensionality for exact rational-expression node certificates. -/
theorem rationalPolynomial_ext {p q : RationalPolynomial}
    (hn : p.numerator = q.numerator) (hd : p.denominator = q.denominator)
    (ha : p.a = q.a) (hb : p.b = q.b) : p = q := by
  cases p; cases q; simp_all

set_option Elab.async false

/-- Blueprint `lem:finite-certificate`: reconstruct a rational product from its four checked data fields. -/
theorem rationalMul_eq_of_fields {p q r : RationalPolynomial}
    (hn : polyMul p.numerator q.numerator = r.numerator)
    (hd : p.denominator * q.denominator = r.denominator)
    (ha : p.a + q.a = r.a) (hb : p.b + q.b = r.b) :
    rationalMul p q = r :=
  @rationalPolynomial_ext (rationalMul p q) r hn hd ha hb

/-- Blueprint `lem:finite-certificate`: reconstruct a rational square using its checked numerator product and
the multiplication-by-one normalization required by the fixed expression tree. -/
theorem rationalPow_two_eq_of_fields {p r : RationalPolynomial}
    (hu : polyMul (polyConst 1) p.numerator = p.numerator)
    (hn : polyMul p.numerator p.numerator = r.numerator)
    (hd : p.denominator * p.denominator = r.denominator)
    (ha : p.a + p.a = r.a) (hb : p.b + p.b = r.b) :
