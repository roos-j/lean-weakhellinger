/-- The seven proposed chart polynomials, each verified by its guarded generator. -/
def chartCandidate : Chart → IntPolynomial
  | .N1 => candidateN1
  | .N2 => candidateN2
  | .N3 => candidateN3
  | .P1 => candidateP1
  | .P2 => candidateP2
  | .P3 => candidateP3
  | .B1 => candidateB1

/-- Every chart generator returns exactly its reconstruction-checked candidate. -/
theorem chartPolynomialResult_eq_some (c : Chart) :
    chartPolynomialResult c = some (chartCandidate c) := by
  cases c
  · exact chartN1Result_eq_some
  · exact chartN2Result_eq_some
  · exact chartN3Result_eq_some
  · exact chartP1Result_eq_some
  · exact chartP2Result_eq_some
  · exact chartP3Result_eq_some
  · exact chartB1Result_eq_some

theorem chartPolynomial_eq_candidate (c : Chart) :
    chartPolynomial c = chartCandidate c := by
  simp only [chartPolynomial, chartPolynomialResult_eq_some, Option.getD_some]

/-- Transfer the exhaustive Bernstein certificates to the actual generator outputs. -/
theorem chart_bernstein_checked (c : Chart) :
    supportCheck (chartPolynomial c) (chartDegree c) = true ∧
    coefficientCheck (chartPolynomial c) (chartDegree c) = true ∧
    coefficientCounts (chartPolynomial c) (chartDegree c) = chartCounts c ∧
    witnessCheck (chartPolynomial c) (chartDegree c) (chartWitnesses c) = true := by
  rw [chartPolynomial_eq_candidate]
  cases c
  · exact bernstein_N1_checked
  · exact bernstein_N2_checked
  · exact bernstein_N3_checked
  · exact bernstein_P1_checked
  · exact bernstein_P2_checked
  · exact bernstein_P3_checked
  · exact bernstein_B1_checked

/-- Blueprint `lem:finite-certificate`: every prescribed reconstruction, degree,
full-box Bernstein sign and count, witness, and homogeneous center check succeeds. -/
theorem chartCheck_checked (c : Chart) : chartCheck c = true := by
  have hf : (baseFResult (chartCase c)).isSome = true := by
    rw [baseFResult_eq_some]
    rfl
  have hh : (baseHResult (chartCase c)).isSome = true := by
    rw [baseHResult_eq_some]
    rfl
  have hc : (chartPolynomialResult c).isSome = true := by
    rw [chartPolynomialResult_eq_some]
    rfl
  have he : homogeneousEval (baseF (chartCase c)) (baseFDegree (chartCase c))
      (chartCenterData c).1 (chartCenterData c).2.1 = (chartCenterData c).2.2 := by
    rw [baseF_eq_candidate]
    exact (chart_center_values_checked c).1
  rcases chart_bernstein_checked c with ⟨hs, hb, hn, hw⟩
  simp only [chartCheck, Bool.and_eq_true, decide_eq_true_eq, and_assoc]
  exact ⟨hf, hh, hc, (base_degrees _).1, (base_degrees _).2, hs, hb, hn, hw, he⟩

/-- Blueprint `lem:finite-certificate`: all seven complete certificate checks
succeed, and the checked homogeneous center values are strictly positive. -/
theorem finite_certificate (c : Chart) :
    chartCheck c = true ∧ 0 < (chartCenterData c).2.2 :=
  ⟨chartCheck_checked c, (chart_center_values_checked c).2⟩

