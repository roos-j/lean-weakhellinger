private theorem smallChoose_rows (n : Fin 43) :
    (Array.ofFn fun k : Fin 43 => n.val.choose k.val) =
      smallChooseTable[n.val]'(by rw [smallChooseTable_size]; exact n.isLt) := by
  fin_cases n <;> decide +kernel

def smallChoose (n k : ℕ) : ℕ :=
  (((smallChooseTable[n]?).getD #[])[k]?).getD 0

/-- The shared table is exactly Nat.choose on all required degrees. -/
theorem smallChoose_eq {n k : ℕ} (hn : n ≤ 42) (hk : k ≤ 42) :
    smallChoose n k = n.choose k := by
  have hn' : n < 43 := by omega
  have hk' : k < 43 := by omega
  have h := congrArg (fun a : Array ℕ => (a[k]?).getD 0) (smallChoose_rows ⟨n, hn'⟩)
  have hnb : n < smallChooseTable.size := by rwa [smallChooseTable_size]
  simpa [smallChoose, Array.getElem?_ofFn,
    smallChooseTable_size, hn', hk'] using h.symm

def bernsteinFastPass1 (n : Exponent) (c : Exponent → ℤ) (β : Exponent) : ℤ :=
  ∑ i ∈ Finset.range (β.1 + 1),
    c (i, β.2.1, β.2.2) * (smallChoose (n.1 - i) (β.1 - i) : ℤ)

/-- The checked weight table preserves Bernstein pass 1 on its stored box. -/
theorem bernsteinPass1_fast_array (n : Exponent) (c : Exponent → ℤ)
    (hn : n.1 ≤ 42) :
    coefficientArray n (bernsteinPass1 n c) =
      coefficientArray n (bernsteinFastPass1 n c) := by
  apply coefficientArray_congr
  intro β hβ
  unfold bernsteinPass1 bernsteinFastPass1
  apply Finset.sum_congr rfl
  intro i hi
  rw [smallChoose_eq ((Nat.sub_le _ _).trans hn)
    ((Nat.sub_le _ _).trans (hβ.1.trans hn))]

def bernsteinFastPass2 (n : Exponent) (c : Exponent → ℤ) (β : Exponent) : ℤ :=
  ∑ i ∈ Finset.range (β.2.1 + 1),
    c (β.1, i, β.2.2) * (smallChoose (n.2.1 - i) (β.2.1 - i) : ℤ)

/-- The checked weight table preserves Bernstein pass 2 on its stored box. -/
theorem bernsteinPass2_fast_array (n : Exponent) (c : Exponent → ℤ)
    (hn : n.2.1 ≤ 42) :
    coefficientArray n (bernsteinPass2 n c) =
      coefficientArray n (bernsteinFastPass2 n c) := by
  apply coefficientArray_congr
  intro β hβ
  unfold bernsteinPass2 bernsteinFastPass2
  apply Finset.sum_congr rfl
  intro i hi
  rw [smallChoose_eq ((Nat.sub_le _ _).trans hn)
    ((Nat.sub_le _ _).trans (hβ.2.1.trans hn))]

def bernsteinFastPass3 (n : Exponent) (c : Exponent → ℤ) (β : Exponent) : ℤ :=
  ∑ i ∈ Finset.range (β.2.2 + 1),
    c (β.1, β.2.1, i) * (smallChoose (n.2.2 - i) (β.2.2 - i) : ℤ)

/-- The checked weight table preserves Bernstein pass 3 on its stored box. -/
theorem bernsteinPass3_fast_array (n : Exponent) (c : Exponent → ℤ)
    (hn : n.2.2 ≤ 42) :
    coefficientArray n (bernsteinPass3 n c) =
      coefficientArray n (bernsteinFastPass3 n c) := by
  apply coefficientArray_congr
  intro β hβ
  unfold bernsteinPass3 bernsteinFastPass3
  apply Finset.sum_congr rfl
  intro i hi
  rw [smallChoose_eq ((Nat.sub_le _ _).trans hn)
    ((Nat.sub_le _ _).trans (hβ.2.2.trans hn))]

