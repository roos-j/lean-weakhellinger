/-- Cache the three finite passes independently; this shares their intermediate
arrays during candidate evaluation without changing any integer recurrence. -/
def bernsteinArray (p : IntPolynomial) (n : Exponent) : Array (Array (Array ℤ)) :=
  let c₀ := coefficientSeed p n
  let c₁ := coefficientArray n (bernsteinPass1 n (coefficientLookup c₀))
  let c₂ := coefficientArray n (bernsteinPass2 n (coefficientLookup c₁))
  coefficientArray n (bernsteinPass3 n (coefficientLookup c₂))

/-- The three array-node checks reconstruct the fixed Bernstein computation. -/
theorem bernsteinArray_of_nodes (p : IntPolynomial) (n : Exponent)
    (a₀ a₁ a₂ a₃ : Array (Array (Array ℤ)))
    (h₀ : coefficientSeed p n = a₀)
    (h₁ : coefficientArray n (bernsteinPass1 n (coefficientLookup a₀)) = a₁)
    (h₂ : coefficientArray n (bernsteinPass2 n (coefficientLookup a₁)) = a₂)
    (h₃ : coefficientArray n (bernsteinPass3 n (coefficientLookup a₂)) = a₃) :
    bernsteinArray p n = a₃ := by
  unfold bernsteinArray
  dsimp only
  rw [h₀, h₁, h₂, h₃]
theorem bernsteinPass1_congr {n : Exponent} {f g : Exponent → ℤ}
    (h : ∀ β, β ≤ n → f β = g β) {β : Exponent} (hβ : β ≤ n) :
    bernsteinPass1 n f β = bernsteinPass1 n g β := by
  apply Finset.sum_congr rfl
  intro i hi
  rw [h (i, β.2.1, β.2.2) ⟨(Nat.le_of_lt_succ (Finset.mem_range.mp hi)).trans hβ.1,
    hβ.2.1, hβ.2.2⟩]

theorem bernsteinPass2_congr {n : Exponent} {f g : Exponent → ℤ}
    (h : ∀ β, β ≤ n → f β = g β) {β : Exponent} (hβ : β ≤ n) :
    bernsteinPass2 n f β = bernsteinPass2 n g β := by
  apply Finset.sum_congr rfl
  intro j hj
  rw [h (β.1, j, β.2.2) ⟨hβ.1,
    (Nat.le_of_lt_succ (Finset.mem_range.mp hj)).trans hβ.2.1, hβ.2.2⟩]

theorem bernsteinPass3_congr {n : Exponent} {f g : Exponent → ℤ}
    (h : ∀ β, β ≤ n → f β = g β) {β : Exponent} (hβ : β ≤ n) :
    bernsteinPass3 n f β = bernsteinPass3 n g β := by
  apply Finset.sum_congr rfl
  intro k hk
  rw [h (β.1, β.2.1, k) ⟨hβ.1, hβ.2.1,
    (Nat.le_of_lt_succ (Finset.mem_range.mp hk)).trans hβ.2.2⟩]

def coefficientCheck (p : IntPolynomial) (n : Exponent) : Bool :=
  let b := bernsteinArray p n
  (exponentList n).all fun β => decide (0 ≤ coefficientLookup b β)

def witnessCheck (p : IntPolynomial) (n : Exponent) (w : List (Exponent × ℤ)) : Bool :=
  let b := bernsteinArray p n
  w.all fun t => decide (t.1 ≤ n ∧ 0 < t.2 ∧ coefficientLookup b t.1 = t.2)

def coefficientCounts (p : IntPolynomial) (n : Exponent) : ℕ × ℕ :=
  let b := bernsteinArray p n
  let values := (exponentList n).map (coefficientLookup b)
  ((values.filter fun v => decide (0 < v)).length, (values.filter fun v => decide (v = 0)).length)

/-- Exact full-box signs, counts, and witnesses stated on a checked literal array. -/
def arrayBernsteinClaims (b : Array (Array (Array ℤ))) (n : Exponent)
    (counts : ℕ × ℕ) (w : List (Exponent × ℤ)) : Prop :=
  (exponentList n).all (fun β => decide (0 ≤ coefficientLookup b β)) = true ∧
  (let values := (exponentList n).map (coefficientLookup b)
   ((values.filter fun v => decide (0 < v)).length,
    (values.filter fun v => decide (v = 0)).length)) = counts ∧
  w.all (fun t => decide (t.1 ≤ n ∧ 0 < t.2 ∧ coefficientLookup b t.1 = t.2)) = true

instance (b : Array (Array (Array ℤ))) (n : Exponent)
    (counts : ℕ × ℕ) (w : List (Exponent × ℤ)) : Decidable (arrayBernsteinClaims b n counts w) := by
  unfold arrayBernsteinClaims
  infer_instance

/-- Transfer checked literal-array data to the source's computation predicates. -/
theorem bernsteinData_of_array (p : IntPolynomial) (n : Exponent)
    (counts : ℕ × ℕ) (w : List (Exponent × ℤ)) (b : Array (Array (Array ℤ)))
    (hb : bernsteinArray p n = b) (hs : supportCheck p n = true)
    (hd : arrayBernsteinClaims b n counts w) :
    supportCheck p n = true ∧ coefficientCheck p n = true ∧
      coefficientCounts p n = counts ∧ witnessCheck p n w = true := by
  dsimp only [coefficientCheck, coefficientCounts, witnessCheck]
  rw [hb]
  exact ⟨hs, hd⟩
/-- All required generator-success, support, coefficient, witness and center
checks for one row. Reconstruction is enforced inside every generator. -/
def chartCheck (c : Chart) : Bool :=
  let case := chartCase c
  let p := chartPolynomial c
  let n := chartDegree c
  let center := chartCenterData c
