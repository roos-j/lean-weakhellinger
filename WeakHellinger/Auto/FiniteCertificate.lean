private theorem treeChoose_rows (n : Fin 43) :
    (Array.ofFn fun k : Fin 43 => treeChoose n.val k.val) =
      (Array.ofFn fun k : Fin 43 => n.val.choose k.val) := by
  fin_cases n <;> apply beq_iff_eq.mp <;> decide +kernel

/-- The balanced table gives exactly Nat.choose on every degree used here. -/
theorem treeChoose_eq {n k : ℕ} (hn : n ≤ 42) (hk : k ≤ 42) :
    treeChoose n k = n.choose k := by
  have hn' : n < 43 := by omega
  have hk' : k < 43 := by omega
  have h := congrArg (fun a : Array ℕ => (a[k]?).getD 0) (treeChoose_rows ⟨n, hn'⟩)
  simpa [Array.getElem?_ofFn, hk'] using h


def bernsteinTreePass1 (n : Exponent) (c : Exponent → ℤ) (β : Exponent) : ℤ :=
  ∑ i ∈ Finset.range (β.1 + 1),
    c (i, β.2.1, β.2.2) * (treeChoose (n.1 - i) (β.1 - i) : ℤ)

theorem bernsteinPass1_tree_array (n : Exponent) (c : Exponent → ℤ)
    (hn : n.1 ≤ 42) :
    coefficientArray n (bernsteinPass1 n c) =
      coefficientArray n (bernsteinTreePass1 n c) := by
  apply coefficientArray_congr
  intro β hβ
  unfold bernsteinPass1 bernsteinTreePass1
  apply Finset.sum_congr rfl
  intro i hi
  rw [treeChoose_eq ((Nat.sub_le _ _).trans hn)
    ((Nat.sub_le _ _).trans (hβ.1.trans hn))]

def bernsteinTreePass2 (n : Exponent) (c : Exponent → ℤ) (β : Exponent) : ℤ :=
  ∑ i ∈ Finset.range (β.2.1 + 1),
    c (β.1, i, β.2.2) * (treeChoose (n.2.1 - i) (β.2.1 - i) : ℤ)

theorem bernsteinPass2_tree_array (n : Exponent) (c : Exponent → ℤ)
    (hn : n.2.1 ≤ 42) :
    coefficientArray n (bernsteinPass2 n c) =
      coefficientArray n (bernsteinTreePass2 n c) := by
  apply coefficientArray_congr
  intro β hβ
  unfold bernsteinPass2 bernsteinTreePass2
  apply Finset.sum_congr rfl
  intro i hi
  rw [treeChoose_eq ((Nat.sub_le _ _).trans hn)
    ((Nat.sub_le _ _).trans (hβ.2.1.trans hn))]

def bernsteinTreePass3 (n : Exponent) (c : Exponent → ℤ) (β : Exponent) : ℤ :=
  ∑ i ∈ Finset.range (β.2.2 + 1),
    c (β.1, β.2.1, i) * (treeChoose (n.2.2 - i) (β.2.2 - i) : ℤ)

theorem bernsteinPass3_tree_array (n : Exponent) (c : Exponent → ℤ)
    (hn : n.2.2 ≤ 42) :
    coefficientArray n (bernsteinPass3 n c) =
      coefficientArray n (bernsteinTreePass3 n c) := by
  apply coefficientArray_congr
  intro β hβ
  unfold bernsteinPass3 bernsteinTreePass3
  apply Finset.sum_congr rfl
  intro i hi
  rw [treeChoose_eq ((Nat.sub_le _ _).trans hn)
    ((Nat.sub_le _ _).trans (hβ.2.2.trans hn))]

/-- A checked tabulation determines every lookup in its prescribed box. -/
theorem coefficientLookup_of_array {n : Exponent} {f : Exponent → ℤ}
    {a : Array (Array (Array ℤ))} (ha : coefficientArray n f = a)
    (β : Exponent) (hβ : β ≤ n) : coefficientLookup a β = f β := by
  rw [← ha]
  exact cacheBox_eq n f β hβ

