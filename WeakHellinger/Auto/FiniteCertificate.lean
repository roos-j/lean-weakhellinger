/-- Assemble successful option-valued certificate nodes without evaluating
surrounding computations while rewriting a closed intermediate result. -/
theorem optionBind_eq_some {α β : Type*} {m : Option α} {f : α → Option β}
    {a : α} {b : β} (hm : m = some a) (hf : f a = some b) : m.bind f = some b := by
  rw [hm]
  exact hf

/-- Blueprint `lem:finite-certificate`: zero-shift substitution is the direct
zero-shift operation; this symbolic equality avoids unfolding a closed polynomial
while assembling the P1 and P2 generator checks. -/
theorem polyHalfSubstitute_zero (p : IntPolynomial) (i : Fin 3) :
    polyHalfSubstitute p i 0 = polyHalfZero p i := rfl

