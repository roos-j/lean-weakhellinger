/-- A successful guarded division returns its proposed, reconstruction-checked quotient. -/
theorem polyDivideCandidate_eq_some {p q candidate : IntPolynomial}
    (h : (polyDivideCandidate p q candidate).isSome = true) :
    polyDivideCandidate p q candidate = some candidate := by
  unfold polyDivideCandidate at *
  split at * <;> simp_all

/-- Exact output of the N1 monomial chart generator. -/
theorem chartN1Result_eq_some : chartN1Result = some candidateN1 := by
  have h := chartN1Result_success
  change (chartPolynomialGenerate .N1).isSome = true at h
  change chartPolynomialGenerate .N1 = some candidateN1
  simp only [chartPolynomialGenerate, chartCase, baseHResult_eq_some, bind, Option.bind] at h ⊢
  exact polyDivideCandidate_eq_some h

/-- Exact output of the N2 monomial chart generator. -/
