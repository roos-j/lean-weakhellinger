/-- Blueprint `lem:finite-certificate`: exact P1 generator output. -/
theorem chartP1Result_eq_some : chartP1Result = some candidateP1 := by
  have hf : polyDivideCandidate (polyHalfSubstitute candidatePositiveQuotient 0 0)
      (polyConst 1) candidateP1 = some candidateP1 :=
    (congrArg (fun q : IntPolynomial => polyDivideCandidate q (polyConst 1) candidateP1)
      (polyHalfSubstitute_zero candidatePositiveQuotient 0)).trans positiveHalfZero_P1_result
  change chartPolynomialGenerate .P1 = some candidateP1
  unfold chartPolynomialGenerate
  exact optionBind_eq_some (baseHResult_eq_some .plus)
    (optionBind_eq_some positiveQuotient_result hf)

