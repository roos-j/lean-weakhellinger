theorem chartP3Result_eq_some : chartP3Result = some candidateP3 := by
  have hn : (polyDegree candidatePositiveQuotient).2.2 = 4 := by decide +kernel
  have hc : polyClearSubstitute candidatePositiveQuotient (polyMul polyN0 polyTau) polyD0
      (polyDegree candidatePositiveQuotient).2.2 = candidatePositiveCleared :=
    (congrArg (fun n => polyClearSubstitute candidatePositiveQuotient
      (polyMul polyN0 polyTau) polyD0 n) hn).trans positiveClear_result
  have hf : polyDivideCandidate
      (polyClearSubstitute candidatePositiveQuotient (polyMul polyN0 polyTau) polyD0
        (polyDegree candidatePositiveQuotient).2.2) (polyPow polyK 2) candidateP3 = some candidateP3 :=
    (congrArg (fun q => polyDivideCandidate q (polyPow polyK 2) candidateP3) hc).trans
      positiveClearDivision_result
  change chartPolynomialGenerate .P3 = some candidateP3
  unfold chartPolynomialGenerate
  exact optionBind_eq_some (baseHResult_eq_some .plus)
    (optionBind_eq_some positiveQuotient_result hf)

