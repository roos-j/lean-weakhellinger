  change (chartPolynomialGenerate .N3).isSome = true at h
  change chartPolynomialGenerate .N3 = some candidateN3
  simp only [chartPolynomialGenerate, chartCase, baseHResult_eq_some, bind, Option.bind] at h ⊢
