/-- A coefficient with first exponent i ignores every term outside that row. -/
theorem polyCoefficient_filter_first (p : IntPolynomial) (i j k : ℕ) :
    polyCoefficient (p.filter (fun t => decide (t.1.1 = i))) (i, j, k) =
      polyCoefficient p (i, j, k) := by
  induction p with
  | nil => rfl
  | cons t p ih =>
    by_cases h : t.1.1 = i
    · simp [h, polyCoefficient, ih]
    · have he : t.1 ≠ (i, j, k) := fun he => h (congrArg Prod.fst he)
      simp [h, polyCoefficient, he, ih]

/-- Sparse row restriction preserves the original coefficient tabulation. -/
theorem coefficientRow_filter_first (p : IntPolynomial) (i n₂ n₃ : ℕ) :
    (Array.ofFn fun j : Fin (n₂ + 1) => Array.ofFn fun k : Fin (n₃ + 1) =>
      polyCoefficient p (i, j.val, k.val)) =
    (Array.ofFn fun j : Fin (n₂ + 1) => Array.ofFn fun k : Fin (n₃ + 1) =>
      polyCoefficient (p.filter (fun t => decide (t.1.1 = i))) (i, j.val, k.val)) := by
  apply congrArg Array.ofFn
  funext j
  apply congrArg Array.ofFn
  funext k
  exact (polyCoefficient_filter_first p i j.val k.val).symm

