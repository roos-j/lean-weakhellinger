/-- Every monomial must lie in the stated box. -/
def supportCheck (p : IntPolynomial) (n : Exponent) : Bool :=
  p.all fun t => decide (t.1 ≤ n)

/-- The complete closed box is tested, including missing (zero) coefficients. -/
def coefficientArray (n : Exponent) (f : Exponent → ℤ) : Array (Array (Array ℤ)) :=
  Array.ofFn fun i : Fin (n.1 + 1) =>
    Array.ofFn fun j : Fin (n.2.1 + 1) =>
      Array.ofFn fun k : Fin (n.2.2 + 1) => f (i.val, j.val, k.val)

def coefficientLookup (a : Array (Array (Array ℤ))) (β : Exponent) : ℤ :=
  (((a[β.1]?.getD #[])[β.2.1]?.getD #[])[β.2.2]?).getD 0

def cacheBox (n : Exponent) (f : Exponent → ℤ) : Exponent → ℤ :=
  coefficientLookup (coefficientArray n f)

theorem cacheBox_eq (n : Exponent) (f : Exponent → ℤ) (β : Exponent) (h : β ≤ n) :
    cacheBox n f β = f β := by
  rcases β with ⟨i, j, k⟩
  simp [cacheBox, coefficientArray, coefficientLookup, Array.getElem?_ofFn,
    Nat.lt_succ_iff, h.1, h.2.1, h.2.2]

/-- Updating an array tabulation is pointwise updating its tabulated function. -/
theorem array_modify_ofFn {α : Type*} {n : ℕ} (f : Fin n → α) (i : ℕ) (g : α → α) :
    (Array.ofFn f).modify i g = Array.ofFn (fun j => if i = j.val then g (f j) else f j) := by
  apply Array.ext
  · simp
  · intro j hj hj'
    simp [Array.getElem_modify]

/-- Add a sparse coefficient at its three array coordinates; an out-of-box
coordinate leaves the rectangular array unchanged. -/
def coefficientModify (a : Array (Array (Array ℤ))) (β : Exponent) (g : ℤ → ℤ) :=
  a.modify β.1 (fun row => row.modify β.2.1 (fun line => line.modify β.2.2 g))

theorem coefficientModify_ofFn (n : Exponent) (f : Exponent → ℤ) (β : Exponent) (g : ℤ → ℤ) :
    coefficientModify (coefficientArray n f) β g =
      coefficientArray n (fun α => if β = α then g (f α) else f α) := by
  unfold coefficientModify coefficientArray
  rw [array_modify_ofFn]
  congr 1
  funext i
  by_cases hi : β.1 = i.val
  · simp only [hi, ite_true]
    rw [array_modify_ofFn]
    congr 1
    funext j
    by_cases hj : β.2.1 = j.val
    · simp only [hj, ite_true]
      rw [array_modify_ofFn]
      congr 1
      funext k
      simp [Prod.ext_iff, hi, hj]
    · simp [Prod.ext_iff, hi, hj]
  · simp [Prod.ext_iff, hi]

/-- Initialize the dense coefficient box by visiting each sparse monomial once. -/
def coefficientSeed (p : IntPolynomial) (n : Exponent) : Array (Array (Array ℤ)) :=
  p.foldr (fun t a => coefficientModify a t.1 (fun v => t.2 + v))
    (coefficientArray n (fun _ => 0))

/-- Sparse initialization has exactly the source's polynomial coefficients,
including repeated input exponents and all zero-padded cells. -/
theorem coefficientSeed_eq (p : IntPolynomial) (n : Exponent) :
    coefficientSeed p n = coefficientArray n (polyCoefficient p) := by
  induction p with
  | nil => rfl
  | cons t p ih =>
      change coefficientModify (coefficientSeed p n) t.1 (fun v => t.2 + v) = _
      rw [ih, coefficientModify_ofFn]
      congr 1
      funext α
      simp [polyCoefficient]
      split <;> simp_all

#print axioms coefficientSeed_eq

/-- Two tabulations agree when their functions agree on the stored box. -/
theorem coefficientArray_congr (n : Exponent) (f g : Exponent → ℤ)
    (h : ∀ β, β ≤ n → f β = g β) : coefficientArray n f = coefficientArray n g := by
  unfold coefficientArray
  congr 1
  funext i
  congr 1
  funext j
  congr 1
  funext k
  exact h (i.val, j.val, k.val)
    ⟨Nat.le_of_lt_succ i.isLt, Nat.le_of_lt_succ j.isLt, Nat.le_of_lt_succ k.isLt⟩

/-- Assemble a coefficient array from separately checked first-coordinate rows. -/
theorem coefficientArray_eq_of_rows (n : Exponent) (f : Exponent → ℤ)
    (a : Array (Array (Array ℤ))) (hsize : a.size = n.1 + 1)
    (hrows : ∀ i : Fin (n.1 + 1),
      (Array.ofFn fun j : Fin (n.2.1 + 1) =>
        Array.ofFn fun k : Fin (n.2.2 + 1) => f (i.val, j.val, k.val)) =
          a[i.val]'(by simpa [hsize] using i.isLt)) : coefficientArray n f = a := by
  apply Array.ext
  · simp [coefficientArray, hsize]
  · intro i hi hi'
    have hin : i < n.1 + 1 := by simpa [coefficientArray] using hi
    simpa only [coefficientArray, Array.getElem_ofFn] using hrows ⟨i, hin⟩
