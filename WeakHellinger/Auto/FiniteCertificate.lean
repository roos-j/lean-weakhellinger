/-- The blueprint permits literal quotient candidates: their origin is not
trusted, and the exact rational reconstruction is checked before success. -/
def rationalConvertCandidate (p : RationalPolynomial) (candidate : IntPolynomial)
    (d a b : ℕ) : Option IntPolynomial :=
  if rationalConversionCheck p candidate d a b then some candidate else none

def baseFCandidate : CertificateCase → IntPolynomial
  | .minus => candidateFMinus
  | .plus => candidateFPlus
  | .boundary => candidateFBoundary

def baseHCandidate : CertificateCase → IntPolynomial
  | .minus => candidateHMinus
  | .plus => candidateHPlus
  | .boundary => candidateHBoundary

def baseFGenerate (c : CertificateCase) : Option IntPolynomial :=
  let d := baseDenominator c
  rationalConvertCandidate (ratF c) (baseFCandidate c) d.1 d.2.1 d.2.2

def baseHGenerate (c : CertificateCase) : Option IntPolynomial :=
  let d := baseDenominator c
  rationalConvertCandidate (ratGap c) (baseHCandidate c) (d.1 ^ 2) (2 * d.2.1) (2 * d.2.2)

def baseFMinusResult := baseFGenerate .minus
def baseFPlusResult := baseFGenerate .plus
def baseFBoundaryResult := baseFGenerate .boundary
def baseHMinusResult := baseHGenerate .minus
def baseHPlusResult := baseHGenerate .plus
def baseHBoundaryResult := baseHGenerate .boundary

def baseFResult : CertificateCase → Option IntPolynomial
  | .minus => baseFMinusResult
  | .plus => baseFPlusResult
  | .boundary => baseFBoundaryResult

def baseHResult : CertificateCase → Option IntPolynomial
  | .minus => baseHMinusResult
  | .plus => baseHPlusResult
  | .boundary => baseHBoundaryResult

theorem baseFResult_eq_generate (c : CertificateCase) : baseFResult c = baseFGenerate c := by
  cases c <;> rfl

theorem baseHResult_eq_generate (c : CertificateCase) : baseHResult c = baseHGenerate c := by
  cases c <;> rfl

/-- Named outputs use the required empty default; acceptance must also check
`baseFResult` and `baseHResult` are `some`. -/
def baseF (c : CertificateCase) : IntPolynomial := (baseFResult c).getD []
def baseH (c : CertificateCase) : IntPolynomial := (baseHResult c).getD []

/-- Base case assigned to each chart in the source table. -/
def chartCase : Chart → CertificateCase
  | .N1 | .N2 | .N3 => .minus
  | .P1 | .P2 | .P3 => .plus
  | .B1 => .boundary

