/-- Blueprint `spec:charts`: all operations use their current input degree,
and every division, including division by one, verifies reconstruction. -/
def polyDivideCandidate (p q candidate : IntPolynomial) : Option IntPolynomial :=
  if polyDivisionCheck p q candidate then some candidate else none

def chartPolynomialGenerate (c : Chart) : Option IntPolynomial := do
  let h ← baseHResult (chartCase c)
  match c with
  | .N1 =>
      polyDivideCandidate (polyMonomialSubstitute h (1, 1, 0) (0, 1, 0) (0, 0, 1))
        (polyPow polyK 2) candidateN1
  | .N2 =>
      polyDivideCandidate (polyMonomialSubstitute h (1, 0, 0) (1, 1, 1) (0, 0, 1))
        (polyMul (polyPow polyJ 2) (polyPow polyTau 2)) candidateN2
  | .N3 =>
      polyDivideCandidate (polyMonomialSubstitute h (1, 0, 0) (1, 1, 0) (0, 1, 1))
        (polyMul (polyPow polyJ 2) (polyPow polyK 2)) candidateN3
  | .P1 => do
      let p ← polyDivideCandidate h polyP0 candidatePositiveQuotient
      polyDivideCandidate (polyHalfSubstitute p 0 0) (polyConst 1) candidateP1
  | .P2 => do
      let p ← polyDivideCandidate h polyP0 candidatePositiveQuotient
      polyDivideCandidate (polyHalfSubstitute (polyHalfSubstitute p 0 1) 1 0) (polyConst 1) candidateP2
  | .P3 => do
      let p ← polyDivideCandidate h polyP0 candidatePositiveQuotient
      polyDivideCandidate (polyClearSubstitute p (polyMul polyN0 polyTau) polyD0 (polyDegree p).2.2)
        (polyPow polyK 2) candidateP3
  | .B1 => do
      let p ← polyDivideCandidate h polyP0 candidateBoundaryQuotient
      let cleared := polyClearSubstitute p (polyAdd polyN0 (polyMul polyPminus polyTau))
        polyD0 (polyDegree p).2.2
      let q ← polyDivideCandidate cleared (polyPow polyPminus 2) candidateBoundaryClearedQuotient
      polyDivideCandidate (polyHalfSubstitute (polyHalfSubstitute q 0 1) 1 1) (polyConst 1) candidateB1

def chartN1Result := chartPolynomialGenerate .N1
def chartN2Result := chartPolynomialGenerate .N2
def chartN3Result := chartPolynomialGenerate .N3
def chartP1Result := chartPolynomialGenerate .P1
def chartP2Result := chartPolynomialGenerate .P2
def chartP3Result := chartPolynomialGenerate .P3
def chartB1Result := chartPolynomialGenerate .B1

def chartPolynomialResult : Chart → Option IntPolynomial
  | .N1 => chartN1Result
  | .N2 => chartN2Result
  | .N3 => chartN3Result
  | .P1 => chartP1Result
  | .P2 => chartP2Result
  | .P3 => chartP3Result
  | .B1 => chartB1Result

def chartPolynomial (c : Chart) : IntPolynomial := (chartPolynomialResult c).getD []

