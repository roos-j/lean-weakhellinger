/-- Blueprint `lem:finite-certificate`: exact B1 generator output. -/
theorem chartB1Result_eq_some : chartB1Result = some candidateB1 := by
  have hn : (polyDegree candidateBoundaryQuotient).2.2 = 4 := by decide +kernel
  have hc : polyClearSubstitute candidateBoundaryQuotient
      (polyAdd polyN0 (polyMul polyPminus polyTau)) polyD0
      (polyDegree candidateBoundaryQuotient).2.2 = candidateBoundaryCleared :=
    (congrArg (fun n => polyClearSubstitute candidateBoundaryQuotient
      (polyAdd polyN0 (polyMul polyPminus polyTau)) polyD0 n) hn).trans boundaryClear_result
  have hd : polyDivideCandidate
      (polyClearSubstitute candidateBoundaryQuotient
        (polyAdd polyN0 (polyMul polyPminus polyTau)) polyD0
        (polyDegree candidateBoundaryQuotient).2.2)
      (polyPow polyPminus 2) candidateBoundaryClearedQuotient =
        some candidateBoundaryClearedQuotient :=
    (congrArg (fun q => polyDivideCandidate q (polyPow polyPminus 2)
      candidateBoundaryClearedQuotient) hc).trans boundaryClearDivision_result
  have hf : polyDivideCandidate
      (polyHalfSubstitute (polyHalfSubstitute candidateBoundaryClearedQuotient 0 1) 1 1)
      (polyConst 1) candidateB1 = some candidateB1 :=
    (congrArg (fun q => polyDivideCandidate (polyHalfSubstitute q 1 1)
      (polyConst 1) candidateB1) boundaryHalfJ_result).trans boundaryHalfK_result
  change chartPolynomialGenerate .B1 = some candidateB1
  unfold chartPolynomialGenerate
  exact optionBind_eq_some (baseHResult_eq_some .boundary)
    (optionBind_eq_some boundaryQuotient_result (optionBind_eq_some hd hf))

theorem chartB1Result_success : chartB1Result.isSome = true := by
