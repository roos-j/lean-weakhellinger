  rw [Finset.sum_comm]
  simp only [Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  rw [← Finset.mul_sum, (κ a).total, mul_one]

/-- Strictness of the entropy tangent bound away from equal atom masses. -/
theorem finiteKL_atom_strict {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y)
    (hsupport : y = 0 → x = 0) (hne : x ≠ y) : x-y < x * Real.log (x/y) := by
  by_cases hx0 : x = 0
  · subst x
    simp only [zero_div, zero_mul, zero_sub]
    have : 0 < y := lt_of_le_of_ne hy hne
    linarith
  have hxp : 0 < x := lt_of_le_of_ne hx (Ne.symm hx0)
  have hyp : 0 < y := lt_of_le_of_ne hy (Ne.symm (fun h => hx0 (hsupport h)))
  have hne' : y/x ≠ 1 := by intro h; apply hne; exact ((div_eq_one_iff_eq hxp.ne').mp h).symm
  have h := mul_lt_mul_of_pos_left
    (Real.log_lt_sub_one_of_pos (div_pos hyp hxp) hne') hxp
  rw [Real.log_div hyp.ne' hxp.ne'] at h
  have he : x * (y/x-1) = y-x := by field_simp
  rw [he] at h
  rw [Real.log_div hxp.ne' hyp.ne']
  nlinarith

/-- Strict positivity of finite KL for distinct supported probability laws. -/
theorem finiteKLReal_pos {α : Type*} [Fintype α] (ν μ : FiniteLaw α)
    (hsupport : ∀ a, μ.mass a = 0 → ν.mass a = 0) (hne : ν ≠ μ) :
    0 < finiteKLReal ν μ := by
  classical
  have hex : ∃ a, ν.mass a ≠ μ.mass a := by
    by_contra! h
    apply hne
    ext a
    exact h a
  obtain ⟨a, ha⟩ := hex
  have h := Finset.sum_lt_sum (s := Finset.univ)
    (fun a _ => finiteKL_atom_lower (ν.nonneg a) (μ.nonneg a) (hsupport a))
    ⟨a, Finset.mem_univ a, finiteKL_atom_strict (ν.nonneg a) (μ.nonneg a) (hsupport a) ha⟩
  simpa [Finset.sum_sub_distrib, ν.total, μ.total, finiteKLReal] using h

/-- A nonnegative vector with zero total has every coordinate zero. -/
theorem finite_nonneg_eq_zero_of_sum_eq_zero {α : Type*} [Fintype α]
    (v : α → ℝ) (hv : ∀ a, 0 ≤ v a) (hs : ∑ a, v a = 0) (a : α) : v a = 0 := by
  have h := Finset.single_le_sum (fun b _ => hv b) (Finset.mem_univ a)
  rw [hs] at h
  exact le_antisymm h (hv a)

/-- Entropy tangent bound at an arbitrary positive ratio. -/
theorem finiteKL_atom_tangent {x y t : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y)
    (hsupport : y = 0 → x = 0) (ht : 0 < t) :
    x * Real.log t + x - y*t ≤ x * Real.log (x/y) := by
  by_cases hx0 : x = 0
  · subst x
    simp only [zero_mul, zero_add, zero_sub]
    exact neg_nonpos.mpr (mul_nonneg hy ht.le)
  have hxp : 0 < x := lt_of_le_of_ne hx (Ne.symm hx0)
  have hyp : 0 < y := lt_of_le_of_ne hy (Ne.symm (fun h => hx0 (hsupport h)))
  have h := finiteKL_atom_lower hx (mul_nonneg hy ht.le)
    (fun he => (mul_ne_zero hyp.ne' ht.ne' he).elim)
  rw [Real.log_div hxp.ne' (mul_ne_zero hyp.ne' ht.ne'), Real.log_mul hyp.ne' ht.ne'] at h
  rw [Real.log_div hxp.ne' hyp.ne']
  nlinarith

/-- Log-sum inequality for nonnegative finite vectors, including zero total mass. -/
theorem finite_log_sum {α : Type*} [Fintype α] (v w : α → ℝ)
    (hv : ∀ a, 0 ≤ v a) (hw : ∀ a, 0 ≤ w a)
    (hsupport : ∀ a, w a = 0 → v a = 0) :
    (∑ a, v a) * Real.log ((∑ a, v a)/(∑ a, w a)) ≤
      ∑ a, v a * Real.log (v a / w a) := by
  have hvsum : 0 ≤ ∑ a, v a := Finset.sum_nonneg (fun a _ => hv a)
  have hwsum : 0 ≤ ∑ a, w a := Finset.sum_nonneg (fun a _ => hw a)
  by_cases hv0 : ∑ a, v a = 0
  · have hz := finite_nonneg_eq_zero_of_sum_eq_zero v hv hv0
    simp [hz]
  have hvp : 0 < ∑ a, v a := lt_of_le_of_ne hvsum (Ne.symm hv0)
  have hw0 : (∑ a, w a) ≠ 0 := by
    intro he
    apply hv0
    have hz := finite_nonneg_eq_zero_of_sum_eq_zero w hw he
    exact Finset.sum_eq_zero (fun a _ => hsupport a (hz a))
  have hwp : 0 < ∑ a, w a := lt_of_le_of_ne hwsum (Ne.symm hw0)
  have ht := div_pos hvp hwp
  have h := Finset.sum_le_sum (s := Finset.univ)
    (fun a _ => finiteKL_atom_tangent (hv a) (hw a) (hsupport a) ht)
  simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.sum_mul] at h
  have he : (∑ a, w a) * ((∑ a, v a)/(∑ a, w a)) = ∑ a, v a := by field_simp
  rw [he] at h
  linarith

/-- A pushforward preserves absolute continuity on finite alphabets. -/
theorem finiteMap_supported {α β : Type*} [Fintype α] [Fintype β]
    (ν μ : FiniteLaw α) (f : α → β)
    (hsupport : ∀ a, μ.mass a = 0 → ν.mass a = 0) :
    ∀ b, (finiteMap μ f).mass b = 0 → (finiteMap ν f).mass b = 0 := by
  classical
  intro b hb
  have hz := finite_nonneg_eq_zero_of_sum_eq_zero
    (fun a => if f a = b then μ.mass a else 0)
    (fun a => by split_ifs; exact μ.nonneg a; rfl) hb
  apply Finset.sum_eq_zero
  intro a _
  split_ifs with he
  · exact hsupport a (by simpa [he] using hz a)
  · rfl

/-- Data processing for finite KL, proved by summing the log-sum inequality over fibers. -/
theorem finiteKLReal_map_le {α β : Type*} [Fintype α] [Fintype β]
    (ν μ : FiniteLaw α) (f : α → β)
    (hsupport : ∀ a, μ.mass a = 0 → ν.mass a = 0) :
    finiteKLReal (finiteMap ν f) (finiteMap μ f) ≤ finiteKLReal ν μ := by
  classical
  have hb (b : β) := finite_log_sum
    (fun a => if f a = b then ν.mass a else 0)
    (fun a => if f a = b then μ.mass a else 0)
    (fun a => by split_ifs; exact ν.nonneg a; rfl)
    (fun a => by split_ifs; exact μ.nonneg a; rfl)
    (fun a he => by split_ifs at * with h; exact hsupport a he; rfl)
  have h := Finset.sum_le_sum (s := Finset.univ) (fun b _ => hb b)
  change finiteKLReal (finiteMap ν f) (finiteMap μ f) ≤ _ at h
  refine h.trans_eq ?_
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  simp

/-- Extended-valued data processing for finite KL, including unsupported target laws. -/
theorem finiteKL_map_le {α β : Type*} [Fintype α] [Fintype β]
    (ν μ : FiniteLaw α) (f : α → β) : finiteKL (finiteMap ν f) (finiteMap μ f) ≤ finiteKL ν μ := by
  classical
  by_cases hs : ∀ a, μ.mass a = 0 → ν.mass a = 0
  · rw [finiteKL_of_supported ν μ hs,
      finiteKL_of_supported _ _ (finiteMap_supported ν μ f hs)]
    exact ENNReal.ofReal_le_ofReal (finiteKLReal_map_le ν μ f hs)
  · simp only [finiteKL, ite_eq_right hs]
    exact le_top

/-- The atomwise logarithm identity underlying the KL chain rule. -/
theorem finiteKL_atom_product (x y : ℝ) {u v : ℝ} (hu : u ≠ 0) (hv : v ≠ 0) :
    (x*y) * Real.log ((x*y)/(u*v)) =
      y * (x * Real.log (x/u)) + x * (y * Real.log (y/v)) := by
  by_cases hx : x = 0
  · simp [hx]
  by_cases hy : y = 0
  · simp [hy]
  rw [Real.log_div (mul_ne_zero hx hy) (mul_ne_zero hu hv),
    Real.log_mul hx hy, Real.log_mul hu hv, Real.log_div hx hu, Real.log_div hy hv]
  ring

/-- KL chain rule for two joint laws specified by marginal and conditional kernels. -/
theorem finiteKLReal_joint {α β : Type*} [Fintype α] [Fintype β]
    (ν μ : FiniteLaw α) (τ κ : α → FiniteLaw β)
    (hμ : ∀ a, 0 < μ.mass a) (hκ : ∀ a b, 0 < (κ a).mass b) :
    finiteKLReal (finiteJoint ν τ) (finiteJoint μ κ) = finiteKLReal ν μ +
      ∑ a, ν.mass a * finiteKLReal (τ a) (κ a) := by
  simp only [finiteKLReal, finiteJoint, Fintype.sum_prod_type]
  simp_rw [finiteKL_atom_product _ _ (hμ _).ne' (hκ _ _).ne']
  simp_rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.mul_sum, (τ _).total, one_mul]

/-- The first marginal mass is a row sum of the joint probability table. -/
theorem finiteFirst_mass {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (a : α) : (finiteFirst μ).mass a = ∑ b, μ.mass (a,b) := by
  classical
  simp only [finiteFirst, finiteMap, Fintype.sum_prod_type]
  rw [Finset.sum_comm]
  simp

/-- The second marginal mass is a column sum of the joint probability table. -/
theorem finiteSecond_mass {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (b : β) : (finiteSecond μ).mass b = ∑ a, μ.mass (a,b) := by
  classical
  simp [finiteSecond, finiteMap, Fintype.sum_prod_type]

/-- Conditional probability table of V given U. On a null row, choose the V marginal;
the choice is immaterial because that row has zero probability. -/
def finiteConditionalLaw {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (a : α) : FiniteLaw β := by
  classical
  exact if h : (finiteFirst μ).mass a = 0 then finiteSecond μ else {
    mass := fun b => μ.mass (a,b) / (finiteFirst μ).mass a
    nonneg := fun b => div_nonneg (μ.nonneg _) ((finiteFirst μ).nonneg a)
    total := by rw [← Finset.sum_div, ← finiteFirst_mass, div_self h] }

/-- Disintegration of a finite joint law into its first marginal and conditional law. -/
theorem finiteJoint_conditional {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) : finiteJoint (finiteFirst μ) (finiteConditionalLaw μ) = μ := by
  classical
  ext z
  obtain ⟨a,b⟩ := z
  by_cases h : (finiteFirst μ).mass a = 0
  · have hz : μ.mass (a,b) = 0 := finite_nonneg_eq_zero_of_sum_eq_zero
      (fun b => μ.mass (a,b)) (fun b => μ.nonneg _) (by rwa [← finiteFirst_mass]) b
    simp [finiteJoint, h, hz]
  · simp [finiteJoint, finiteConditionalLaw, h, mul_div_cancel₀]

/-- A finite probability law has a nonempty alphabet. -/
theorem finiteLaw_nonempty {α : Type*} [Fintype α] (μ : FiniteLaw α) : Nonempty α := by
  classical
  by_contra h
  have : IsEmpty α := not_nonempty_iff.mp h
  have := μ.total
  simp at this

/-- A positive joint reference table has a positive first marginal. -/
theorem finiteFirst_pos {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z) (a : α) :
    0 < (finiteFirst μ).mass a := by
  obtain ⟨z⟩ := finiteLaw_nonempty μ
  rw [finiteFirst_mass]
  exact lt_of_lt_of_le (hμ (a,z.2))
    (Finset.single_le_sum (fun b _ => μ.nonneg _) (Finset.mem_univ _))

/-- Conditioning a positive joint reference table gives positive conditional masses. -/
theorem finiteConditionalLaw_pos {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z) (a : α) (b : β) :
    0 < (finiteConditionalLaw μ a).mass b := by
  have h := finiteFirst_pos μ hμ a
  simp only [finiteConditionalLaw, dite_eq_right h.ne']
  exact div_pos (hμ _) h

/-- KL chain rule with actual conditional probabilities and a positive reference law. -/
theorem finiteKLReal_chain {α β : Type*} [Fintype α] [Fintype β]
    (ν μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z) :
    finiteKLReal ν μ = finiteKLReal (finiteFirst ν) (finiteFirst μ) +
      ∑ a, (finiteFirst ν).mass a *
        finiteKLReal (finiteConditionalLaw ν a) (finiteConditionalLaw μ a) := by
  have h := finiteKLReal_joint (finiteFirst ν) (finiteFirst μ)
    (finiteConditionalLaw ν) (finiteConditionalLaw μ)
    (finiteFirst_pos μ hμ) (finiteConditionalLaw_pos μ hμ)
  rwa [finiteJoint_conditional, finiteJoint_conditional] at h

/-- With fixed U marginal, joint KL is exactly the expected conditional KL cost
appearing in the source's definition of the reverse coefficient. -/
theorem finiteKLReal_fixed_first {α β : Type*} [Fintype α] [Fintype β]
    (ν μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z)
    (hfirst : finiteFirst ν = finiteFirst μ) :
    finiteKLReal ν μ = ∑ a, (finiteFirst μ).mass a *
      finiteKLReal (finiteConditionalLaw ν a) (finiteConditionalLaw μ a) := by
  rw [finiteKLReal_chain ν μ hμ, hfirst, finiteKLReal_self, zero_add]

/-- Probability tables with the prescribed row and column sums. -/
def finiteTransportPolytope {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) : Set (α × β → ℝ) :=
  {w | (∀ z, 0 ≤ w z) ∧ (∀ a, ∑ b, w (a,b) = (finiteFirst μ).mass a) ∧
    ∀ b, ∑ a, w (a,b) = ν.mass b}

/-- The independent coupling is feasible for every prescribed second marginal. -/
theorem finiteTransportPolytope_nonempty {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) :
    (finiteTransportPolytope μ ν).Nonempty := by
  refine ⟨fun z => (finiteFirst μ).mass z.1 * ν.mass z.2, ?_⟩
  refine ⟨fun z => mul_nonneg ((finiteFirst μ).nonneg _) (ν.nonneg _), ?_, ?_⟩
  · intro a
    dsimp
    rw [← Finset.mul_sum, ν.total, mul_one]
  · intro b
    dsimp
    rw [← Finset.sum_mul, (finiteFirst μ).total, one_mul]

/-- The marginal constraints and coordinate nonnegativity are closed conditions. -/
theorem finiteTransportPolytope_isClosed {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) : IsClosed (finiteTransportPolytope μ ν) := by
  have h₀ : IsClosed {w : α × β → ℝ | ∀ z, 0 ≤ w z} :=
    by simpa only [Set.ofPred_forall] using
      isClosed_iInter (fun z => isClosed_le continuous_const (continuous_apply z))
  have h₁ : IsClosed {w : α × β → ℝ | ∀ a, ∑ b, w (a,b) = (finiteFirst μ).mass a} :=
    by simpa only [Set.ofPred_forall] using isClosed_iInter (fun a => isClosed_eq
      (continuous_finsetSum _ (fun b _ => continuous_apply (a,b))) continuous_const)
  have h₂ : IsClosed {w : α × β → ℝ | ∀ b, ∑ a, w (a,b) = ν.mass b} :=
    by simpa only [Set.ofPred_forall] using isClosed_iInter (fun b => isClosed_eq
      (continuous_finsetSum _ (fun a _ => continuous_apply (a,b))) continuous_const)
  exact h₀.inter (h₁.inter h₂)

/-- Every feasible table lies in the finite-dimensional unit cube. -/
theorem finiteTransportPolytope_subset_cube {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) :
    finiteTransportPolytope μ ν ⊆ Set.Icc (0 : α × β → ℝ) 1 := by
  intro w hw
  refine ⟨hw.1, ?_⟩
  intro z
  have h := Finset.single_le_sum (fun b _ => hw.1 (z.1,b)) (Finset.mem_univ z.2)
  rw [hw.2.1 z.1] at h
  exact h.trans (finiteLaw_mass_le_one (finiteFirst μ) z.1)

/-- The entropy transportation polytope is compact. -/
theorem finiteTransportPolytope_isCompact {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) : IsCompact (finiteTransportPolytope μ ν) :=
  isCompact_Icc.of_isClosed_subset (finiteTransportPolytope_isClosed μ ν)
    (finiteTransportPolytope_subset_cube μ ν)

/-- A feasible table defines a probability law. -/
def finiteLawOfTransportTable {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) (w : α × β → ℝ)
    (hw : w ∈ finiteTransportPolytope μ ν) : FiniteLaw (α × β) where
  mass := w
  nonneg := hw.1
  total := by rw [Fintype.sum_prod_type]; simp_rw [hw.2.1]; exact (finiteFirst μ).total

/-- The probability law of a feasible table has the required marginals. -/
theorem finiteLawOfTransportTable_feasible {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) (w : α × β → ℝ)
    (hw : w ∈ finiteTransportPolytope μ ν) :
    finiteTransportFeasible μ (finiteLawOfTransportTable μ ν w hw) ν := by
  constructor
  · ext a
    rw [finiteFirst_mass]
    exact hw.2.1 a
  · ext b
    rw [finiteSecond_mass]
    exact hw.2.2 b

/-- Every feasible probability law gives a point of the transportation polytope. -/
theorem finiteTransportFeasible_mem {α β : Type*} [Fintype α] [Fintype β]
    (μ κ : FiniteLaw (α × β)) (ν : FiniteLaw β)
    (hκ : finiteTransportFeasible μ κ ν) : κ.mass ∈ finiteTransportPolytope μ ν := by
  refine ⟨κ.nonneg, ?_, ?_⟩
  · intro a
    rw [← finiteFirst_mass, hκ.1]
  · intro b
    rw [← finiteSecond_mass, hκ.2]

/-- For a positive reference table, the entropy transportation infimum is attained. -/
theorem finiteTransport_minimizer {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) (hμ : ∀ z, 0 < μ.mass z) :
    ∃ κ, finiteTransportFeasible μ κ ν ∧
      ∀ τ, finiteTransportFeasible μ τ ν → finiteKLReal κ μ ≤ finiteKLReal τ μ := by
  obtain ⟨w, hw, hmin⟩ := (finiteTransportPolytope_isCompact μ ν).exists_isMinOn
    (finiteTransportPolytope_nonempty μ ν) (continuous_finiteKL_sum μ.mass hμ).continuousOn
  refine ⟨finiteLawOfTransportTable μ ν w hw,
    finiteLawOfTransportTable_feasible μ ν w hw, ?_⟩
  intro τ hτ
  exact hmin (finiteTransportFeasible_mem μ τ ν hτ)

/-- The attained real minimum is also the extended-real entropy transportation cost. -/
theorem finiteTransportCost_attained {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) (hμ : ∀ z, 0 < μ.mass z) :
    ∃ κ, finiteTransportFeasible μ κ ν ∧ finiteTransportCost μ ν = finiteKL κ μ := by
  obtain ⟨κ, hκ, hmin⟩ := finiteTransport_minimizer μ ν hμ
  refine ⟨κ, hκ, le_antisymm (sInf_le ⟨κ, hκ, rfl⟩) ?_⟩
  apply le_sInf
  rintro v ⟨τ, hτ, rfl⟩
  rw [finiteKL_of_supported κ μ (fun z hz => ((hμ z).ne' hz).elim),
    finiteKL_of_supported τ μ (fun z hz => ((hμ z).ne' hz).elim)]
  exact ENNReal.ofReal_le_ofReal (hmin τ hτ)

/-- Positive reference tables have finite entropy transportation cost. -/
theorem finiteTransportCost_ne_top {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) (hμ : ∀ z, 0 < μ.mass z) :
    finiteTransportCost μ ν ≠ ⊤ := by
  obtain ⟨κ, _, he⟩ := finiteTransportCost_attained μ ν hμ
  rw [he, finiteKL_of_supported κ μ (fun z hz => ((hμ z).ne' hz).elim)]
  exact ENNReal.ofReal_ne_top

/-- Every joint entropy cost is at least the entropy cost of its prescribed V marginal. -/
theorem finiteKL_le_transportCost {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) :
    finiteKL ν (finiteSecond μ) ≤ finiteTransportCost μ ν := by
  apply le_sInf
  rintro v ⟨κ, hκ, rfl⟩
  have h := finiteKL_map_le κ μ Prod.snd
  change finiteKL (finiteSecond κ) (finiteSecond μ) ≤ finiteKL κ μ at h
  rwa [hκ.2] at h

/-- Conditional KL cost for a changed kernel with the reference first marginal. -/
theorem finiteKLReal_changed_kernel {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (τ : α → FiniteLaw β) (hμ : ∀ z, 0 < μ.mass z) :
    finiteKLReal (finiteJoint (finiteFirst μ) τ) μ =
      ∑ a, (finiteFirst μ).mass a * finiteKLReal (τ a) (finiteConditionalLaw μ a) := by
  have h := finiteKLReal_joint (finiteFirst μ) (finiteFirst μ) τ (finiteConditionalLaw μ)
    (finiteFirst_pos μ hμ) (finiteConditionalLaw_pos μ hμ)
  rwa [finiteJoint_conditional, finiteKLReal_self, zero_add] at h

/-- The entropy transportation cost is exactly the infimum in the source's
conditional-law program, for positive reference tables. -/
theorem finiteTransportCost_eq_conditional_inf {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) (hμ : ∀ z, 0 < μ.mass z) :
    finiteTransportCost μ ν = sInf {v : ℝ≥0∞ | ∃ τ : α → FiniteLaw β,
      finiteSecond (finiteJoint (finiteFirst μ) τ) = ν ∧
      v = ENNReal.ofReal (∑ a, (finiteFirst μ).mass a *
        finiteKLReal (τ a) (finiteConditionalLaw μ a))} := by
  unfold finiteTransportCost
  congr 1
  ext v
  constructor
  · rintro ⟨κ, hκ, rfl⟩
    have hj : finiteJoint (finiteFirst μ) (finiteConditionalLaw κ) = κ := by
      rw [← hκ.1, finiteJoint_conditional]
    refine ⟨finiteConditionalLaw κ, by rw [hj]; exact hκ.2, ?_⟩
    rw [finiteKL_of_supported κ μ (fun z hz => ((hμ z).ne' hz).elim),
      finiteKLReal_fixed_first κ μ hμ hκ.1]
  · rintro ⟨τ, hτ, rfl⟩
    refine ⟨finiteJoint (finiteFirst μ) τ, ⟨finiteFirst_joint _ _, hτ⟩, ?_⟩
    rw [finiteKL_of_supported _ μ (fun z hz => ((hμ z).ne' hz).elim),
      finiteKLReal_changed_kernel μ τ hμ]

/-- The reference law itself has zero transportation cost. -/
theorem finiteTransportCost_self {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) : finiteTransportCost μ (finiteSecond μ) = 0 := by
  apply le_antisymm _ bot_le
  have h : finiteTransportCost μ (finiteSecond μ) ≤ finiteKL μ μ := sInf_le ⟨μ, ⟨rfl, rfl⟩, rfl⟩
  exact h.trans_eq (finiteKL_self μ)

/-- Every feasible joint law bounds the transportation cost from above. -/
theorem finiteTransportCost_le {α β : Type*} [Fintype α] [Fintype β]
    (μ κ : FiniteLaw (α × β)) (ν : FiniteLaw β)
    (hκ : finiteTransportFeasible μ κ ν) : finiteTransportCost μ ν ≤ finiteKL κ μ :=
  sInf_le ⟨κ, hκ, rfl⟩

/-- The defining infimum is at most any admissible entropy ratio. -/
theorem reverseComplement_le_ratio {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) (hν : reverseAdmissible μ ν) :
    reverseComplement μ ≤ finiteKL ν (finiteSecond μ) / finiteTransportCost μ ν := by
  classical
  unfold reverseComplement
  rw [ite_eq_left ⟨ν, hν⟩]
  exact sInf_le ⟨ν, hν, rfl⟩

/-- The reverse complement belongs to [0,1], including degenerate alphabets. -/
theorem reverseComplement_le_one {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) : reverseComplement μ ≤ 1 := by
  classical
  by_cases h : ∃ ν, reverseAdmissible μ ν
  · obtain ⟨ν, hν⟩ := h
    apply (reverseComplement_le_ratio μ ν hν).trans
    exact ENNReal.div_le_of_le_mul (by simpa using finiteKL_le_transportCost μ ν)
  · simp [reverseComplement, h]

/-- The reverse coefficient really is a number in [0,1]. -/
theorem sDagger_mem_Icc {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) : sDagger μ ∈ Set.Icc (0 : ℝ) 1 := by
  have h := ENNReal.toReal_mono (by simp : (1 : ℝ≥0∞) ≠ ⊤) (reverseComplement_le_one μ)
  have h0 := ENNReal.toReal_nonneg (a := reverseComplement μ)
  simp only [ENNReal.toReal_one] at h
  unfold sDagger
  constructor <;> linarith

/-- A positive joint law has a positive second marginal. -/
theorem finiteSecond_pos {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z) (b : β) :
    0 < (finiteSecond μ).mass b := by
  obtain ⟨z⟩ := finiteLaw_nonempty μ
  rw [finiteSecond_mass]
  exact lt_of_lt_of_le (hμ (z.1,b))
    (Finset.single_le_sum (fun a _ => μ.nonneg (a,b)) (Finset.mem_univ z.1))

/-- Positive references make every distinct second-marginal law admissible. -/
theorem reverseAdmissible_of_ne {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) (hμ : ∀ z, 0 < μ.mass z)
    (hne : ν ≠ finiteSecond μ) : reverseAdmissible μ ν :=
  ⟨hne, fun b hb => ((finiteSecond_pos μ hμ b).ne' hb).elim⟩

/-- A distinct changed marginal has strictly positive transportation cost. -/
theorem finiteTransportCost_pos {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (ν : FiniteLaw β) (hν : reverseAdmissible μ ν) :
    0 < finiteTransportCost μ ν := by
  have hp := finiteKLReal_pos ν (finiteSecond μ) hν.2 hν.1
  have he := finiteKL_of_supported ν (finiteSecond μ) hν.2
  apply lt_of_lt_of_le _ (finiteKL_le_transportCost μ ν)
  rw [he]
  exact ENNReal.ofReal_pos.mpr hp

/-- Entropy lifting: every changed V law can be coupled to the original U marginal
at joint entropy cost at most `1/a` times its marginal entropy cost. The
multiplicative form also makes sense for `a=0`. -/
def EntropyLifting {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (a : ℝ) : Prop :=
  ∀ ν : FiniteLaw β, ∃ κ : FiniteLaw (α × β), finiteTransportFeasible μ κ ν ∧
    a * finiteKLReal κ μ ≤ finiteKLReal ν (finiteSecond μ)

/-- Entropy lifting bounds the reverse complement from below. -/
theorem reverseComplement_ge_of_lifting {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z) {a : ℝ}
    (ha : a ∈ Set.Icc (0 : ℝ) 1) (hlift : EntropyLifting μ a) :
    ENNReal.ofReal a ≤ reverseComplement μ := by
  classical
  unfold reverseComplement
  split_ifs with hex
  · apply le_sInf
    rintro v ⟨ν, hν, rfl⟩
    obtain ⟨κ, hκ, hcost⟩ := hlift ν
    apply (ENNReal.le_div_iff_mul_le (Or.inl (finiteTransportCost_pos μ ν hν).ne')
      (Or.inl (finiteTransportCost_ne_top μ ν hμ))).mpr
    apply (mul_le_mul' (le_refl (ENNReal.ofReal a)) (finiteTransportCost_le μ κ ν hκ)).trans
    rw [finiteKL_of_supported κ μ (fun z hz => ((hμ z).ne' hz).elim),
      finiteKL_of_supported ν (finiteSecond μ) hν.2, ← ENNReal.ofReal_mul ha.1]
    exact ENNReal.ofReal_le_ofReal hcost
  · exact ENNReal.ofReal_le_one.mpr ha.2

/-- The reverse complement bound yields an entropy lift via the attained minimum. -/
theorem entropyLifting_of_reverseComplement {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z) {a : ℝ}
    (ha : 0 ≤ a) (hbound : ENNReal.ofReal a ≤ reverseComplement μ) : EntropyLifting μ a := by
  intro ν
  by_cases he : ν = finiteSecond μ
  · subst ν
    exact ⟨μ, ⟨rfl, rfl⟩, by rw [finiteKLReal_self, finiteKLReal_self]; simp⟩
  have hν := reverseAdmissible_of_ne μ ν hμ he
  obtain ⟨κ, hκ, hcost⟩ := finiteTransportCost_attained μ ν hμ
  refine ⟨κ, hκ, ?_⟩
  have h := hbound.trans (reverseComplement_le_ratio μ ν hν)
  rw [ENNReal.le_div_iff_mul_le (Or.inl (finiteTransportCost_pos μ ν hν).ne')
    (Or.inl (finiteTransportCost_ne_top μ ν hμ))] at h
  rw [hcost, finiteKL_of_supported κ μ (fun z hz => ((hμ z).ne' hz).elim),
    finiteKL_of_supported ν (finiteSecond μ) hν.2, ← ENNReal.ofReal_mul ha] at h
  exact (ENNReal.ofReal_le_ofReal_iff (finiteKLReal_nonneg ν (finiteSecond μ) hν.2)).mp h

/-- Exact entropy-lifting characterization of the reverse coefficient for positive tables. -/
theorem entropyLifting_iff {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z) {a : ℝ}
    (ha : a ∈ Set.Icc (0 : ℝ) 1) :
    EntropyLifting μ a ↔ ENNReal.ofReal a ≤ reverseComplement μ :=
  ⟨reverseComplement_ge_of_lifting μ hμ ha, entropyLifting_of_reverseComplement μ hμ ha.1⟩

/-- Composition of finite pushforwards. -/
theorem finiteMap_comp {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (μ : FiniteLaw α) (f : α → β) (g : β → γ) :
    finiteMap (finiteMap μ f) g = finiteMap μ (g ∘ f) := by
  classical
  ext c
  simp only [finiteMap]
  simp_rw [Finset.ite_sum_zero]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  calc
    _ = ∑ b, if f a = b then (if g b = c then μ.mass a else 0) else 0 := by
      apply Finset.sum_congr rfl
      intro b _
      split_ifs <;> rfl
    _ = _ := by simp

/-- The first marginal commutes with separate maps of the two coordinates. -/
theorem finiteFirst_map_pair {α β γ δ : Type*} [Fintype α] [Fintype β]
    [Fintype γ] [Fintype δ] (μ : FiniteLaw (α × β)) (f : α → γ) (g : β → δ) :
    finiteFirst (finiteMap μ (fun z => (f z.1, g z.2))) = finiteMap (finiteFirst μ) f := by
  unfold finiteFirst
  rw [finiteMap_comp, finiteMap_comp]
  rfl

/-- The second marginal commutes with separate maps of the two coordinates. -/
theorem finiteSecond_map_pair {α β γ δ : Type*} [Fintype α] [Fintype β]
    [Fintype γ] [Fintype δ] (μ : FiniteLaw (α × β)) (f : α → γ) (g : β → δ) :
    finiteSecond (finiteMap μ (fun z => (f z.1, g z.2))) = finiteMap (finiteSecond μ) g := by
  unfold finiteSecond
  rw [finiteMap_comp, finiteMap_comp]
  rfl

/-- Lift a changed output law using the reference law's conditional distribution
on each fiber of a deterministic observation. -/
def finiteLiftOutput {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (f : α → β) (ν : FiniteLaw β)
    (hpos : ∀ b, 0 < (finiteMap μ f).mass b) : FiniteLaw α where
  mass a := μ.mass a * (ν.mass (f a) / (finiteMap μ f).mass (f a))
  nonneg a := mul_nonneg (μ.nonneg a) (div_nonneg (ν.nonneg _) (hpos _).le)
  total := by
    have h := finiteExpectation_map μ f (fun b => ν.mass b / (finiteMap μ f).mass b)
    dsimp [finiteExpectation, Function.comp_def] at h
    rw [← h]
    have he (b : β) : (finiteMap μ f).mass b * (ν.mass b / (finiteMap μ f).mass b) = ν.mass b := by
      field_simp [(hpos b).ne']
    simp_rw [he]
    exact ν.total

/-- The lifted law has exactly the prescribed output marginal. -/
theorem finiteLiftOutput_map {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (f : α → β) (ν : FiniteLaw β)
    (hpos : ∀ b, 0 < (finiteMap μ f).mass b) :
    finiteMap (finiteLiftOutput μ f ν hpos) f = ν := by
  classical
  ext b
  change (∑ a, if f a = b then μ.mass a *
    (ν.mass (f a) / (finiteMap μ f).mass (f a)) else 0) = ν.mass b
  calc
    _ = ∑ a, (if f a = b then μ.mass a else 0) *
        (ν.mass b / (finiteMap μ f).mass b) := by
      apply Finset.sum_congr rfl
      intro a _
      split_ifs with he <;> simp [he]
    _ = (finiteMap μ f).mass b * (ν.mass b / (finiteMap μ f).mass b) := by
      rw [← Finset.sum_mul]
      rfl
    _ = ν.mass b := by field_simp [(hpos b).ne']

/-- The reference-conditional lift has exactly the KL cost of the changed output law. -/
theorem finiteLiftOutput_KL {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (f : α → β) (ν : FiniteLaw β)
    (hμ : ∀ a, 0 < μ.mass a) (hpos : ∀ b, 0 < (finiteMap μ f).mass b) :
    finiteKLReal (finiteLiftOutput μ f ν hpos) μ = finiteKLReal ν (finiteMap μ f) := by
  have he (a : α) :
      (finiteLiftOutput μ f ν hpos).mass a *
        Real.log ((finiteLiftOutput μ f ν hpos).mass a / μ.mass a) =
      μ.mass a * ((ν.mass (f a) / (finiteMap μ f).mass (f a)) *
        Real.log (ν.mass (f a) / (finiteMap μ f).mass (f a))) := by
    dsimp [finiteLiftOutput]
    rw [mul_div_cancel_left₀ _ (hμ a).ne']
    ring
  unfold finiteKLReal
  simp_rw [he]
  have h := finiteExpectation_map μ f
    (fun b => (ν.mass b / (finiteMap μ f).mass b) * Real.log (ν.mass b / (finiteMap μ f).mass b))
  dsimp [finiteExpectation, Function.comp_def] at h
  rw [← h]
  apply Finset.sum_congr rfl
  intro b _
  have hc : (finiteMap μ f).mass b * (ν.mass b / (finiteMap μ f).mass b) = ν.mass b := by field_simp [(hpos b).ne']
  rw [← mul_assoc, hc]

/-- Entropy lifting survives deterministic processing on either side. -/
theorem entropyLifting_map {α β γ δ : Type*} [Fintype α] [Fintype β]
    [Fintype γ] [Fintype δ] (μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z)
    (f : α → γ) (g : β → δ) (hg : ∀ d, 0 < (finiteMap (finiteSecond μ) g).mass d)
    {a : ℝ} (ha : 0 ≤ a) (hlift : EntropyLifting μ a) :
    EntropyLifting (finiteMap μ (fun z => (f z.1, g z.2))) a := by
  intro ν
  let ν' := finiteLiftOutput (finiteSecond μ) g ν hg
  obtain ⟨κ, hκ, hc⟩ := hlift ν'
  refine ⟨finiteMap κ (fun z => (f z.1, g z.2)), ⟨?_, ?_⟩, ?_⟩
  · rw [finiteFirst_map_pair, finiteFirst_map_pair, hκ.1]
  · rw [finiteSecond_map_pair, hκ.2]
    exact finiteLiftOutput_map _ _ _ _
  · have hKL := finiteKLReal_map_le κ μ (fun z => (f z.1, g z.2))
      (fun z hz => ((hμ z).ne' hz).elim)
    have h := (mul_le_mul_of_nonneg_left hKL ha).trans hc
    rw [finiteSecond_map_pair]
    exact h.trans_eq (finiteLiftOutput_KL _ _ _ (finiteSecond_pos μ hμ) hg)

/-- Data processing for s† under deterministic functions, on positive reference tables
and positive output tables (zero-probability output letters may be deleted first). -/
theorem sDagger_map_le {α β γ δ : Type*} [Fintype α] [Fintype β]
    [Fintype γ] [Fintype δ] (μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z)
    (f : α → γ) (g : β → δ)
    (hout : ∀ z, 0 < (finiteMap μ (fun z => (f z.1, g z.2))).mass z) :
    sDagger (finiteMap μ (fun z => (f z.1, g z.2))) ≤ sDagger μ := by
  let a := (reverseComplement μ).toReal
  have hfin : reverseComplement μ ≠ ⊤ := ne_top_of_le_ne_top (by simp) (reverseComplement_le_one μ)
  have ha : a ∈ Set.Icc (0 : ℝ) 1 := by
    refine ⟨ENNReal.toReal_nonneg, ?_⟩
    have h := ENNReal.toReal_mono (by simp : (1 : ℝ≥0∞) ≠ ⊤) (reverseComplement_le_one μ)
    simpa [a] using h
  have hbase : EntropyLifting μ a := entropyLifting_of_reverseComplement μ hμ ha.1
    (by simp [a, ENNReal.ofReal_toReal, hfin])
  have hg : ∀ d, 0 < (finiteMap (finiteSecond μ) g).mass d := by
    intro d
    rw [← finiteSecond_map_pair μ f g]
    exact finiteSecond_pos _ hout d
  have houtLift := entropyLifting_map μ hμ f g hg ha.1 hbase
  have h := reverseComplement_ge_of_lifting _ hout ha houtLift
  have houtfin : reverseComplement (finiteMap μ (fun z => (f z.1, g z.2))) ≠ ⊤ :=
    ne_top_of_le_ne_top (by simp) (reverseComplement_le_one _)
  have hreal := ENNReal.toReal_mono houtfin h
  rw [ENNReal.toReal_ofReal ha.1] at hreal
  unfold sDagger
  dsimp [a] at hreal
  linarith

/-- Append an independent conditional output W to the V coordinate of (U,V). -/
def finiteExtendRight {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (μ : FiniteLaw (α × β)) (κ : β → FiniteLaw γ) : FiniteLaw (α × (β × γ)) where
  mass z := μ.mass (z.1,z.2.1) * (κ z.2.1).mass z.2.2
  nonneg z := mul_nonneg (μ.nonneg _) ((κ _).nonneg _)
  total := by
    simp only [Fintype.sum_prod_type]
    simp_rw [← Finset.mul_sum, (κ _).total]
    simpa [Fintype.sum_prod_type] using μ.total

/-- Adding a conditional output preserves the U marginal. -/
theorem finiteFirst_extendRight {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (μ : FiniteLaw (α × β)) (κ : β → FiniteLaw γ) :
    finiteFirst (finiteExtendRight μ κ) = finiteFirst μ := by
  ext a
  rw [finiteFirst_mass, finiteFirst_mass]
  simp only [finiteExtendRight, Fintype.sum_prod_type]
  simp_rw [← Finset.mul_sum, (κ _).total]
  simp

/-- The extended right marginal is the joint law of (V,W). -/
theorem finiteSecond_extendRight {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (μ : FiniteLaw (α × β)) (κ : β → FiniteLaw γ) :
    finiteSecond (finiteExtendRight μ κ) = finiteJoint (finiteSecond μ) κ := by
  ext z
  rw [finiteSecond_mass]
  simp only [finiteExtendRight, finiteJoint, finiteSecond_mass, ← Finset.sum_mul]

/-- KL chain rule when the added output kernel depends only on the second coordinate. -/
theorem finiteKLReal_extendRight {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (ν μ : FiniteLaw (α × β)) (τ κ : β → FiniteLaw γ)
    (hμ : ∀ z, 0 < μ.mass z) (hκ : ∀ b c, 0 < (κ b).mass c) :
    finiteKLReal (finiteExtendRight ν τ) (finiteExtendRight μ κ) = finiteKLReal ν μ +
      ∑ b, (finiteSecond ν).mass b * finiteKLReal (τ b) (κ b) := by
  simp only [finiteKLReal, finiteExtendRight, Fintype.sum_prod_type]
  simp_rw [finiteKL_atom_product _ _ (hμ _).ne' (hκ _ _).ne']
  simp_rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.mul_sum, (τ _).total, one_mul]
  congr 1
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_mul, ← finiteSecond_mass]

/-- Entropy lifting is preserved when a stochastic output is appended on the right.
The conditional KL cost of the appended output is paid with coefficient at most one. -/
theorem entropyLifting_extendRight {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (μ : FiniteLaw (α × β)) (κ : β → FiniteLaw γ)
    (hμ : ∀ z, 0 < μ.mass z) (hκ : ∀ b c, 0 < (κ b).mass c)
    {a : ℝ} (ha : a ∈ Set.Icc (0 : ℝ) 1) (hlift : EntropyLifting μ a) :
    EntropyLifting (finiteExtendRight μ κ) a := by
  intro ν
  obtain ⟨σ, hσ, hcost⟩ := hlift (finiteFirst ν)
  refine ⟨finiteExtendRight σ (finiteConditionalLaw ν), ⟨?_, ?_⟩, ?_⟩
  · rw [finiteFirst_extendRight, finiteFirst_extendRight, hσ.1]
  · rw [finiteSecond_extendRight, hσ.2, finiteJoint_conditional]
  · rw [finiteKLReal_extendRight _ _ _ _ hμ hκ, hσ.2, finiteSecond_extendRight]
    have hc := finiteKLReal_joint (finiteFirst ν) (finiteSecond μ) (finiteConditionalLaw ν) κ
      (finiteSecond_pos μ hμ) hκ
    rw [finiteJoint_conditional] at hc
    rw [hc]
    have hn : 0 ≤ ∑ b, (finiteFirst ν).mass b * finiteKLReal (finiteConditionalLaw ν b) (κ b) :=
      Finset.sum_nonneg (fun b _ => mul_nonneg ((finiteFirst ν).nonneg b)
        (finiteKLReal_nonneg _ _ (fun c hc => ((hκ b c).ne' hc).elim)))
    nlinarith [mul_nonneg (sub_nonneg.mpr ha.2) hn]

/-- A surjective map of a positive reference law has a positive output law. -/
theorem finiteMap_pos {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (hμ : ∀ a, 0 < μ.mass a) (f : α → β) (hf : Function.Surjective f)
    (b : β) : 0 < (finiteMap μ f).mass b := by
  classical
  obtain ⟨a, ha⟩ := hf b
  have h : μ.mass a ≤ (finiteMap μ f).mass b := by
    have h := Finset.single_le_sum
      (f := fun a => if f a = b then μ.mass a else 0)
      (fun a _ => by split_ifs; exact (hμ a).le; rfl) (Finset.mem_univ a)
    simpa [ha, finiteMap] using h
  exact (hμ a).trans_le h

/-- Entropy lifting holds at the reverse coefficient itself. -/
theorem entropyLifting_at_coefficient {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw (α × β)) (hμ : ∀ z, 0 < μ.mass z) :
    EntropyLifting μ (1-sDagger μ) := by
  rw [one_sub_sDagger]
  apply entropyLifting_of_reverseComplement μ hμ ENNReal.toReal_nonneg
  rw [ENNReal.ofReal_toReal (ne_top_of_le_ne_top (by simp) (reverseComplement_le_one μ))]

/-- Transfer of the lifting bound at the source coefficient implies coefficient contraction. -/
theorem sDagger_le_of_lifting {α β γ δ : Type*} [Fintype α] [Fintype β]
    [Fintype γ] [Fintype δ] (μ : FiniteLaw (α × β)) (ν : FiniteLaw (γ × δ))
    (hν : ∀ z, 0 < ν.mass z) (hlift : EntropyLifting ν (1-sDagger μ)) :
    sDagger ν ≤ sDagger μ := by
  have hm := sDagger_mem_Icc μ
  have ha : 1-sDagger μ ∈ Set.Icc (0 : ℝ) 1 := ⟨by linarith [hm.2], by linarith [hm.1]⟩
  have h := reverseComplement_ge_of_lifting ν hν ha hlift
  have hreal := ENNReal.toReal_mono
    (ne_top_of_le_ne_top (by simp) (reverseComplement_le_one ν)) h
  rw [ENNReal.toReal_ofReal ha.1] at hreal
  unfold sDagger
  unfold sDagger at hreal
  linarith

/-- Appending a conditionally independent output cannot increase the reverse coefficient. -/
theorem sDagger_extendRight_le {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (μ : FiniteLaw (α × β)) (κ : β → FiniteLaw γ)
    (hμ : ∀ z, 0 < μ.mass z) (hκ : ∀ b c, 0 < (κ b).mass c) :
    sDagger (finiteExtendRight μ κ) ≤ sDagger μ := by
  have hm := sDagger_mem_Icc μ
  have ha : 1-sDagger μ ∈ Set.Icc (0 : ℝ) 1 := ⟨by linarith [hm.2], by linarith [hm.1]⟩
  apply sDagger_le_of_lifting μ _ (fun z => mul_pos (hμ _) (hκ _ _))
  exact entropyLifting_extendRight μ κ hμ hκ ha (entropyLifting_at_coefficient μ hμ)

/-- Stochastic processing of V: keep U and output W from the conditional kernel. -/
def finiteRightChannel {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (μ : FiniteLaw (α × β)) (κ : β → FiniteLaw γ) : FiniteLaw (α × γ) :=
  finiteMap (finiteExtendRight μ κ) (fun z => (z.1,z.2.2))

/-- Stochastic data processing on the right, for positive reference tables and channels.
This includes the strictly positive biased perturbations used to handle c=d. -/
theorem sDagger_rightChannel_le {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (μ : FiniteLaw (α × β)) (κ : β → FiniteLaw γ)
    (hμ : ∀ z, 0 < μ.mass z) (hκ : ∀ b c, 0 < (κ b).mass c) :
    sDagger (finiteRightChannel μ κ) ≤ sDagger μ := by
  have hpos : ∀ z, 0 < (finiteExtendRight μ κ).mass z := fun z => mul_pos (hμ _) (hκ _ _)
  have hsurj : Function.Surjective (fun z : α × (β × γ) => (z.1,z.2.2)) := by
    obtain ⟨z⟩ := finiteLaw_nonempty μ
    intro ac
    exact ⟨(ac.1,z.2,ac.2), rfl⟩
  exact (sDagger_map_le (finiteExtendRight μ κ) hpos id Prod.snd
    (finiteMap_pos _ hpos _ hsurj)).trans (sDagger_extendRight_le μ κ hμ hκ)

end

