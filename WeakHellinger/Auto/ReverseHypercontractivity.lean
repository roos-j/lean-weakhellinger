def finiteKLReal {α : Type*} [Fintype α] (ν μ : FiniteLaw α) : ℝ :=
  ∑ a, ν.mass a * Real.log (ν.mass a / μ.mass a)

/-- Finite-alphabet Kullback–Leibler divergence with its usual infinity convention.
It is infinite exactly when the first law gives positive mass to a zero-mass
