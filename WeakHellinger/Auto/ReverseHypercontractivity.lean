/-- A conditional kernel produces a normalized joint distribution. -/
def finiteJoint {α β : Type*} [Fintype α] [Fintype β]
    (μ : FiniteLaw α) (κ : α → FiniteLaw β) : FiniteLaw (α × β) where
  mass z := μ.mass z.1 * (κ z.1).mass z.2
  nonneg z := mul_nonneg (μ.nonneg _) ((κ _).nonneg _)
  total := by
    rw [Fintype.sum_prod_type]
    simp_rw [← Finset.mul_sum, (κ _).total]
    simpa using μ.total

