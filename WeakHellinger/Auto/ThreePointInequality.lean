    have hab : |1 - x - y| ≤ 1 := by
      rw [abs_le]
      constructor <;> linarith [hx'.1, hx'.2, hy'.1, hy'.2]
    simpa using mul_le_mul_of_nonneg_left hab (abs_nonneg (x - y))
  calc
    |1 / (x * (1 - x)) - 1 / (y * (1 - y))| =
        |y * (1 - y) - x * (1 - x)| / (x * (1 - x) * (y * (1 - y))) := by
      rw [div_sub_div _ _ hxd.ne' hyd.ne']
      simp only [one_mul, mul_one, abs_div, abs_of_pos (mul_pos hxd hyd)]
    _ ≤ |x - y| / (x * (1 - x) * (y * (1 - y))) :=
      div_le_div_of_nonneg_right hn (mul_pos hxd hyd).le
    _ ≤ |x - y| / η ^ 4 := div_le_div_of_nonneg_left (abs_nonneg _) (pow_pos hη 4) hd

private theorem probabilitySegment_sub_le {u v u' v' t : ℝ} (ht : t ∈ Set.Icc (0 : ℝ) 1) :
    |probabilitySegment u v t - probabilitySegment u' v' t| ≤ |u - u'| + |v - v'| := by
  have hid : probabilitySegment u v t - probabilitySegment u' v' t =
      (1 - t) * (v - v') + t * (u - u') := by unfold probabilitySegment; ring
  rw [hid]
  calc
    |(1 - t) * (v - v') + t * (u - u')| ≤
        |(1 - t) * (v - v')| + |t * (u - u')| := abs_add_le _ _
    _ = (1 - t) * |v - v'| + t * |u - u'| := by
      rw [abs_mul, abs_mul, abs_of_nonneg (sub_nonneg.mpr ht.2), abs_of_nonneg ht.1]
    _ ≤ |u - u'| + |v - v'| := by
      nlinarith [mul_nonneg ht.1 (abs_nonneg (v - v')),
        mul_nonneg (sub_nonneg.mpr ht.2) (abs_nonneg (u - u'))]

/-- Blueprint `lem:Kregular`, equation (Kbound): the quantitative difference estimate,
valid also when either normalized divergence is on the diagonal. -/
theorem K_sub_le_of_margin {η u v u' v' : ℝ} (hη : 0 < η)
    (hu : u ∈ Set.Icc η (1 - η)) (hv : v ∈ Set.Icc η (1 - η))
    (hu' : u' ∈ Set.Icc η (1 - η)) (hv' : v' ∈ Set.Icc η (1 - η)) :
    |K u v - K u' v'| ≤ (|u - u'| + |v - v'|) / (2 * η ^ 4) := by
  have hi := intervalIntegrable_KIntegrand (interior_of_margin hη hu) (interior_of_margin hη hv)
  have hi' := intervalIntegrable_KIntegrand (interior_of_margin hη hu') (interior_of_margin hη hv')
  rw [K_eq_integral (interior_of_margin hη hu) (interior_of_margin hη hv),
    K_eq_integral (interior_of_margin hη hu') (interior_of_margin hη hv'),
    ← intervalIntegral.integral_sub hi hi']
  refine (intervalIntegral.abs_integral_le_integral_abs (by norm_num : (0 : ℝ) ≤ 1)).trans ?_
  have hbound : IntervalIntegrable (fun t : ℝ =>
      (1 - t) * ((|u - u'| + |v - v'|) / η ^ 4)) volume 0 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  have hm := intervalIntegral.integral_mono_on (by norm_num : (0 : ℝ) ≤ 1)
    (hi.sub hi').abs hbound (fun t ht => ?_)
  · rw [intervalIntegral.integral_mul_const, integral_one_sub] at hm
    convert! hm using 1
    field_simp
  · have hrec := reciprocal_denominator_sub_le hη
      (probabilitySegment_mem_Icc hu hv ht) (probabilitySegment_mem_Icc hu' hv' ht)
    have hseg := probabilitySegment_sub_le (u := u) (v := v) (u' := u') (v' := v') ht
    have hid : (1 - t) / (probabilitySegment u v t * (1 - probabilitySegment u v t)) -
        (1 - t) / (probabilitySegment u' v' t * (1 - probabilitySegment u' v' t)) =
        (1 - t) * (1 / (probabilitySegment u v t * (1 - probabilitySegment u v t)) -
          1 / (probabilitySegment u' v' t * (1 - probabilitySegment u' v' t))) := by ring
    rw [hid, abs_mul, abs_of_nonneg (sub_nonneg.mpr ht.2)]
    exact mul_le_mul_of_nonneg_left
      (hrec.trans (div_le_div_of_nonneg_right hseg (pow_pos hη 4).le)) (sub_nonneg.mpr ht.2)

/-- Blueprint `lem:Kregular`: joint continuity of `K` at every interior pair,
including the diagonal, deduced from its quantitative difference estimate. -/
theorem continuousAt_K {u v : ℝ} (hu : u ∈ Set.Ioo (0 : ℝ) 1)
    (hv : v ∈ Set.Ioo (0 : ℝ) 1) : ContinuousAt (fun p : ℝ × ℝ => K p.1 p.2) (u, v) := by
  let m := min (min u (1 - u)) (min v (1 - v))
  have hm : 0 < m := lt_min (lt_min hu.1 (sub_pos.mpr hu.2))
    (lt_min hv.1 (sub_pos.mpr hv.2))
  have hmu : m ≤ u := (min_le_left _ _).trans (min_le_left _ _)
  have hmuc : m ≤ 1 - u := (min_le_left _ _).trans (min_le_right _ _)
  have hmv : m ≤ v := (min_le_right _ _).trans (min_le_left _ _)
  have hmvc : m ≤ 1 - v := (min_le_right _ _).trans (min_le_right _ _)
  let η := m / 2
  have hη : 0 < η := half_pos hm
  have huη : u ∈ Set.Icc η (1 - η) := ⟨by dsimp [η]; linarith, by dsimp [η]; linarith⟩
  have hvη : v ∈ Set.Icc η (1 - η) := ⟨by dsimp [η]; linarith, by dsimp [η]; linarith⟩
  rw [Metric.continuousAt_iff]
  intro ε hε
  refine ⟨min η (ε * η ^ 4), lt_min hη (mul_pos hε (pow_pos hη 4)), ?_⟩
  intro p hp
  rw [Prod.dist_eq, max_lt_iff, Real.dist_eq, Real.dist_eq] at hp
  have hpu : |p.1 - u| < η := hp.1.trans_le (min_le_left _ _)
  have hpv : |p.2 - v| < η := hp.2.trans_le (min_le_left _ _)
  have hpu' : p.1 ∈ Set.Icc η (1 - η) := by
    rcases abs_lt.mp hpu with ⟨h₁, h₂⟩
    dsimp [η] at *
    constructor <;> linarith
  have hpv' : p.2 ∈ Set.Icc η (1 - η) := by
    rcases abs_lt.mp hpv with ⟨h₁, h₂⟩
    dsimp [η] at *
    constructor <;> linarith
  rw [Real.dist_eq]
  refine (K_sub_le_of_margin hη hpu' hpv' huη hvη).trans_lt ?_
  apply (div_lt_iff₀ (mul_pos (by norm_num) (pow_pos hη 4))).mpr
  have h₁ := hp.1.trans_le (min_le_right η (ε * η ^ 4))
  have h₂ := hp.2.trans_le (min_le_right η (ε * η ^ 4))
  nlinarith

/-- Blueprint `lem:Kregular`: continuity on the entire open probability square. -/
theorem continuousOn_K : ContinuousOn (fun p : ℝ × ℝ => K p.1 p.2)
    (Set.Ioo (0 : ℝ) 1 ×ˢ Set.Ioo (0 : ℝ) 1) := by
  intro p hp
  exact (continuousAt_K hp.1 hp.2).continuousWithinAt

/-- Blueprint `def:HI`: the nonsingular integral function `H`, used for `0 ≤ X < 1`. -/
noncomputable def H (X : ℝ) : ℝ := ∫ t in (0 : ℝ)..1, 1 / (1 - X * t ^ 2)

/-- Blueprint `def:HI`: the nonsingular integral function `I`, used for `0 ≤ X < 1`. -/
noncomputable def I (X : ℝ) : ℝ := ∫ t in (0 : ℝ)..1, (1 - t ^ 2) / (1 - X * t ^ 2)

private theorem HI_denominator_pos {X t : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1)
    (ht : t ∈ Set.Icc (0 : ℝ) 1) : 0 < 1 - X * t ^ 2 := by
  have hsq : t ^ 2 ≤ 1 := by nlinarith [ht.1, ht.2]
  nlinarith [mul_nonneg hX.1 (sub_nonneg.mpr hsq), hX.2]

private theorem continuousOn_HIntegrand {X : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1) :
    ContinuousOn (fun t => 1 / (1 - X * t ^ 2)) (Set.Icc (0 : ℝ) 1) := by
  apply ContinuousOn.div continuousOn_const
  · fun_prop
  · intro t ht
    exact (HI_denominator_pos hX ht).ne'

private theorem intervalIntegrable_HIntegrand {X : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1) :
    IntervalIntegrable (fun t => 1 / (1 - X * t ^ 2)) volume 0 1 := by
  apply ContinuousOn.intervalIntegrable
  simpa using continuousOn_HIntegrand hX

/-- Blueprint `lem:HIidentities`: `H(0) = 1`. -/
@[simp] theorem H_zero : H 0 = 1 := by simp [H]

/-- Blueprint `lem:HIidentities`: `I(0) = 2/3`. -/
@[simp] theorem I_zero : I 0 = 2 / 3 := by
  simp only [I, zero_mul, sub_zero, div_one]
  rw [intervalIntegral.integral_sub intervalIntegrable_const (by
    apply Continuous.intervalIntegrable
    fun_prop)]
  norm_num [integral_pow]

/-- Blueprint `lem:HIidentities`, equation (Hformula): evaluation by an antiderivative. -/
theorem H_eq_artanh {X : ℝ} (hX : X ∈ Set.Ioo (0 : ℝ) 1) :
    H X = artanh (Real.sqrt X) / Real.sqrt X := by
  have hs : 0 < Real.sqrt X := Real.sqrt_pos.mpr hX.1
  have hsq := Real.sq_sqrt hX.1.le
  have hs1 : Real.sqrt X < 1 := (Real.sqrt_lt' (by norm_num)).mpr (by simpa using hX.2)
  have hd : ∀ t ∈ Set.uIcc (0 : ℝ) 1,
      HasDerivAt (fun t => artanh (Real.sqrt X * t) / Real.sqrt X)
        (1 / (1 - X * t ^ 2)) t := by
    intro t ht
    have ht' : t ∈ Set.Icc (0 : ℝ) 1 := by simpa using ht
    have ha : |Real.sqrt X * t| < 1 := by
      rw [abs_of_nonneg (mul_nonneg hs.le ht'.1)]
      nlinarith [mul_nonneg hs.le (sub_nonneg.mpr ht'.2)]
    have hden : 1 - X * t ^ 2 ≠ 0 := (HI_denominator_pos ⟨hX.1.le, hX.2⟩ ht').ne'
    convert! ((hasDerivAt_artanh ha).comp t
      ((hasDerivAt_id t).const_mul (Real.sqrt X))).div_const (Real.sqrt X) using 1
    simp only [mul_pow, hsq, mul_one]
    field_simp
  have he := intervalIntegral.integral_eq_sub_of_hasDerivAt hd
    (intervalIntegrable_HIntegrand ⟨hX.1.le, hX.2⟩)
  simpa only [H, mul_one, mul_zero, artanh_zero, zero_div, sub_zero] using he

/-- Blueprint `lem:HIidentities`, equation (Iformula): the relation between `H` and `I`,
including at zero. -/
theorem mul_I_eq {X : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1) :
    X * I X = 1 - (1 - X) * H X := by
  unfold I
  rw [← intervalIntegral.integral_const_mul]
  calc
    (∫ t in (0 : ℝ)..1, X * ((1 - t ^ 2) / (1 - X * t ^ 2))) =
        ∫ t in (0 : ℝ)..1, 1 - (1 - X) * (1 / (1 - X * t ^ 2)) := by
      apply intervalIntegral.integral_congr
      intro t ht
      have hd := (HI_denominator_pos hX (by simpa using ht)).ne'
      field_simp
      ring
    _ = 1 - (1 - X) * H X := by
      rw [intervalIntegral.integral_sub intervalIntegrable_const
        ((intervalIntegrable_HIntegrand hX).const_mul (1 - X)),
        intervalIntegral.integral_const_mul]
      simp [H]

/-- Blueprint `lem:HIidentities`, equation (Hformula): the derivative of `H` for `0 < X < 1`. -/
theorem hasDerivAt_H {X : ℝ} (hX : X ∈ Set.Ioo (0 : ℝ) 1) :
    HasDerivAt H ((1 / (1 - X) - H X) / (2 * X)) X := by
  have hs : 0 < Real.sqrt X := Real.sqrt_pos.mpr hX.1
  have hsq := Real.sq_sqrt hX.1.le
  have hs1 : |Real.sqrt X| < 1 := by
    rw [abs_of_pos hs]
    exact (Real.sqrt_lt' (by norm_num)).mpr (by simpa using hX.2)
  have hroot := Real.hasDerivAt_sqrt hX.1.ne'
  have hd := ((hasDerivAt_artanh hs1).comp X hroot).div hroot hs.ne'
  have he : HasDerivAt (fun x => artanh (Real.sqrt x) / Real.sqrt x)
      ((1 / (1 - X) - H X) / (2 * X)) X := by
    convert! hd using 1
    simp only [Function.comp_apply]
    rw [H_eq_artanh hX, hsq]
    field_simp [hX.1.ne', (sub_pos.mpr hX.2).ne']
  apply he.congr_of_eventuallyEq
  filter_upwards [isOpen_Ioo.mem_nhds hX] with x hx using H_eq_artanh hx

/-- Estimate at zero in the proof of blueprint `lem:HIidentities`:
`0 ≤ H(X)-1 ≤ X/(3(1-X))` for `0 ≤ X < 1`. -/
theorem H_sub_one_bounds {X : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1) :
    0 ≤ H X - 1 ∧ H X - 1 ≤ X / (3 * (1 - X)) := by
  have hid : H X - 1 = ∫ t in (0 : ℝ)..1, (1 / (1 - X * t ^ 2) - 1) := by
    rw [intervalIntegral.integral_sub (intervalIntegrable_HIntegrand hX) intervalIntegrable_const]
    simp [H]
  have hpoint (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) :
      0 ≤ 1 / (1 - X * t ^ 2) - 1 ∧
      1 / (1 - X * t ^ 2) - 1 ≤ X / (1 - X) * t ^ 2 := by
    have hd := HI_denominator_pos hX ht
    have he : 1 / (1 - X * t ^ 2) - 1 = X * t ^ 2 / (1 - X * t ^ 2) := by
      field_simp
      ring
    rw [he]
    constructor
    · exact div_nonneg (mul_nonneg hX.1 (sq_nonneg t)) hd.le
    · calc
        X * t ^ 2 / (1 - X * t ^ 2) ≤ X * t ^ 2 / (1 - X) := by
          apply div_le_div_of_nonneg_left (mul_nonneg hX.1 (sq_nonneg t)) (sub_pos.mpr hX.2)
          have ht2 : t ^ 2 ≤ 1 := by nlinarith [ht.1, ht.2]
          nlinarith [mul_nonneg hX.1 (sub_nonneg.mpr ht2)]
        _ = X / (1 - X) * t ^ 2 := by ring
  rw [hid]
  constructor
  · exact intervalIntegral.integral_nonneg (by norm_num) (fun t ht => (hpoint t ht).1)
  · have hi : IntervalIntegrable (fun t : ℝ => X / (1 - X) * t ^ 2) volume 0 1 := by
      apply Continuous.intervalIntegrable
      fun_prop
    have hm := intervalIntegral.integral_mono_on (by norm_num : (0 : ℝ) ≤ 1)
      ((intervalIntegrable_HIntegrand hX).sub intervalIntegrable_const) hi
      (fun t ht => (hpoint t ht).2)
    rw [intervalIntegral.integral_const_mul, integral_pow] at hm
    norm_num at hm
    convert! hm using 1 <;> field_simp [(sub_pos.mpr hX.2).ne']

/-- Blueprint `lem:HIidentities`: continuity of `H` on `[0,1)`, including its value at zero. -/
theorem continuousOn_H : ContinuousOn H (Set.Ico (0 : ℝ) 1) := by
  intro X hX
  rcases eq_or_lt_of_le hX.1 with h | h
  · subst X
    rw [Metric.continuousWithinAt_iff]
    intro ε hε
    refine ⟨min (1 / 2) (3 * ε / 2), lt_min (by norm_num) (by positivity), ?_⟩
    intro x hx hdist
    rw [Real.dist_eq, sub_zero, abs_of_nonneg hx.1] at hdist
    rw [Real.dist_eq, H_zero, abs_of_nonneg (H_sub_one_bounds hx).1]
    refine (H_sub_one_bounds hx).2.trans_lt ?_
    apply (div_lt_iff₀ (mul_pos (by norm_num) (sub_pos.mpr hx.2))).mpr
    have h₁ := hdist.trans_le (min_le_left (1 / 2) (3 * ε / 2))
    have h₂ := hdist.trans_le (min_le_right (1 / 2) (3 * ε / 2))
    nlinarith [mul_pos hε (show 0 < 1 / 2 - x by linarith)]
  · exact (hasDerivAt_H ⟨h, hX.2⟩).continuousAt.continuousWithinAt

/-- Blueprint `lem:Hbounds`, equation (Hbounds): the lower bound for `H`. -/
theorem H_lower_bound {X : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1) : 1 + X / 3 ≤ H X := by
  have hi : IntervalIntegrable (fun t : ℝ => 1 + X * t ^ 2) volume 0 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  have hm := intervalIntegral.integral_mono_on (by norm_num : (0 : ℝ) ≤ 1)
    hi (intervalIntegrable_HIntegrand hX) (fun t ht => ?_)
  · rw [intervalIntegral.integral_add intervalIntegrable_const (by
      apply Continuous.intervalIntegrable
      fun_prop), intervalIntegral.integral_const_mul, integral_pow] at hm
    norm_num [H, div_eq_mul_inv] at hm ⊢
    exact hm
  · apply (le_div_iff₀ (HI_denominator_pos hX ht)).mpr
    nlinarith [sq_nonneg (X * t ^ 2)]

/-- The comparison function `g` in the proof of blueprint `lem:Hbounds`. -/
noncomputable def HComparison (x : ℝ) : ℝ :=
  x * ((7 + x ^ 2) / 15 + 8 / (15 * r x)) - artanh x

/-- Blueprint `lem:Hbounds`, equation (gder): the factored derivative of the comparison function. -/
theorem hasDerivAt_HComparison {x : ℝ} (hx : |x| < 1) :
    HasDerivAt HComparison
      ((1 - r x) ^ 3 * (3 * r x ^ 2 + 9 * r x + 8) / (15 * r x ^ 3)) x := by
  have hr := r_pos hx
  have hs := r_sq hx.le
  have hden : 15 * r x ≠ 0 := mul_ne_zero (by norm_num) hr.ne'
  have hd := ((hasDerivAt_id x).mul
    ((((hasDerivAt_id x).fun_pow 2).const_add 7).div_const 15 |>.add
      ((hasDerivAt_const x (8 : ℝ)).div ((hasDerivAt_r hx).const_mul 15) hden))).sub
    (hasDerivAt_artanh hx)
  convert! hd using 1
  simp only [Pi.add_apply, Pi.div_apply, id_eq]
  rw [← hs]
  field_simp [hr.ne']
  have hx2 : x ^ 2 = 1 - r x ^ 2 := by linarith
  ring_nf
  rw [hx2]
  ring

/-- Monotonicity step in the proof of blueprint `lem:Hbounds`. -/
theorem HComparison_nonneg {x : ℝ} (hx : x ∈ Set.Ico (0 : ℝ) 1) : 0 ≤ HComparison x := by
  have hder y (hy : y ∈ Set.Ico (0 : ℝ) 1) :=
    hasDerivAt_HComparison (show |y| < 1 by rw [abs_of_nonneg hy.1]; exact hy.2)
  have hmono : MonotoneOn HComparison (Set.Ico (0 : ℝ) 1) := by
    apply monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ico (𝕜 := ℝ) 0 1)
    · intro y hy
      exact (hder y hy).continuousAt.continuousWithinAt
    · intro y hy
      exact (hder y (interior_subset hy)).hasDerivWithinAt
    · intro y hy
      have hr := r_nonneg y
      have hr1 := r_le_one y
      positivity
  have hm := hmono (show (0 : ℝ) ∈ Set.Ico (0 : ℝ) 1 by norm_num) hx hx.1
  simpa [HComparison] using hm

/-- Blueprint `lem:Hbounds`, equation (Hbounds): the upper bound for `H`. -/
theorem H_upper_bound {X : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1) :
    H X ≤ (7 + X) / 15 + 8 / (15 * Real.sqrt (1 - X)) := by
  rcases eq_or_lt_of_le hX.1 with h | h
  · subst X
    norm_num
  · have hs := Real.sqrt_pos.mpr h
    have hs1 : Real.sqrt X < 1 := (Real.sqrt_lt' (by norm_num)).mpr (by simpa using hX.2)
    have hm := HComparison_nonneg ⟨hs.le, hs1⟩
    rw [H_eq_artanh ⟨h, hX.2⟩]
    apply (div_le_iff₀ hs).mpr
    simpa only [HComparison, r, Real.sq_sqrt h.le, sub_nonneg, mul_comm] using hm

private theorem intervalIntegrable_IIntegrand {X : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1) :
    IntervalIntegrable (fun t => (1 - t ^ 2) / (1 - X * t ^ 2)) volume 0 1 := by
  apply ContinuousOn.intervalIntegrable
  apply ContinuousOn.div
  · fun_prop
  · fun_prop
  · intro t ht
    exact (HI_denominator_pos hX (by simpa using ht)).ne'

/-- Blueprint `lem:Ibounds`, equation (Ipointwise): the two pointwise rational bounds. -/
theorem I_integrand_bounds {X t : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1)
    (ht : t ∈ Set.Icc (0 : ℝ) 1) :
    1 - t ^ 2 ≤ (1 - t ^ 2) / (1 - X * t ^ 2) ∧
      (1 - t ^ 2) / (1 - X * t ^ 2) ≤ 1 - (1 - X) * t ^ 2 := by
  have hd := HI_denominator_pos hX ht
  have ht2 : t ^ 2 ≤ 1 := by nlinarith [ht.1, ht.2]
  constructor
  · rw [le_div_iff₀ hd]
    nlinarith [mul_nonneg (mul_nonneg hX.1 (sq_nonneg t)) (sub_nonneg.mpr ht2)]
  · rw [div_le_iff₀ hd]
    nlinarith [mul_nonneg (mul_nonneg hX.1 (sub_pos.mpr hX.2).le) (sq_nonneg (t ^ 2))]

/-- Blueprint `lem:Ibounds`, equation (Ibounds): `2/3 ≤ I(X) ≤ (2+X)/3`. -/
theorem I_bounds {X : ℝ} (hX : X ∈ Set.Ico (0 : ℝ) 1) :
    2 / 3 ≤ I X ∧ I X ≤ (2 + X) / 3 := by
  have hbase : (∫ t in (0 : ℝ)..1, 1 - t ^ 2) = 2 / 3 := by
    simpa only [I, zero_mul, sub_zero, div_one] using I_zero
  have hi₁ : IntervalIntegrable (fun t : ℝ => 1 - t ^ 2) volume 0 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  have hi₂ : IntervalIntegrable (fun t : ℝ => 1 - (1 - X) * t ^ 2) volume 0 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  constructor
  · have hm := intervalIntegral.integral_mono_on (by norm_num : (0 : ℝ) ≤ 1)
      hi₁ (intervalIntegrable_IIntegrand hX) (fun t ht => (I_integrand_bounds hX ht).1)
    rwa [hbase] at hm
  · have hm := intervalIntegral.integral_mono_on (by norm_num : (0 : ℝ) ≤ 1)
      (intervalIntegrable_IIntegrand hX) hi₂ (fun t ht => (I_integrand_bounds hX ht).2)
    rw [intervalIntegral.integral_sub intervalIntegrable_const (by
      apply Continuous.intervalIntegrable
      fun_prop), intervalIntegral.integral_const_mul, integral_pow] at hm
    norm_num at hm
    dsimp [I]
    linarith

private theorem H_derivative_le {x : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 1) :
    (1 / (1 - x) - H x) / (2 * x) ≤ 1 / (2 * (1 - x)) - 1 / 6 := by
  rw [div_le_iff₀ (mul_pos (by norm_num) hx.1)]
  have he : (1 / (2 * (1 - x)) - 1 / 6) * (2 * x) =
      1 / (1 - x) - (1 + x / 3) := by
    field_simp [(sub_pos.mpr hx.2).ne']
    ring
  rw [he]
  linarith [H_lower_bound ⟨hx.1.le, hx.2⟩]

private theorem hasDerivAt_HLogComparison {x : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 1) :
    HasDerivAt (fun x => -Real.log (1 - x) / 2 - x / 6 - H x)
      (1 / (2 * (1 - x)) - 1 / 6 - (1 / (1 - x) - H x) / (2 * x)) x := by
  convert! (((((hasDerivAt_id x).const_sub 1).log (sub_pos.mpr hx.2).ne').neg.div_const 2).sub
    ((hasDerivAt_id x).div_const 6)).sub (hasDerivAt_H hx) using 1
  dsimp
  field_simp

/-- Blueprint `lem:Hdifference`, first inequality of (Hdiff), with `σ² = 1-Y`. -/
theorem H_difference_log_bound {Z Y : ℝ} (hZ : 0 < Z) (hZY : Z < Y) (hY : Y < 1) :
    H Y - H Z ≤ Real.log ((1 - Z) / (1 - Y)) / 2 - (Y - Z) / 6 := by
  have hmono : MonotoneOn (fun x => -Real.log (1 - x) / 2 - x / 6 - H x)
      (Set.Ioo (0 : ℝ) 1) := by
    apply monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ioo (𝕜 := ℝ) 0 1)
    · intro x hx
      exact (hasDerivAt_HLogComparison hx).continuousAt.continuousWithinAt
    · intro x hx
      exact (hasDerivAt_HLogComparison (interior_subset hx)).hasDerivWithinAt
    · intro x hx
      exact sub_nonneg.mpr (H_derivative_le (interior_subset hx))
  have hm := hmono (show Z ∈ Set.Ioo (0 : ℝ) 1 from ⟨hZ, hZY.trans hY⟩)
    (show Y ∈ Set.Ioo (0 : ℝ) 1 from ⟨hZ.trans hZY, hY⟩) hZY.le
  rw [Real.log_div (sub_pos.mpr (hZY.trans hY)).ne' (sub_pos.mpr hY).ne']
  linarith

/-- Elementary logarithm estimate in the proof of blueprint `lem:Hdifference`:
`2 log h ≤ h - h⁻¹` for `h ≥ 1`. -/
theorem two_mul_log_le_sub_inv {h : ℝ} (hh : 1 ≤ h) : 2 * Real.log h ≤ h - h⁻¹ := by
  have hd x (hx : 0 < x) : HasDerivAt (fun x : ℝ => x - x⁻¹ - 2 * Real.log x)
      ((1 - x⁻¹) ^ 2) x := by
    convert! ((hasDerivAt_id x).sub ((hasDerivAt_id x).inv hx.ne')).sub
      ((Real.hasDerivAt_log hx.ne').const_mul 2) using 1
    dsimp
    field_simp
    ring
  have hmono : MonotoneOn (fun x : ℝ => x - x⁻¹ - 2 * Real.log x) (Set.Ioi (0 : ℝ)) := by
    apply monotoneOn_of_hasDerivWithinAt_nonneg (convex_Ioi (𝕜 := ℝ) 0)
    · intro x hx
      exact (hd x hx).continuousAt.continuousWithinAt
    · intro x hx
      exact (hd x (interior_subset hx)).hasDerivWithinAt
    · intro x _
      exact sq_nonneg _
  have hm := hmono (show (1 : ℝ) ∈ Set.Ioi (0 : ℝ) by norm_num)
    (show h ∈ Set.Ioi (0 : ℝ) from lt_of_lt_of_le (by norm_num) hh) hh
  simpa only [inv_one, sub_self, Real.log_one, mul_zero, sub_zero, sub_nonneg] using hm

/-- Blueprint `lem:Hdifference`, equation (Hdiff): the logarithmic and algebraic difference bounds. -/
theorem H_difference_bounds {Z Y : ℝ} (hZ : 0 < Z) (hZY : Z < Y) (hY : Y < 1) :
    H Y - H Z ≤ Real.log ((1 - Z) / (Real.sqrt (1 - Y)) ^ 2) / 2 - (Y - Z) / 6 ∧
    Real.log ((1 - Z) / (Real.sqrt (1 - Y)) ^ 2) / 2 - (Y - Z) / 6 ≤
      (Y - Z) * (1 / (2 * Real.sqrt (1 - Z) * Real.sqrt (1 - Y)) - 1 / 6) := by
  have hP : 0 < 1 - Z := sub_pos.mpr (hZY.trans hY)
  have hS : 0 < 1 - Y := sub_pos.mpr hY
  have hp : 0 < Real.sqrt (1 - Z) := Real.sqrt_pos.mpr hP
  have hs : 0 < Real.sqrt (1 - Y) := Real.sqrt_pos.mpr hS
  have hp2 := Real.sq_sqrt hP.le
  have hs2 := Real.sq_sqrt hS.le
  constructor
  · rw [hs2]
    exact H_difference_log_bound hZ hZY hY
  · have hrat : 1 ≤ Real.sqrt (1 - Z) / Real.sqrt (1 - Y) := by
      rw [le_div_iff₀ hs, one_mul]
      exact Real.sqrt_le_sqrt (by linarith)
    have hm := two_mul_log_le_sub_inv hrat
    have he : (1 - Z) / Real.sqrt (1 - Y) ^ 2 =
        (Real.sqrt (1 - Z) / Real.sqrt (1 - Y)) ^ 2 := by rw [div_pow, hp2]
    rw [he, Real.log_pow]
    have he' : Real.sqrt (1 - Z) / Real.sqrt (1 - Y) -
        (Real.sqrt (1 - Z) / Real.sqrt (1 - Y))⁻¹ =
        (Y - Z) / (Real.sqrt (1 - Z) * Real.sqrt (1 - Y)) := by
      field_simp
      nlinarith [hp2, hs2]
    rw [he'] at hm
    have hf : (Y - Z) * (1 / (2 * Real.sqrt (1 - Z) * Real.sqrt (1 - Y)) - 1 / 6) =
        ((Y - Z) / (Real.sqrt (1 - Z) * Real.sqrt (1 - Y))) / 2 - (Y - Z) / 6 := by
      field_simp
    rw [hf]
    norm_num only [Nat.cast_ofNat]
    linarith

/-- Blueprint (main-pq): the first mixed probability. -/
def p (s c d : ℝ) : ℝ := s * (1 - c) + (1 - s) * d

/-- Blueprint (main-pq): the second mixed probability. -/
def q (s c d : ℝ) : ℝ := s * (1 - d) + (1 - s) * c

/-- The weighted denominator in blueprint (main-R). -/
noncomputable def Rdenominator (s c d : ℝ) : ℝ := s * K c d + (1 - s) * K d c

/-- Blueprint (main-R) and the boundary convention of `thm:main`.
The outside-cube value is zero. On the spatial boundary the exceptional cases
are assigned one and every other case is assigned zero, before any division. -/
noncomputable def R (s c d : ℝ) : ℝ :=
  if s ∈ Set.Icc (0 : ℝ) 1 ∧ c ∈ Set.Icc (0 : ℝ) 1 ∧ d ∈ Set.Icc (0 : ℝ) 1 then
    if c ∈ Set.Ioo (0 : ℝ) 1 ∧ d ∈ Set.Ioo (0 : ℝ) 1 then
      Real.sqrt (K (p s c d) (q s c d) / Rdenominator s c d)
    else if s = 0 ∨ s = 1 ∨ c + d = 1 then 1 else 0
  else 0

/-- Blueprint `lem:domain`: both mixed probabilities are interior. -/
theorem pq_mem {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    p s c d ∈ Set.Ioo (0 : ℝ) 1 ∧ q s c d ∈ Set.Ioo (0 : ℝ) 1 := by
  constructor
  · simpa only [p, probabilitySegment, add_comm] using probabilitySegment_mem
      (show 1 - c ∈ Set.Ioo (0 : ℝ) 1 from ⟨by linarith [hc.2], by linarith [hc.1]⟩) hd hs
  · simpa only [q, probabilitySegment, add_comm] using probabilitySegment_mem
      (show 1 - d ∈ Set.Ioo (0 : ℝ) 1 from ⟨by linarith [hd.2], by linarith [hd.1]⟩) hc hs

/-- Blueprint `lem:domain`: the normalized denominator is at least two. -/
theorem Rdenominator_ge_two {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    2 ≤ Rdenominator s c d := by
  unfold Rdenominator
  nlinarith [mul_nonneg hs.1 (sub_nonneg.mpr (K_ge_two hc hd)),
    mul_nonneg (sub_nonneg.mpr hs.2) (sub_nonneg.mpr (K_ge_two hd hc))]

/-- The interior branch of blueprint (main-R). -/
theorem R_eq_sqrt {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    R s c d = Real.sqrt (K (p s c d) (q s c d) / Rdenominator s c d) := by
  rw [R, ite_eq_left ⟨hs, ⟨hc.1.le, hc.2.le⟩, ⟨hd.1.le, hd.2.le⟩⟩,
    ite_eq_left ⟨hc, hd⟩]

/-- Blueprint `lem:domain`: squaring `R` recovers the normalized divergence quotient. -/
theorem R_sq {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    R s c d ^ 2 = K (p s c d) (q s c d) / Rdenominator s c d := by
  rw [R_eq_sqrt hs hc hd]
  apply Real.sq_sqrt
  have hpq := pq_mem hs hc hd
  exact div_nonneg (by linarith [K_ge_two hpq.1 hpq.2]) (by linarith [Rdenominator_ge_two hs hc hd])

/-- Blueprint `lem:domain`, equation (divratio): the mixed probabilities differ by `d-c`. -/
theorem p_sub_q (s c d : ℝ) : p s c d - q s c d = d - c := by unfold p q; ring

/-- The bridge between normalized and unnormalized divergence used in blueprint `lem:domain`.
The identity also holds when its arguments coincide. -/
theorem D_eq_K_mul_sq {u v : ℝ} (hu : u ∈ Set.Ioo (0 : ℝ) 1)
    (hv : v ∈ Set.Ioo (0 : ℝ) 1) : D u v = K u v * (u - v) ^ 2 := by
  rw [D_eq_integral hu hv, K_eq_integral hu hv]
  ring

/-- Blueprint `lem:domain`: the original divergence denominator is strictly positive off the diagonal. -/
theorem divergence_denominator_pos {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) (hcd : c ≠ d) :
    0 < s * D c d + (1 - s) * D d c := by
  rw [D_eq_K_mul_sq hc hd, D_eq_K_mul_sq hd hc]
  have he : s * (K c d * (c - d) ^ 2) + (1 - s) * (K d c * (d - c) ^ 2) =
      Rdenominator s c d * (c - d) ^ 2 := by unfold Rdenominator; ring
  rw [he]
  exact mul_pos (by linarith [Rdenominator_ge_two hs hc hd]) (sq_pos_of_ne_zero (sub_ne_zero.mpr hcd))

/-- Blueprint `lem:domain`, equation (divratio): the original divergence quotient away from `c=d`. -/
theorem R_sq_eq_divergence_ratio {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) (hcd : c ≠ d) :
    R s c d ^ 2 = D (p s c d) (q s c d) / (s * D c d + (1 - s) * D d c) := by
  have hpq := pq_mem hs hc hd
  rw [R_sq hs hc hd, D_eq_K_mul_sq hpq.1 hpq.2,
    D_eq_K_mul_sq hc hd, D_eq_K_mul_sq hd hc, p_sub_q]
  have hsq : (d - c) ^ 2 = (c - d) ^ 2 := by ring
  rw [hsq]
  have he : s * (K c d * (c - d) ^ 2) + (1 - s) * (K d c * (c - d) ^ 2) =
      Rdenominator s c d * (c - d) ^ 2 := by unfold Rdenominator; ring
  rw [he]
  field_simp [sub_ne_zero.mpr hcd]

/-- Blueprint `lem:domain`: joint continuity on the interior spatial domain,
with continuity relative to the closed `s` interval at its endpoints. -/
theorem continuousOn_R : ContinuousOn (fun x : ℝ × ℝ × ℝ => R x.1 x.2.1 x.2.2)
    (Set.Icc (0 : ℝ) 1 ×ˢ (Set.Ioo (0 : ℝ) 1 ×ˢ Set.Ioo (0 : ℝ) 1)) := by
  intro x hx
  have hcd : ContinuousAt (fun y : ℝ × ℝ × ℝ => K y.2.1 y.2.2) x := by
    exact (continuousAt_K hx.2.1 hx.2.2).comp
      (f := fun y : ℝ × ℝ × ℝ => (y.2.1, y.2.2)) (by fun_prop)
  have hdc : ContinuousAt (fun y : ℝ × ℝ × ℝ => K y.2.2 y.2.1) x := by
    exact (continuousAt_K hx.2.2 hx.2.1).comp
      (f := fun y : ℝ × ℝ × ℝ => (y.2.2, y.2.1)) (by fun_prop)
  have hpq := pq_mem hx.1 hx.2.1 hx.2.2
  have hnum : ContinuousAt (fun y : ℝ × ℝ × ℝ => K (p y.1 y.2.1 y.2.2)
      (q y.1 y.2.1 y.2.2)) x :=
    (continuousAt_K hpq.1 hpq.2).comp
      (f := fun y : ℝ × ℝ × ℝ => (p y.1 y.2.1 y.2.2, q y.1 y.2.1 y.2.2))
      (by unfold p q; fun_prop)
  have hden : ContinuousAt (fun y : ℝ × ℝ × ℝ => Rdenominator y.1 y.2.1 y.2.2) x := by
    simpa only [Rdenominator] using!
      (continuousAt_fst.mul hcd).add ((continuousAt_const.sub continuousAt_fst).mul hdc)
  have hne : Rdenominator x.1 x.2.1 x.2.2 ≠ 0 :=
    ne_of_gt (by linarith [Rdenominator_ge_two hx.1 hx.2.1 hx.2.2])
  apply (hnum.div hden hne).sqrt.continuousWithinAt.congr
  · intro y hy
    exact R_eq_sqrt hy.1 hy.2.1 hy.2.2
  · exact R_eq_sqrt hx.1 hx.2.1 hx.2.2

/-- Blueprint `def:originalC`, used already in the symmetry reduction:
the original inequality is equivalent to `R s c d ≤ originalC s c d`. -/
noncomputable def originalC (s c d : ℝ) : ℝ :=
  1 - r (2 * q s c d - 1) + s * r (2 * d - 1) + (1 - s) * r (2 * c - 1)

/-- The four equality alternatives in blueprint (main-equality). -/
def equalityCase (s c d : ℝ) : Prop :=
  s = 0 ∨ s = 1 ∨ c + d = 1 ∨ (s = 1 / 2 ∧ c = d)

private theorem r_probability_complement (x : ℝ) : r (2 * (1 - x) - 1) = r (2 * x - 1) := by
  rw [show 2 * (1 - x) - 1 = -(2 * x - 1) by ring, r_neg]

/-- First symmetry in blueprint `lem:reduction`: exchange the spatial parameters and the weights. -/
theorem R_exchange {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    R (1 - s) d c = R s c d := by
  have hs' : 1 - s ∈ Set.Icc (0 : ℝ) 1 := ⟨by linarith [hs.2], by linarith [hs.1]⟩
  rw [R_eq_sqrt hs' hd hc, R_eq_sqrt hs hc hd]
  have hp : p (1 - s) d c = 1 - p s c d := by unfold p; ring
  have hq : q (1 - s) d c = 1 - q s c d := by unfold q; ring
  have hden : Rdenominator (1 - s) d c = Rdenominator s c d := by unfold Rdenominator; ring
  have hpq := pq_mem hs hc hd
  rw [hp, hq, hden, K_complement hpq.1 hpq.2]

/-- Second symmetry in blueprint `lem:reduction`: complement both spatial probabilities. -/
theorem R_complement {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    R s (1 - c) (1 - d) = R s c d := by
  have hc' : 1 - c ∈ Set.Ioo (0 : ℝ) 1 := ⟨by linarith [hc.2], by linarith [hc.1]⟩
  have hd' : 1 - d ∈ Set.Ioo (0 : ℝ) 1 := ⟨by linarith [hd.2], by linarith [hd.1]⟩
  rw [R_eq_sqrt hs hc' hd', R_eq_sqrt hs hc hd]
  have hp : p s (1 - c) (1 - d) = 1 - p s c d := by unfold p; ring
  have hq : q s (1 - c) (1 - d) = 1 - q s c d := by unfold q; ring
  have hden : Rdenominator s (1 - c) (1 - d) = Rdenominator s c d := by
    simp only [Rdenominator, K_complement hc hd, K_complement hd hc]
  have hpq := pq_mem hs hc hd
  rw [hp, hq, hden, K_complement hpq.1 hpq.2]

/-- Blueprint `lem:reduction`: the comparison function is invariant under exchanging weights. -/
theorem originalC_exchange (s c d : ℝ) : originalC (1 - s) d c = originalC s c d := by
  have hq : q (1 - s) d c = 1 - q s c d := by unfold q; ring
  simp only [originalC, hq, r_probability_complement]
  ring

/-- Blueprint `lem:reduction`: the comparison function is invariant under spatial complementation. -/
theorem originalC_complement (s c d : ℝ) : originalC s (1 - c) (1 - d) = originalC s c d := by
  have hq : q s (1 - c) (1 - d) = 1 - q s c d := by unfold q; ring
  simp only [originalC, hq, r_probability_complement]

/-- Blueprint `lem:reduction`: exchanging weights preserves the equality alternatives. -/
theorem equalityCase_exchange (s c d : ℝ) : equalityCase (1 - s) d c ↔ equalityCase s c d := by
  have h₀ : 1 - s = 0 ↔ s = 1 := by constructor <;> intro h <;> linarith
  have h₁ : 1 - s = 1 ↔ s = 0 := by constructor <;> intro h <;> linarith
  have hhalf : 1 - s = 1 / 2 ↔ s = 1 / 2 := by constructor <;> intro h <;> linarith
  simp only [equalityCase, h₀, h₁, hhalf, add_comm d c, eq_comm (a := d) (b := c)]
  tauto

/-- Blueprint `lem:reduction`: spatial complementation preserves the equality alternatives. -/
theorem equalityCase_complement (s c d : ℝ) :
    equalityCase s (1 - c) (1 - d) ↔ equalityCase s c d := by
  have hsum : 1 - c + (1 - d) = 1 ↔ c + d = 1 := by constructor <;> intro h <;> linarith
  have heq : 1 - c = 1 - d ↔ c = d := by constructor <;> intro h <;> linarith
  simp only [equalityCase, hsum, heq]

/-- Blueprint (kdef): the divergence in centered spatial coordinates. -/
noncomputable def k (h b : ℝ) : ℝ := K ((1 + h + b) / 2) ((1 + h - b) / 2)

/-- Blueprint (Bdef): the reduced weighted denominator. -/
noncomputable def B (a b t : ℝ) : ℝ := (1 + t) / 2 * k a b + (1 - t) / 2 * k (-a) b

/-- Blueprint (eCdef): the weighted endpoint semicircle values. -/
noncomputable def e (a b t : ℝ) : ℝ := (1 + t) / 2 * r (a - b) + (1 - t) / 2 * r (a + b)

/-- Blueprint (eCdef): the reduced comparison function, with `u = ta`. -/
noncomputable def C (a b t : ℝ) : ℝ := 1 - r (t * a - b) + e a b t

/-- Blueprint `lem:reduction`, equation (coordinates-linear): all four coordinate identities. -/
theorem centered_coordinates (s c d : ℝ) :
    2 * c - 1 = (c + d - 1) - (d - c) ∧
    2 * d - 1 = (c + d - 1) + (d - c) ∧
    2 * p s c d - 1 = (1 - 2 * s) * (c + d - 1) + (d - c) ∧
    2 * q s c d - 1 = (1 - 2 * s) * (c + d - 1) - (d - c) := by
  unfold p q
  constructor; ring
  constructor; ring
  constructor <;> ring

/-- Blueprint `lem:reduction`: the comparison functions agree in the centered coordinates. -/
theorem C_eq_originalC (s c d : ℝ) :
    C (c + d - 1) (d - c) (1 - 2 * s) = originalC s c d := by
  rcases centered_coordinates s c d with ⟨h₁, h₂, _, h₄⟩
  simp only [C, e, originalC, ← h₁, ← h₂, ← h₄]
  ring

/-- Blueprint `lem:reduction`: the reduced and original denominators agree. -/
theorem B_eq_Rdenominator {s c d : ℝ} (hc : c ∈ Set.Ioo (0 : ℝ) 1)
    (hd : d ∈ Set.Ioo (0 : ℝ) 1) : B (c + d - 1) (d - c) (1 - 2 * s) = Rdenominator s c d := by
  have hk₁ : k (c + d - 1) (d - c) = K d c := by
    unfold k
    congr 1 <;> ring
  have hk₂ : k (-(c + d - 1)) (d - c) = K c d := by
    rw [← K_complement hc hd]
    unfold k
    congr 1 <;> ring
  rw [B, hk₁, hk₂, Rdenominator]
  ring

/-- Blueprint `lem:reduction`, equation (Rreduced): the reduced formula for `R²`. -/
theorem R_sq_reduced {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    R s c d ^ 2 = k ((1 - 2 * s) * (c + d - 1)) (d - c) /
      B (c + d - 1) (d - c) (1 - 2 * s) := by
  rw [R_sq hs hc hd, B_eq_Rdenominator hc hd]
  have hk : k ((1 - 2 * s) * (c + d - 1)) (d - c) = K (p s c d) (q s c d) := by
    unfold k p q
    congr 1 <;> ring
  rw [hk]

/-- Blueprint `lem:reduction`: every interior triple has a symmetric representative
with `c+d ≥ 1` and `c ≤ d`, preserving the comparison, ratio, and equality alternatives. -/
theorem exists_normalized_triple {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    ∃ s' c' d', s' ∈ Set.Icc (0 : ℝ) 1 ∧ c' ∈ Set.Ioo (0 : ℝ) 1 ∧
      d' ∈ Set.Ioo (0 : ℝ) 1 ∧ 1 ≤ c' + d' ∧ c' ≤ d' ∧
      R s' c' d' = R s c d ∧ originalC s' c' d' = originalC s c d ∧
      (equalityCase s' c' d' ↔ equalityCase s c d) := by
  have hsum : ∃ c' d', c' ∈ Set.Ioo (0 : ℝ) 1 ∧ d' ∈ Set.Ioo (0 : ℝ) 1 ∧
      1 ≤ c' + d' ∧ R s c' d' = R s c d ∧ originalC s c' d' = originalC s c d ∧
      (equalityCase s c' d' ↔ equalityCase s c d) := by
    by_cases ha : 1 ≤ c + d
    · exact ⟨c, d, hc, hd, ha, rfl, rfl, Iff.rfl⟩
    · refine ⟨1 - c, 1 - d, ⟨by linarith [hc.2], by linarith [hc.1]⟩,
        ⟨by linarith [hd.2], by linarith [hd.1]⟩, by linarith,
        R_complement hs hc hd, originalC_complement s c d, equalityCase_complement s c d⟩
  rcases hsum with ⟨c', d', hc', hd', hsum, hR, hC, hE⟩
  by_cases hsort : c' ≤ d'
  · exact ⟨s, c', d', hs, hc', hd', hsum, hsort, hR, hC, hE⟩
  · refine ⟨1 - s, d', c', ⟨by linarith [hs.2], by linarith [hs.1]⟩,
      hd', hc', by linarith, le_of_lt (lt_of_not_ge hsort), ?_, ?_, ?_⟩
    · exact (R_exchange hs hc' hd').trans hR
    · exact (originalC_exchange s c' d').trans hC
    · exact (equalityCase_exchange s c' d').trans hE

/-- Blueprint `lem:reduction`: the normalized representative yields exactly the reduced domain. -/
theorem normalized_coordinates_mem {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hd : d < 1) (hsum : 1 ≤ c + d) (hsort : c ≤ d) :
    0 ≤ c + d - 1 ∧ 0 ≤ d - c ∧ (c + d - 1) + (d - c) < 1 ∧
      1 - 2 * s ∈ Set.Icc (-1 : ℝ) 1 := by
  exact ⟨by linarith, by linarith, by linarith, ⟨by linarith [hs.2], by linarith [hs.1]⟩⟩

/-- The domain of the two arguments in blueprint (kdef). -/
theorem k_arguments_mem {h b : ℝ} (hhb : |h| + |b| < 1) :
    (1 + h + b) / 2 ∈ Set.Ioo (0 : ℝ) 1 ∧ (1 + h - b) / 2 ∈ Set.Ioo (0 : ℝ) 1 := by
  constructor <;> constructor <;>
    nlinarith [le_abs_self h, neg_abs_le h, le_abs_self b, neg_abs_le b]

/-- Blueprint `lem:reduction`: `k` is at least two in its domain. -/
theorem k_ge_two {h b : ℝ} (hhb : |h| + |b| < 1) : 2 ≤ k h b := by
  exact K_ge_two (k_arguments_mem hhb).1 (k_arguments_mem hhb).2

/-- Blueprint `lem:reduction`: the reduced denominator is at least two. -/
theorem B_ge_two {a b t : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) : 2 ≤ B a b t := by
  have hk₁ := k_ge_two (show |a| + |b| < 1 by simpa [abs_of_nonneg ha, abs_of_nonneg hb])
  have hk₂ := k_ge_two (show |-a| + |b| < 1 by simpa [abs_of_nonneg ha, abs_of_nonneg hb])
  unfold B
  nlinarith [mul_nonneg (show 0 ≤ 1 + t by linarith [ht.1]) (sub_nonneg.mpr hk₁),
    mul_nonneg (sub_nonneg.mpr ht.2) (sub_nonneg.mpr hk₂)]

/-- Blueprint `lem:reduction`: the reduced comparison function is strictly positive. -/
theorem C_pos {a b t : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) : 0 < C a b t := by
  have h₁ : |a - b| < 1 := by rw [abs_lt]; constructor <;> linarith
  have h₂ : |a + b| < 1 := by rw [abs_of_nonneg (add_nonneg ha hb)]; exact hab
  have he : 0 < e a b t := by
    rcases eq_or_lt_of_le ht.1 with h | h
    · rw [← h]
      simpa [e] using r_pos h₂
    · unfold e
      exact add_pos_of_pos_of_nonneg
        (mul_pos (by linarith) (r_pos h₁))
        (mul_nonneg (by linarith [ht.2]) (r_nonneg _))
  unfold C
  linarith [r_le_one (t * a - b)]

/-- Blueprint `lem:reduction`: subtracting the root terms gives precisely `R ≤ originalC`. -/
theorem three_point_iff_R_le_C (s c d : ℝ) :
    (r (2 * q s c d - 1) - s * r (2 * d - 1) - (1 - s) * r (2 * c - 1) + R s c d ≤ 1) ↔
      R s c d ≤ originalC s c d := by unfold originalC; constructor <;> intro h <;> linarith

/-- The nonnegative reduced ratio in blueprint (Rreduced). -/
noncomputable def reducedR (a b t : ℝ) : ℝ := Real.sqrt (k (t * a) b / B a b t)

/-- Blueprint `lem:reduction`: the reduced ratio is exactly the original ratio. -/
theorem R_eq_reducedR {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    R s c d = reducedR (c + d - 1) (d - c) (1 - 2 * s) := by
  rw [R_eq_sqrt hs hc hd, reducedR, B_eq_Rdenominator hc hd]
  have hk : k ((1 - 2 * s) * (c + d - 1)) (d - c) = K (p s c d) (q s c d) := by
    unfold k p q
    congr 1 <;> ring
  rw [hk]

/-- Nonnegativity of the reduced square root in blueprint (Rreduced). -/
theorem reducedR_nonneg (a b t : ℝ) : 0 ≤ reducedR a b t := Real.sqrt_nonneg _

/-- The valid numerator domain in blueprint `lem:reduction`. -/
theorem reduced_numerator_domain {a b t : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) : |t * a| + |b| < 1 := by
  rw [abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
  have ht' : |t| ≤ 1 := abs_le.mpr ht
  nlinarith [mul_nonneg ha (sub_nonneg.mpr ht')]

/-- Blueprint (Rreduced): the square identity throughout the reduced domain. -/
theorem reducedR_sq {a b t : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) : reducedR a b t ^ 2 = k (t * a) b / B a b t := by
  apply Real.sq_sqrt
  exact div_nonneg (by linarith [k_ge_two (reduced_numerator_domain ha hb hab ht)])
    (by linarith [B_ge_two ha hb hab ht])

/-- Blueprint `lem:exceptional`: `C=1` on `a=0`. -/
theorem C_zero_a (b t : ℝ) : C 0 b t = 1 := by simp only [C, e, mul_zero, zero_sub, r_neg, zero_add]; ring

/-- Blueprint `lem:exceptional`: `R=1` on `a=0`. -/
theorem reducedR_zero_a {b : ℝ} (hb : |b| < 1) (t : ℝ) : reducedR 0 b t = 1 := by
  have hk : k 0 b ≠ 0 := ne_of_gt (by linarith [k_ge_two (show |(0 : ℝ)| + |b| < 1 by simpa)])
  have hB : B 0 b t = k 0 b := by simp only [B, neg_zero]; ring
  simp [reducedR, hB, hk]

/-- Blueprint `lem:exceptional`: `C=1` at `t=1`. -/
theorem C_one_t (a b : ℝ) : C a b 1 = 1 := by simp [C, e]

/-- Blueprint `lem:exceptional`: `C=1` at `t=-1`. -/
theorem C_neg_one_t (a b : ℝ) : C a b (-1) = 1 := by
  have he : -a - b = -(a + b) := by ring
  simp only [C, e, neg_one_mul, he, r_neg]
  ring

/-- Blueprint `lem:exceptional`: `R=1` at `t=1`. -/
theorem reducedR_one_t {a b : ℝ} (hab : |a| + |b| < 1) : reducedR a b 1 = 1 := by
  have hk : k a b ≠ 0 := ne_of_gt (by linarith [k_ge_two hab])
  simp [reducedR, B, hk]

/-- Blueprint `lem:exceptional`: `R=1` at `t=-1`. -/
theorem reducedR_neg_one_t {a b : ℝ} (hab : |a| + |b| < 1) : reducedR a b (-1) = 1 := by
  have hk : k (-a) b ≠ 0 := ne_of_gt (by linarith [k_ge_two (show |-a| + |b| < 1 by simpa)])
  simp [reducedR, B, hk]

/-- Diagonal calculation in blueprint `lem:exceptional`: `k(h,0)=2/(1-h²)`. -/
theorem k_zero_b {h : ℝ} (hh : |h| < 1) : k h 0 = 2 / (1 - h ^ 2) := by
  have hargs := k_arguments_mem (show |h| + |(0 : ℝ)| < 1 by simpa)
  unfold k K
  rw [ite_eq_left hargs]
  simp only [add_zero, sub_zero, ite_true]
  field_simp
  ring

private theorem B_zero_b {a : ℝ} (ha : |a| < 1) (t : ℝ) : B a 0 t = 2 / (1 - a ^ 2) := by
  simp only [B, k_zero_b ha, k_zero_b (show |-a| < 1 by simpa), neg_sq]
  ring

private theorem C_zero_b (a t : ℝ) : C a 0 t = 1 - r (t * a) + r a := by
  simp only [C, e, sub_zero, add_zero]
  ring

private theorem abs_mul_le_of_unit {a t : ℝ} (ha : 0 ≤ a) (ht : t ∈ Set.Icc (-1 : ℝ) 1) :
    |t * a| ≤ a := by
  rw [abs_mul, abs_of_nonneg ha]
  simpa using mul_le_mul_of_nonneg_right (abs_le.mpr ht) ha

/-- Blueprint `lem:exceptional`, equation (diagonal): the exact ratio on `b=0`. -/
theorem reducedR_diagonal {a t : ℝ} (ha : a ∈ Set.Ico (0 : ℝ) 1)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) : reducedR a 0 t = r a / r (t * a) := by
  have haa : |a| < 1 := by rw [abs_of_nonneg ha.1]; exact ha.2
  have hta : |t * a| < 1 := (abs_mul_le_of_unit ha.1 ht).trans_lt ha.2
  apply (sq_eq_sq₀ (reducedR_nonneg a 0 t) (div_nonneg (r_nonneg _) (r_nonneg _))).mp
  rw [reducedR_sq ha.1 le_rfl (by simpa using ha.2) ht,
    k_zero_b hta, B_zero_b haa, div_pow, r_sq haa.le, r_sq hta.le]
  have ha' : 1 - a ^ 2 ≠ 0 := (sub_pos.mpr ((sq_lt_one_iff_abs_lt_one a).mpr haa)).ne'
  field_simp

/-- Blueprint `lem:exceptional`, equation (diagonal): the factored comparison gap. -/
theorem diagonal_gap {a t : ℝ} (ha : a ∈ Set.Ico (0 : ℝ) 1)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) :
    C a 0 t - reducedR a 0 t = (1 - r (t * a)) * (r (t * a) - r a) / r (t * a) := by
  have hr := r_pos ((abs_mul_le_of_unit ha.1 ht).trans_lt ha.2)
  rw [C_zero_b, reducedR_diagonal ha ht]
  field_simp
  ring

/-- Blueprint `lem:exceptional`: the three-point inequality on the spatial diagonal. -/
theorem reducedR_le_C_diagonal {a t : ℝ} (ha : a ∈ Set.Ico (0 : ℝ) 1)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) : reducedR a 0 t ≤ C a 0 t := by
  have hta : (t * a) ^ 2 ≤ a ^ 2 := by
    rw [mul_pow]
    simpa using mul_le_mul_of_nonneg_right ((sq_le_one_iff_abs_le_one t).mpr (abs_le.mpr ht)) (sq_nonneg a)
  have hr : r a ≤ r (t * a) := Real.sqrt_le_sqrt (by linarith)
  have hg : 0 ≤ C a 0 t - reducedR a 0 t := by
    rw [diagonal_gap ha ht]
    exact div_nonneg (mul_nonneg (sub_nonneg.mpr (r_le_one _)) (sub_nonneg.mpr hr)) (r_nonneg _)
  linarith

/-- Blueprint `lem:exceptional`: on `b=0`, equality holds precisely when
`a=0`, `t=0`, or `|t|=1`. -/
theorem diagonal_equality_iff {a t : ℝ} (ha : a ∈ Set.Ico (0 : ℝ) 1)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) :
    reducedR a 0 t = C a 0 t ↔ a = 0 ∨ t = 0 ∨ |t| = 1 := by
  have haa : |a| < 1 := by rw [abs_of_nonneg ha.1]; exact ha.2
  have hta : |t * a| < 1 := (abs_mul_le_of_unit ha.1 ht).trans_lt ha.2
  have hr : r (t * a) ≠ 0 := (r_pos hta).ne'
  constructor
  · intro he
    have hz : C a 0 t - reducedR a 0 t = 0 := sub_eq_zero.mpr he.symm
    rw [diagonal_gap ha ht] at hz
    have hmul : (1 - r (t * a)) * (r (t * a) - r a) = 0 :=
      (div_eq_zero_iff.mp hz).resolve_right hr
    rcases mul_eq_zero.mp hmul with h | h
    · have hta0 : t * a = 0 := (r_eq_one_iff _).mp (by linarith)
      rcases mul_eq_zero.mp hta0 with h | h
      · exact Or.inr (Or.inl h)
      · exact Or.inl h
    · have hsq := (r_eq_iff_sq_eq hta.le haa.le).mp (sub_eq_zero.mp h)
      by_cases ha0 : a = 0
      · exact Or.inl ha0
      · have ht2 : t ^ 2 = 1 := by
          apply (mul_right_cancel₀ (pow_ne_zero 2 ha0))
          simpa only [mul_pow, one_mul] using hsq
        rcases sq_eq_one_iff.mp ht2 with h | h
        · subst t; norm_num
        · subst t; norm_num
  · rintro (h | h | h)
    · subst a
      rw [C_zero_a, reducedR_zero_a (by norm_num)]
    · subst t
      rw [reducedR_diagonal ha ht, C_zero_b]
      simp [r]
    · rcases (abs_eq (by norm_num : (0 : ℝ) ≤ 1)).mp h with h | h
      · subst t
        rw [C_one_t, reducedR_one_t (by simpa using haa)]
      · subst t
        rw [C_neg_one_t, reducedR_neg_one_t (by simpa using haa)]

/-- Blueprint `def:TS`: the mean of the two spatial semicircle values. -/
noncomputable def T (a b : ℝ) : ℝ := (r (a - b) + r (a + b)) / 2

/-- Blueprint `def:TS`: the product of the two spatial semicircle values. -/
noncomputable def S (a b : ℝ) : ℝ := r (a - b) * r (a + b)

private theorem spatial_abs_bounds {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    |a - b| < 1 ∧ |a + b| < 1 := by
  constructor
  · rw [abs_lt]; constructor <;> linarith
  · rwa [abs_of_nonneg (add_nonneg ha hb)]

/-- Blueprint `lem:TS`: the two roots, `T`, and `S` are strictly positive. -/
theorem spatial_quantities_pos {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    0 < r (a - b) ∧ 0 < r (a + b) ∧ 0 < T a b ∧ 0 < S a b := by
  have h₁ := r_pos (spatial_abs_bounds ha hb hab).1
  have h₂ := r_pos (spatial_abs_bounds ha hb hab).2
  exact ⟨h₁, h₂, div_pos (add_pos h₁ h₂) (by norm_num), mul_pos h₁ h₂⟩

/-- Blueprint `lem:TS`, first identity of (TS-first): `r₁ = T + ab/T`. -/
theorem r_sub_eq_T_add {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    r (a - b) = T a b + a * b / T a b := by
  have hs₁ := r_sq (spatial_abs_bounds ha hb hab).1.le
  have hs₂ := r_sq (spatial_abs_bounds ha hb hab).2.le
  have hp := spatial_quantities_pos ha hb hab
  have hsum : r (a - b) + r (a + b) ≠ 0 := (add_pos hp.1 hp.2.1).ne'
  unfold T
  field_simp [hsum]
  nlinarith

/-- Blueprint `lem:TS`, second identity of (TS-first): `r₂ = T - ab/T`. -/
theorem r_add_eq_T_sub {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    r (a + b) = T a b - a * b / T a b := by
  have h₁ := r_sub_eq_T_add ha hb hab
  have he : 2 * T a b = r (a - b) + r (a + b) := by unfold T; ring
  linarith

/-- Blueprint `lem:TS`, third identity of (TS-first): the product in terms of `T`. -/
theorem S_eq_T_sq_sub {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    S a b = T a b ^ 2 - a ^ 2 * b ^ 2 / T a b ^ 2 := by
  rw [S, r_sub_eq_T_add ha hb hab, r_add_eq_T_sub ha hb hab]
  ring

/-- Intermediate squared-mean identity in the proof of blueprint `lem:TS`. -/
theorem T_sq_eq {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    T a b ^ 2 = (1 - a ^ 2 - b ^ 2 + S a b) / 2 := by
  have h₁ := r_sq (spatial_abs_bounds ha hb hab).1.le
  have h₂ := r_sq (spatial_abs_bounds ha hb hab).2.le
  unfold T S
  nlinarith

/-- Blueprint `lem:TS`, first identity of (TS-second). -/
theorem one_sub_sq_eq_T_sq_add {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    1 - a ^ 2 - b ^ 2 = T a b ^ 2 + a ^ 2 * b ^ 2 / T a b ^ 2 := by
  have h := T_sq_eq ha hb hab
  rw [S_eq_T_sq_sub ha hb hab] at h
  linarith

/-- Blueprint `lem:TS`, second identity of (TS-second): `(T²+a²)(T²+b²)=T²`. -/
theorem T_sq_product {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    (T a b ^ 2 + a ^ 2) * (T a b ^ 2 + b ^ 2) = T a b ^ 2 := by
  have h := one_sub_sq_eq_T_sq_add ha hb hab
  have hT : T a b ≠ 0 := (spatial_quantities_pos ha hb hab).2.2.1.ne'
  field_simp at h
  nlinarith

/-- Blueprint `def:vy`: the first algebraic coordinate. -/
noncomputable def vCoord (a b : ℝ) : ℝ := a / (T a b ^ 2 + a ^ 2)

/-- Blueprint `def:vy`: the second algebraic coordinate. -/
noncomputable def yCoord (a b : ℝ) : ℝ := b / (T a b ^ 2 + b ^ 2)

/-- Blueprint `lem:vy`: both algebraic coordinates belong to `(0,1)`. -/
theorem coordinates_mem {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    vCoord a b ∈ Set.Ioo 0 1 ∧ yCoord a b ∈ Set.Ioo 0 1 := by
  have hp := spatial_quantities_pos ha.le hb.le hab
  have hT := sq_pos_of_pos hp.2.2.1
  have hDa : 0 < T a b ^ 2 + a ^ 2 := add_pos_of_pos_of_nonneg hT (sq_nonneg a)
  have hDb : 0 < T a b ^ 2 + b ^ 2 := add_pos_of_pos_of_nonneg hT (sq_nonneg b)
  have he := T_sq_eq ha.le hb.le hab
  have h₁ : 0 < (1 - a - b) * (1 - a + b) := mul_pos (by linarith) (by linarith)
  have h₂ : 0 < (1 - b - a) * (1 - b + a) := mul_pos (by linarith) (by linarith)
  constructor
  · exact ⟨div_pos ha hDa, (div_lt_one hDa).mpr (by nlinarith [hp.2.2.2])⟩
  · exact ⟨div_pos hb hDb, (div_lt_one hDb).mpr (by nlinarith [hp.2.2.2])⟩

/-- Blueprint `lem:vy`, first identity of (coord-basic): `vy = ab/T²`. -/
theorem coordinates_product {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    vCoord a b * yCoord a b = a * b / T a b ^ 2 := by
  unfold vCoord yCoord
  rw [div_mul_div_comm, T_sq_product ha hb hab]

/-- Blueprint `lem:vy`, second identity of (coord-basic): `P = S/T²`. -/
theorem coordinates_P {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b < 1) :
    1 - (vCoord a b * yCoord a b) ^ 2 = S a b / T a b ^ 2 := by
  rw [coordinates_product ha hb hab, S_eq_T_sq_sub ha hb hab]
  have hT := (spatial_quantities_pos ha hb hab).2.2.1.ne'
  field_simp

/-- Blueprint `lem:vy`, the two squared-root identities in (coord-basic). -/
theorem coordinates_root_sq {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    r (vCoord a b) ^ 2 = S a b / (T a b ^ 2 + a ^ 2) ∧
    r (yCoord a b) ^ 2 = S a b / (T a b ^ 2 + b ^ 2) := by
  have hc := coordinates_mem ha hb hab
  have hv : |vCoord a b| ≤ 1 := by rw [abs_of_pos hc.1.1]; exact hc.1.2.le
  have hy : |yCoord a b| ≤ 1 := by rw [abs_of_pos hc.2.1]; exact hc.2.2.le
  rw [r_sq hv, r_sq hy]
  have hT := sq_pos_of_pos (spatial_quantities_pos ha.le hb.le hab).2.2.1
  have hDa : T a b ^ 2 + a ^ 2 ≠ 0 := (add_pos_of_pos_of_nonneg hT (sq_nonneg a)).ne'
  have hDb : T a b ^ 2 + b ^ 2 ≠ 0 := (add_pos_of_pos_of_nonneg hT (sq_nonneg b)).ne'
  have he : S a b = 2 * T a b ^ 2 + a ^ 2 + b ^ 2 - 1 := by
    linarith [T_sq_eq ha.le hb.le hab]
  have hp := T_sq_product ha.le hb.le hab
  unfold vCoord yCoord
  constructor <;> field_simp <;> rw [he] <;> nlinarith [hp]

/-- Blueprint `lem:vy`: the product and its square have the asserted strict ranges. -/
theorem coordinate_ranges {v y : ℝ} (hv : v ∈ Set.Ioo 0 1) (hy : y ∈ Set.Ioo 0 1) :
    0 < v * y ∧ v * y < y ∧ y < 1 ∧
    0 < (v * y) ^ 2 ∧ (v * y) ^ 2 < y ^ 2 ∧ y ^ 2 < 1 ∧
    0 < r v ∧ 0 < r y ∧ 0 < 1 - (v * y) ^ 2 := by
  have hz : 0 < v * y := mul_pos hv.1 hy.1
  have hzy : v * y < y := by nlinarith [hv.2, hy.1]
  have hsq : (v * y) ^ 2 < y ^ 2 := by nlinarith
  have hyq : y ^ 2 < 1 := by nlinarith [hy.1, hy.2]
  exact ⟨hz, hzy, hy.2, sq_pos_of_pos hz, hsq, hyq,
    r_pos (by rw [abs_of_pos hv.1]; exact hv.2),
    r_pos (by rw [abs_of_pos hy.1]; exact hy.2), by linarith⟩

/-- Blueprint `lem:vy`, the first two inverse coordinate formulas. -/
theorem coordinates_inverse {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    a = vCoord a b * r (yCoord a b) ^ 2 / (1 - (vCoord a b * yCoord a b) ^ 2) ∧
    b = yCoord a b * r (vCoord a b) ^ 2 / (1 - (vCoord a b * yCoord a b) ^ 2) := by
  rw [(coordinates_root_sq ha hb hab).1, (coordinates_root_sq ha hb hab).2,
    coordinates_P ha.le hb.le hab]
  have hT := sq_pos_of_pos (spatial_quantities_pos ha.le hb.le hab).2.2.1
  have hS := (spatial_quantities_pos ha.le hb.le hab).2.2.2.ne'
  have hDa : T a b ^ 2 + a ^ 2 ≠ 0 := (add_pos_of_pos_of_nonneg hT (sq_nonneg a)).ne'
  have hDb : T a b ^ 2 + b ^ 2 ≠ 0 := (add_pos_of_pos_of_nonneg hT (sq_nonneg b)).ne'
  have hp := T_sq_product ha.le hb.le hab
  unfold vCoord yCoord
  constructor <;> field_simp <;> nlinarith [hp]

/-- Blueprint `lem:vy`, the inverse formula for `T`. -/
theorem coordinates_T {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    T a b = r (vCoord a b) * r (yCoord a b) /
      (1 - (vCoord a b * yCoord a b) ^ 2) := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hP := hr.2.2.2.2.2.2.2.2
  have hp := spatial_quantities_pos ha.le hb.le hab
  have hT := hp.2.2.1.ne'
  apply (sq_eq_sq₀ hp.2.2.1.le (div_nonneg (mul_nonneg (r_nonneg _) (r_nonneg _)) hP.le)).mp
  rw [div_pow, mul_pow, (coordinates_root_sq ha hb hab).1,
    (coordinates_root_sq ha hb hab).2, div_mul_div_comm,
    T_sq_product ha.le hb.le hab, coordinates_P ha.le hb.le hab]
  have hS := hp.2.2.2.ne'
  field_simp

/-- The factorizations used in both directions of blueprint `lem:vy`. -/
theorem inverse_coordinate_sums {v y : ℝ} (hv : v ∈ Set.Ioo 0 1) (hy : y ∈ Set.Ioo 0 1) :
    v * r y ^ 2 / (1 - (v * y) ^ 2) + y * r v ^ 2 / (1 - (v * y) ^ 2) =
      (v + y) / (1 + v * y) ∧
    v * r y ^ 2 / (1 - (v * y) ^ 2) - y * r v ^ 2 / (1 - (v * y) ^ 2) =
      (v - y) / (1 - v * y) := by
  have hr := coordinate_ranges hv hy
  have hm : 1 - v * y ≠ 0 := by have := hr.2.1; have := hy.2; linarith
  have hp : 1 + v * y ≠ 0 := by have := hr.1; linarith
  have hP := hr.2.2.2.2.2.2.2.2.ne'
  rw [r_sq (by rw [abs_of_pos hy.1]; exact hy.2.le),
    r_sq (by rw [abs_of_pos hv.1]; exact hv.2.le)]
  have hP' : 1 - v ^ 2 * y ^ 2 ≠ 0 := by simpa only [mul_pow] using hP
  constructor <;> field_simp [hP', hP, hm, hp] <;> ring

/-- Blueprint `lem:vy`, the sum and difference formulas in (coord-sums). -/
theorem coordinates_sums {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    a + b = (vCoord a b + yCoord a b) / (1 + vCoord a b * yCoord a b) ∧
    a - b = (vCoord a b - yCoord a b) / (1 - vCoord a b * yCoord a b) := by
  have hc := coordinates_mem ha hb hab
  have hi := coordinates_inverse ha hb hab
  have hs := inverse_coordinate_sums hc.1 hc.2
  constructor
  · calc a + b = _ := congrArg₂ (· + ·) hi.1 hi.2
         _ = _ := hs.1
  · calc a - b = _ := congrArg₂ (· - ·) hi.1 hi.2
         _ = _ := hs.2

/-- Square-root formulas used in the converse of blueprint `lem:vy`. -/
theorem rational_coordinate_roots {v y : ℝ} (hv : v ∈ Set.Ioo 0 1) (hy : y ∈ Set.Ioo 0 1) :
    r ((v - y) / (1 - v * y)) = r v * r y / (1 - v * y) ∧
    r ((v + y) / (1 + v * y)) = r v * r y / (1 + v * y) := by
  have hv' : |v| < 1 := by rw [abs_of_pos hv.1]; exact hv.2
  have hy' : |y| < 1 := by rw [abs_of_pos hy.1]; exact hy.2
  have hr := coordinate_ranges hv hy
  have hm : 0 < 1 - v * y := by have := hr.2.1; have := hy.2; linarith
  have hp : 0 < 1 + v * y := by have := hr.1; linarith
  constructor
  · apply (sq_eq_sq₀ (r_nonneg _) (div_nonneg (mul_nonneg (r_nonneg _) (r_nonneg _)) hm.le)).mp
    rw [r_sq (artanh_sub_argument hv' hy').le]
    simp only [div_pow, mul_pow, r_sq hv'.le, r_sq hy'.le]
    field_simp
    <;> ring
  · apply (sq_eq_sq₀ (r_nonneg _) (div_nonneg (mul_nonneg (r_nonneg _) (r_nonneg _)) hp.le)).mp
    rw [r_sq (artanh_add_argument hv' hy').le]
    simp only [div_pow, mul_pow, r_sq hv'.le, r_sq hy'.le]
    field_simp
    <;> ring

/-- Blueprint `lem:vy`, the last two formulas in (coord-sums). -/
theorem coordinates_roots {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    r (a - b) = r (vCoord a b) * r (yCoord a b) / (1 - vCoord a b * yCoord a b) ∧
    r (a + b) = r (vCoord a b) * r (yCoord a b) / (1 + vCoord a b * yCoord a b) := by
  rw [(coordinates_sums ha hb hab).1, (coordinates_sums ha hb hab).2]
  exact rational_coordinate_roots (coordinates_mem ha hb hab).1 (coordinates_mem ha hb hab).2

/-- Blueprint `lem:vy`, converse: the inverse expressions give positive spatial
parameters whose sum is less than one. -/
theorem inverse_coordinates_domain {v y : ℝ} (hv : v ∈ Set.Ioo 0 1) (hy : y ∈ Set.Ioo 0 1) :
    0 < v * r y ^ 2 / (1 - (v * y) ^ 2) ∧
    0 < y * r v ^ 2 / (1 - (v * y) ^ 2) ∧
    v * r y ^ 2 / (1 - (v * y) ^ 2) + y * r v ^ 2 / (1 - (v * y) ^ 2) < 1 := by
  have hr := coordinate_ranges hv hy
  have hP := hr.2.2.2.2.2.2.2.2
  refine ⟨div_pos (mul_pos hv.1 (sq_pos_of_pos hr.2.2.2.2.2.2.2.1)) hP,
    div_pos (mul_pos hy.1 (sq_pos_of_pos hr.2.2.2.2.2.2.1)) hP, ?_⟩
  rw [(inverse_coordinate_sums hv hy).1]
  apply (div_lt_one (by have := hr.1; linarith : 0 < 1 + v * y)).mpr
  nlinarith [mul_pos (sub_pos.mpr hv.2) (sub_pos.mpr hy.2)]

/-- Blueprint `lem:vy`, converse: the spatial roots, their mean and their product
are given by the displayed inverse formulas. -/
theorem inverse_coordinates_values {v y : ℝ} (hv : v ∈ Set.Ioo 0 1) (hy : y ∈ Set.Ioo 0 1) :
    let a := v * r y ^ 2 / (1 - (v * y) ^ 2)
    let b := y * r v ^ 2 / (1 - (v * y) ^ 2)
    r (a - b) = r v * r y / (1 - v * y) ∧
    r (a + b) = r v * r y / (1 + v * y) ∧
    T a b = r v * r y / (1 - (v * y) ^ 2) ∧
    S a b = (r v * r y / (1 - (v * y) ^ 2)) ^ 2 * (1 - (v * y) ^ 2) := by
  dsimp only
  have hs := inverse_coordinate_sums hv hy
  have hr := rational_coordinate_roots hv hy
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hs.2]; exact hr.1
  · rw [hs.1]; exact hr.2
  · unfold T
    rw [hs.1, hs.2, hr.1, hr.2]
    have hrange := coordinate_ranges hv hy
    have hm : 1 - v * y ≠ 0 := by have := hrange.2.1; have := hy.2; linarith
    have hp : 1 + v * y ≠ 0 := by have := hrange.1; linarith
    have hP := hrange.2.2.2.2.2.2.2.2.ne'
    have hP' : 1 - v ^ 2 * y ^ 2 ≠ 0 := by simpa only [mul_pow] using hP
    field_simp [hP', hP, hm, hp]
    <;> ring
  · unfold S
    rw [hs.1, hs.2, hr.1, hr.2]
    have hrange := coordinate_ranges hv hy
    have hm : 1 - v * y ≠ 0 := by have := hrange.2.1; have := hy.2; linarith
    have hp : 1 + v * y ≠ 0 := by have := hrange.1; linarith
    have hP := hrange.2.2.2.2.2.2.2.2.ne'
    have hP' : 1 - v ^ 2 * y ^ 2 ≠ 0 := by simpa only [mul_pow] using hP
    field_simp [hP', hP, hm, hp]
    <;> ring

/-- Blueprint `lem:kformula`: the difference of the two inverse hyperbolic tangents. -/
noncomputable def L (a b : ℝ) : ℝ := artanh (a + b) - artanh (a - b)

/-- Blueprint `lem:kformula`: the logarithm of the ratio of spatial roots. -/
noncomputable def J (a b : ℝ) : ℝ := Real.log (r (a - b) / r (a + b))

/-- Blueprint `lem:kformula`, first identity in (LJcoords). -/
theorem L_eq_artanh_coordinate {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    L a b = 2 * artanh (yCoord a b) := by
  have hc := coordinates_mem ha hb hab
  have hv : |vCoord a b| < 1 := by rw [abs_of_pos hc.1.1]; exact hc.1.2
  have hy : |yCoord a b| < 1 := by rw [abs_of_pos hc.2.1]; exact hc.2.2
  unfold L
  rw [(coordinates_sums ha hb hab).1, (coordinates_sums ha hb hab).2,
    artanh_add hv hy, artanh_sub hv hy]
  ring

/-- Blueprint `lem:kformula`, second identity in (LJcoords). -/
theorem J_eq_artanh_coordinate {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    J a b = 2 * artanh (vCoord a b * yCoord a b) := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hm : 1 - vCoord a b * yCoord a b ≠ 0 := by have := hr.2.1; have := hc.2.2; linarith
  have hp : 1 + vCoord a b * yCoord a b ≠ 0 := by have := hr.1; linarith
  have hrv := hr.2.2.2.2.2.2.1.ne'
  have hry := hr.2.2.2.2.2.2.2.1.ne'
  have he : r (a - b) / r (a + b) =
      (1 + vCoord a b * yCoord a b) / (1 - vCoord a b * yCoord a b) := by
    rw [(coordinates_roots ha hb hab).1, (coordinates_roots ha hb hab).2]
    field_simp
  unfold J artanh
  rw [he, Real.log_div hp hm]
  ring

/-- Blueprint `lem:kformula`, equation (kintegral): the affine change of variables
in the integral for `K`. -/
theorem k_eq_integral {h b : ℝ} (hab : |h| + |b| < 1) :
    k h b = ∫ x in (-1 : ℝ)..1, (1 - x) / (1 - (h + b * x) ^ 2) := by
  have hc := k_arguments_mem hab
  unfold k
  rw [K_eq_integral hc.1 hc.2]
  calc
    _ = ∫ t in (0 : ℝ)..1, 2 * ((1 - (2 * t - 1)) / (1 - (h + b * (2 * t - 1)) ^ 2)) := by
      apply intervalIntegral.integral_congr
      intro t ht
      dsimp only
      have he : probabilitySegment ((1 + h + b) / 2) ((1 + h - b) / 2) t =
          (1 + (h + b * (2 * t - 1))) / 2 := by unfold probabilitySegment; ring
      rw [he]
      have hd : ((1 + (h + b * (2 * t - 1))) / 2) *
          (1 - (1 + (h + b * (2 * t - 1))) / 2) =
          (1 - (h + b * (2 * t - 1)) ^ 2) / 4 := by ring
      rw [hd, div_div_eq_mul_div]
      ring
    _ = _ := by
      rw [intervalIntegral.integral_const_mul]
      have he := intervalIntegral.smul_integral_comp_mul_sub
        (fun x : ℝ => (1 - x) / (1 - (h + b * x) ^ 2)) (a := 0) (b := 1) 2 1
      convert! he using 1 <;> norm_num

private theorem spatial_interval_abs {h b x : ℝ} (hb : 0 < b) (hab : |h| + b < 1)
    (hx : x ∈ Set.uIcc (h - b) (h + b)) : |x| < 1 := by
  rw [Set.uIcc_of_le (by linarith)] at hx
  have hh' := neg_abs_le h
  rw [abs_lt]
  constructor <;> linarith [le_abs_self h, hx.1, hx.2]

/-- The antiderivative used in blueprint `lem:kformula`. -/
theorem hasDerivAt_kPrimitive {x : ℝ} (w : ℝ) (hx : |x| < 1) :
    HasDerivAt (fun x => w * artanh x + Real.log (1 - x ^ 2) / 2)
      ((w - x) / (1 - x ^ 2)) x := by
  have hxq : 1 - x ^ 2 ≠ 0 := by have := abs_lt.mp hx; nlinarith
  convert! ((hasDerivAt_artanh hx).const_mul w).add
    (((hasDerivAt_const x 1).sub ((hasDerivAt_id x).fun_pow 2)).log hxq |>.div_const 2) using 1
  simp only [Pi.sub_apply, id_eq]
  field_simp
  <;> ring

/-- Blueprint `lem:kformula`: evaluation of the transformed integral by the
fundamental theorem of calculus. -/
theorem integral_kPrimitive {h b : ℝ} (hb : 0 < b) (hab : |h| + b < 1) :
    (∫ x in (h - b)..(h + b), (h + b - x) / (1 - x ^ 2)) =
      (h + b) * L h b - J h b := by
  have hd : ∀ x ∈ Set.uIcc (h - b) (h + b),
      HasDerivAt (fun x => (h + b) * artanh x + Real.log (1 - x ^ 2) / 2)
        ((h + b - x) / (1 - x ^ 2)) x :=
    fun x hx => hasDerivAt_kPrimitive (h + b) (spatial_interval_abs hb hab hx)
  have hi : IntervalIntegrable (fun x => (h + b - x) / (1 - x ^ 2)) volume (h - b) (h + b) := by
    apply ContinuousOn.intervalIntegrable
    apply ContinuousOn.div (continuous_const.sub continuous_id).continuousOn
      (continuous_const.sub (continuous_id.pow 2)).continuousOn
    intro x hx
    change 1 - x ^ 2 ≠ 0
    have := abs_lt.mp (spatial_interval_abs hb hab hx)
    nlinarith
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hd hi]
  have h₁ : |h - b| < 1 := spatial_interval_abs hb hab (Set.left_mem_uIcc)
  have h₂ : |h + b| < 1 := spatial_interval_abs hb hab (Set.right_mem_uIcc)
  rw [← r_sq h₁.le, ← r_sq h₂.le, Real.log_pow, Real.log_pow]
  unfold L J
  rw [Real.log_div (r_pos h₁).ne' (r_pos h₂).ne']
  ring

/-- Blueprint `lem:kformula`, equation (kformulas), allowing either sign of the
first parameter for the symmetry step. -/
theorem k_eq_logarithms {h b : ℝ} (hb : 0 < b) (hab : |h| + b < 1) :
    k h b = ((h + b) * L h b - J h b) / b ^ 2 := by
  rw [k_eq_integral (by rwa [abs_of_pos hb]), ← integral_kPrimitive hb hab]
  have he := intervalIntegral.integral_comp_add_mul
    (fun x : ℝ => (h + b - x) / (1 - x ^ 2)) (a := -1) (b := 1) hb.ne' h
  simp only [mul_neg_one, mul_one, ← sub_eq_add_neg, smul_eq_mul] at he
  have hf : (∫ x in (-1 : ℝ)..1, (h + b - (h + b * x)) / (1 - (h + b * x) ^ 2)) =
      b * ∫ x in (-1 : ℝ)..1, (1 - x) / (1 - (h + b * x) ^ 2) := by
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro x hx
    dsimp only
    ring
  rw [hf] at he
  apply (eq_div_iff (pow_ne_zero 2 hb.ne')).mpr
  have he' := congrArg (b * ·) he
  field_simp at he'
  nlinarith [he']

/-- The even symmetry of `L` used in blueprint `lem:kformula`. -/
theorem L_neg_first (a b : ℝ) : L (-a) b = L a b := by
  unfold L
  rw [show -a + b = -(a - b) by ring, show -a - b = -(a + b) by ring,
    artanh_neg, artanh_neg]
  ring

/-- The odd symmetry of `J` used in blueprint `lem:kformula`. -/
theorem J_neg_first (a b : ℝ) : J (-a) b = -J a b := by
  unfold J
  rw [show -a + b = -(a - b) by ring, show -a - b = -(a + b) by ring,
    r_neg, r_neg, ← inv_div, Real.log_inv]

/-- Blueprint `lem:kformula`, both identities in (kformulas). -/
theorem k_logarithm_formulas {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    k a b = ((a + b) * L a b - J a b) / b ^ 2 ∧
    k (-a) b = ((b - a) * L a b + J a b) / b ^ 2 := by
  constructor
  · exact k_eq_logarithms hb (by rwa [abs_of_pos ha])
  · rw [k_eq_logarithms hb (by rwa [abs_neg, abs_of_pos ha]), L_neg_first, J_neg_first]
    ring

/-- Blueprint `lem:rawderivatives`, the formula for `B` in (Beexplicit). -/
theorem B_explicit {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    B a b (u / a) = L a b / b + u / b ^ 2 * (L a b - J a b / a) := by
  unfold B
  rw [(k_logarithm_formulas ha hb hab).1, (k_logarithm_formulas ha hb hab).2]
  field_simp
  <;> ring

/-- Blueprint `lem:rawderivatives`, the formula for `e` in (Beexplicit). -/
theorem e_explicit {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    e a b (u / a) = T a b + u * b / T a b := by
  unfold e
  rw [r_sub_eq_T_add ha.le hb.le hab, r_add_eq_T_sub ha.le hb.le hab]
  have hT := (spatial_quantities_pos ha.le hb.le hab).2.2.1.ne'
  field_simp
  <;> ring

/-- Blueprint `lem:rawderivatives`, the derivative of `L` in (LJder). -/
theorem hasDerivAt_L {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    HasDerivAt (fun a => L a b) (4 * a * b / S a b ^ 2) a := by
  have hr := spatial_abs_bounds ha.le hb.le hab
  have hd₁ := (hasDerivAt_artanh hr.2).comp a ((hasDerivAt_id a).add_const b)
  have hd₂ := (hasDerivAt_artanh hr.1).comp a ((hasDerivAt_id a).sub_const b)
  have hs₁ := r_sq hr.1.le
  have hs₂ := r_sq hr.2.le
  have hp := spatial_quantities_pos ha.le hb.le hab
  convert! hd₁.sub hd₂ using 1
  simp only [mul_one, S, mul_pow]
  rw [← hs₁, ← hs₂]
  have h₁ := hp.1.ne'
  have h₂ := hp.2.1.ne'
  field_simp
  nlinarith

/-- Blueprint `lem:rawderivatives`, the derivative of `J` in (LJder). -/
theorem hasDerivAt_J {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    HasDerivAt (fun a => J a b) (2 * b * (1 + a ^ 2 - b ^ 2) / S a b ^ 2) a := by
  have hr := spatial_abs_bounds ha.le hb.le hab
  have hp := spatial_quantities_pos ha.le hb.le hab
  have hd₁ := (hasDerivAt_r hr.1).comp a ((hasDerivAt_id a).sub_const b)
  have hd₂ := (hasDerivAt_r hr.2).comp a ((hasDerivAt_id a).add_const b)
  convert! ((hd₁.div hd₂ hp.2.1.ne').log (div_ne_zero hp.1.ne' hp.2.1.ne')) using 1
  simp only [mul_one, S, mul_pow, Function.comp_apply, Pi.div_apply, id_eq]
  have h₁ := hp.1.ne'
  have h₂ := hp.2.1.ne'
  field_simp
  rw [r_sq hr.1.le, r_sq hr.2.le]
  ring

/-- Blueprint `lem:rawderivatives`, equation (Tder). -/
theorem hasDerivAt_T {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    HasDerivAt (fun a => T a b) (-(a * (T a b ^ 2 + b ^ 2)) / (T a b * S a b)) a := by
  have hr := spatial_abs_bounds ha.le hb.le hab
  have hp := spatial_quantities_pos ha.le hb.le hab
  have hd₁ := (hasDerivAt_r hr.1).comp a ((hasDerivAt_id a).sub_const b)
  have hd₂ := (hasDerivAt_r hr.2).comp a ((hasDerivAt_id a).add_const b)
  convert! (hd₁.add hd₂).div_const 2 using 1
  simp only [mul_one, S]
  have h₁ := hp.1.ne'
  have h₂ := hp.2.1.ne'
  have hT := hp.2.2.1.ne'
  field_simp
  rw [r_sub_eq_T_add ha.le hb.le hab, r_add_eq_T_sub ha.le hb.le hab]
  field_simp
  <;> ring

/-- Blueprint `lem:rawderivatives`, equation (Braw): differentiation is at fixed
`b,u`, on the open spatial domain. -/
theorem hasDerivAt_B_fixed {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    HasDerivAt (fun a => B a b (u / a))
      (4 * a / S a b ^ 2 + u * (2 * (a ^ 2 + b ^ 2 - 1) / (a * b * S a b ^ 2) +
        J a b / (a ^ 2 * b ^ 2))) a := by
  have hdL := hasDerivAt_L ha hb hab
  have hdJ := hasDerivAt_J ha hb hab
  have hd := (hdL.div_const b).add
    ((hdL.sub (hdJ.div (hasDerivAt_id a) ha.ne')).const_mul (u / b ^ 2))
  have he : (fun a => B a b (u / a)) =ᶠ[nhds a]
      (fun a => L a b / b + u / b ^ 2 * (L a b - J a b / a)) := by
    filter_upwards [isOpen_Ioo.mem_nhds (show a ∈ Set.Ioo 0 (1 - b) by constructor <;> linarith)] with x hx
    exact B_explicit hx.1 hb (by linarith [hx.2]) u
  have hS := (spatial_quantities_pos ha.le hb.le hab).2.2.2.ne'
  have hd' := hd.congr_of_eventuallyEq he
  convert! hd' using 1
  simp only [id_eq]
  field_simp
  <;> ring

/-- Blueprint `def:MAE`: the normalized integral quantity `M`. -/
noncomputable def M (Z : ℝ) : ℝ := 1 + (1 - Z) / 2 * I Z

/-- Blueprint `def:MAE`: the normalized integral quantity `A`. -/
noncomputable def A (Z Y : ℝ) : ℝ := (1 - Z) * H Y

/-- Blueprint `def:MAE`: the normalized two-denominator integral quantity `E`. -/
noncomputable def E (Z Y : ℝ) : ℝ := (1 - Z) *
  ∫ t in (0 : ℝ)..1, (1 - t ^ 2) / ((1 - Z * t ^ 2) * (1 - Y * t ^ 2))

/-- Blueprint `lem:MAE`, the identity for `M` in (MEidentities). -/
theorem M_eq_H {Z : ℝ} (hZ : Z ∈ Set.Ioo 0 1) :
    M Z = (1 + Z - (1 - Z) ^ 2 * H Z) / (2 * Z) := by
  have he := mul_I_eq ⟨hZ.1.le, hZ.2⟩
  unfold M
  apply (eq_div_iff (mul_ne_zero (by norm_num) hZ.1.ne')).mpr
  nlinarith [congrArg ((1 - Z) * ·) he]

private theorem intervalIntegrable_EIntegrand {Z Y : ℝ}
    (hZ : Z ∈ Set.Ico 0 1) (hY : Y ∈ Set.Ico 0 1) :
    IntervalIntegrable (fun t => (1 - t ^ 2) / ((1 - Z * t ^ 2) * (1 - Y * t ^ 2))) volume 0 1 := by
  apply ContinuousOn.intervalIntegrable
  apply ContinuousOn.div
  · fun_prop
  · fun_prop
  · intro t ht
    exact mul_ne_zero (HI_denominator_pos hZ (by simpa using ht)).ne'
      (HI_denominator_pos hY (by simpa using ht)).ne'

/-- Blueprint `lem:MAE`, the identity for `E` in (MEidentities). -/
theorem E_eq_H {Z Y : ℝ} (hZ : 0 < Z) (hZY : Z < Y) (hY : Y < 1) :
    E Z Y = (1 - Z) * ((1 - Z) * H Z - (1 - Y) * H Y) / (Y - Z) := by
  have hz : Z ∈ Set.Ico 0 1 := ⟨hZ.le, hZY.trans hY⟩
  have hy : Y ∈ Set.Ico 0 1 := ⟨(hZ.trans hZY).le, hY⟩
  have he : (Y - Z) * ∫ t in (0 : ℝ)..1,
      (1 - t ^ 2) / ((1 - Z * t ^ 2) * (1 - Y * t ^ 2)) =
      (1 - Z) * H Z - (1 - Y) * H Y := by
    rw [← intervalIntegral.integral_const_mul]
    unfold H
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_sub ((intervalIntegrable_HIntegrand hz).const_mul (1 - Z))
        ((intervalIntegrable_HIntegrand hy).const_mul (1 - Y))]
    apply intervalIntegral.integral_congr
    intro t ht
    dsimp only
    have hdZ := (HI_denominator_pos hz (by simpa using ht)).ne'
    have hdY := (HI_denominator_pos hy (by simpa using ht)).ne'
    field_simp
    <;> ring
  unfold E
  apply (eq_div_iff (sub_pos.mpr hZY).ne').mpr
  rw [← he]
  ring

/-- Blueprint `lem:MAE`, the two bounds for `M` in (MEbounds). -/
theorem M_bounds {Z : ℝ} (hZ : Z ∈ Set.Ico 0 1) :
    1 + (1 - Z) / 3 ≤ M Z ∧ M Z ≤ 1 + (1 - Z) * (2 + Z) / 6 := by
  have hi := I_bounds hZ
  unfold M
  constructor <;> nlinarith [mul_nonneg (sub_pos.mpr hZ.2).le (sub_nonneg.mpr hi.1),
    mul_nonneg (sub_pos.mpr hZ.2).le (sub_nonneg.mpr hi.2)]

/-- The integral comparisons in the proof of blueprint `lem:MAE`. -/
theorem E_integrand_bounds {Z Y t : ℝ} (hZ : Z ∈ Set.Ico 0 1)
    (hY : Y ∈ Set.Ico 0 1) (ht : t ∈ Set.Icc 0 1) :
    (1 - Z) * (1 - t ^ 2) ≤
      (1 - Z) * ((1 - t ^ 2) / ((1 - Z * t ^ 2) * (1 - Y * t ^ 2))) ∧
    (1 - Z) * ((1 - t ^ 2) / ((1 - Z * t ^ 2) * (1 - Y * t ^ 2))) ≤
      (1 - t ^ 2) / (1 - Y * t ^ 2) := by
  have hdZ := HI_denominator_pos hZ ht
  have hdY := HI_denominator_pos hY ht
  have htq : 0 ≤ 1 - t ^ 2 := by nlinarith [ht.1, ht.2]
  have hzq := mul_nonneg hZ.1 (sq_nonneg t)
  have hyq := mul_nonneg hY.1 (sq_nonneg t)
  constructor
  · apply mul_le_mul_of_nonneg_left _ (sub_pos.mpr hZ.2).le
    apply (le_div_iff₀ (mul_pos hdZ hdY)).mpr
    have hprod : (1 - Z * t ^ 2) * (1 - Y * t ^ 2) ≤ 1 := by
      nlinarith [mul_nonneg hdZ.le hyq]
    nlinarith [mul_nonneg htq (sub_nonneg.mpr hprod)]
  · calc
      _ = ((1 - Z) / (1 - Z * t ^ 2)) * ((1 - t ^ 2) / (1 - Y * t ^ 2)) := by
        rw [div_mul_div_comm, mul_div_assoc]
      _ ≤ 1 * ((1 - t ^ 2) / (1 - Y * t ^ 2)) := by
        apply mul_le_mul_of_nonneg_right _ (div_nonneg htq hdY.le)
        apply (div_le_one hdZ).mpr
        nlinarith [mul_nonneg hZ.1 htq]
      _ = _ := one_mul _

/-- Blueprint `lem:MAE`, the two bounds for `E` in (MEbounds). -/
theorem E_bounds {Z Y : ℝ} (hZ : Z ∈ Set.Ico 0 1) (hY : Y ∈ Set.Ico 0 1) :
    2 * (1 - Z) / 3 ≤ E Z Y ∧ E Z Y ≤ (2 + Y) / 3 := by
  have hi := (intervalIntegrable_EIntegrand hZ hY).const_mul (1 - Z)
  have hib : IntervalIntegrable (fun t : ℝ => (1 - Z) * (1 - t ^ 2)) volume 0 1 := by
    apply Continuous.intervalIntegrable
    fun_prop
  have he : (∫ t in (0 : ℝ)..1, (1 - Z) * (1 - t ^ 2)) = 2 * (1 - Z) / 3 := by
    rw [intervalIntegral.integral_const_mul]
    have hbase : (∫ t in (0 : ℝ)..1, 1 - t ^ 2) = 2 / 3 := by
      simpa only [I, zero_mul, sub_zero, div_one] using I_zero
    rw [hbase]
    ring
  unfold E
  rw [← intervalIntegral.integral_const_mul]
  constructor
  · rw [← he]
    exact intervalIntegral.integral_mono_on (by norm_num) hib hi
      (fun t ht => (E_integrand_bounds hZ hY ht).1)
  · apply le_trans (intervalIntegral.integral_mono_on (by norm_num) hi
      (intervalIntegrable_IIntegrand hY) (fun t ht => (E_integrand_bounds hZ hY ht).2))
    exact (I_bounds hY).2

/-- Blueprint `def:vy`: product coordinate `z`. -/
noncomputable def zCoord (a b : ℝ) : ℝ := vCoord a b * yCoord a b

/-- Blueprint `def:vy`: squared product coordinate `Z`. -/
noncomputable def ZCoord (a b : ℝ) : ℝ := zCoord a b ^ 2

/-- Blueprint `def:vy`: squared second coordinate `Y`. -/
noncomputable def YCoord (a b : ℝ) : ℝ := yCoord a b ^ 2

/-- Blueprint `def:vy`: `P=1-Z`. -/
noncomputable def PCoord (a b : ℝ) : ℝ := 1 - ZCoord a b

/-- Blueprint `lem:Videntity`: the fixed-parameter coordinate `w=ub/T²`. -/
noncomputable def wCoord (a b u : ℝ) : ℝ := u * b / T a b ^ 2

/-- Blueprint `lem:Videntity`: the normalized root gap `Xi=C/T`. -/
noncomputable def Xi (a b u : ℝ) : ℝ := C a b (u / a) / T a b

/-- Blueprint `lem:Videntity`: the exact normalized derivative factor. -/
noncomputable def V (a b u : ℝ) : ℝ :=
  (1 - wCoord a b u * M (ZCoord a b)) * Xi a b u -
    (1 - wCoord a b u) * (A (ZCoord a b) (YCoord a b) -
      wCoord a b u * E (ZCoord a b) (YCoord a b))

/-- Blueprint `lem:Videntity`: `w=tz` with `t=u/a`. -/
theorem wCoord_eq {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    wCoord a b u = (u / a) * zCoord a b := by
  rw [wCoord, zCoord, coordinates_product ha.le hb.le hab]
  field_simp

/-- Blueprint `lem:Videntity`: the bound `|w| ≤ z < 1`. -/
theorem wCoord_bounds {a b u : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1)
    (hu : |u| ≤ a) : |wCoord a b u| ≤ zCoord a b ∧ zCoord a b < 1 := by
  have hc := coordinates_mem ha hb hab
  have hz := coordinate_ranges hc.1 hc.2
  constructor
  · rw [wCoord_eq ha hb hab, abs_mul, zCoord, abs_of_pos hz.1]
    have ht : |u / a| ≤ 1 := by rw [abs_div, abs_of_pos ha]; exact (div_le_one ha).mpr hu
    nlinarith [hz.1]
  · exact hz.2.1.trans hc.2.2

/-- Blueprint `lem:Videntity`: the explicit normalized root gap. -/
theorem Xi_explicit {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    Xi a b u = 1 + wCoord a b u + (1 - r (u - b)) / T a b := by
  unfold Xi C
  rw [e_explicit ha hb hab]
  have hT := (spatial_quantities_pos ha.le hb.le hab).2.2.1.ne'
  have he : u / a * a = u := by field_simp
  rw [he]
  unfold wCoord
  field_simp
  <;> ring

/-- Blueprint `lem:Videntity`: `Xi ≥ 1+w > 0`. -/
theorem Xi_bounds {a b u : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1)
    (hu : |u| ≤ a) : 1 + wCoord a b u ≤ Xi a b u ∧ 0 < 1 + wCoord a b u := by
  rw [Xi_explicit ha hb hab]
  have hp := (spatial_quantities_pos ha.le hb.le hab).2.2.1
  have hw := lt_of_le_of_lt (wCoord_bounds ha hb hab hu).1 (wCoord_bounds ha hb hab hu).2
  exact ⟨le_add_of_nonneg_right (div_nonneg (sub_nonneg.mpr (r_le_one _)) hp.le),
    by have := (abs_lt.mp hw).1; linarith⟩

/-- The logarithmic-to-integral substitution used in blueprint `lem:Videntity`. -/
theorem artanh_eq_mul_H {x : ℝ} (hx : x ∈ Set.Ioo 0 1) : artanh x = x * H (x ^ 2) := by
  have hxq : x ^ 2 ∈ Set.Ioo (0 : ℝ) 1 := ⟨sq_pos_of_pos hx.1, by nlinarith [hx.1, hx.2]⟩
  rw [H_eq_artanh hxq, Real.sqrt_sq hx.1.le]
  field_simp [hx.1.ne']

/-- Blueprint `lem:Videntity`: `L=2yH(Y)` and `J=2zH(Z)`. -/
theorem LJ_eq_H {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    L a b = 2 * yCoord a b * H (YCoord a b) ∧
    J a b = 2 * zCoord a b * H (ZCoord a b) := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  rw [L_eq_artanh_coordinate ha hb hab, J_eq_artanh_coordinate ha hb hab,
    artanh_eq_mul_H hc.2, artanh_eq_mul_H ⟨hr.1, hr.2.1.trans hc.2.2⟩]
  constructor <;> dsimp only [YCoord, ZCoord, zCoord] <;> ring

/-- Blueprint `lem:Videntity`, the normalized derivative of `B`. -/
theorem hasDerivAt_B_normalized {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    HasDerivAt (fun a => B a b (u / a))
      (4 * a / S a b ^ 2 * (1 - wCoord a b u * M (ZCoord a b))) a := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hZ : ZCoord a b ∈ Set.Ioo 0 1 := ⟨hr.2.2.2.1, hr.2.2.2.2.1.trans hr.2.2.2.2.2.1⟩
  have hT := (spatial_quantities_pos ha.le hb.le hab).2.2.1.ne'
  have hS := (spatial_quantities_pos ha.le hb.le hab).2.2.2.ne'
  convert! hasDerivAt_B_fixed ha hb hab u using 1
  rw [M_eq_H hZ, (LJ_eq_H ha hb hab).2]
  have he : a ^ 2 + b ^ 2 - 1 = -(T a b ^ 2 + a ^ 2 * b ^ 2 / T a b ^ 2) := by
    linarith [one_sub_sq_eq_T_sq_add ha.le hb.le hab]
  rw [he]
  change 4 * a / S a b ^ 2 *
      (1 - (u * b / T a b ^ 2) * ((1 + zCoord a b ^ 2 -
        (1 - zCoord a b ^ 2) ^ 2 * H (ZCoord a b)) / (2 * zCoord a b ^ 2))) = _
  have hz : zCoord a b = a * b / T a b ^ 2 := coordinates_product ha.le hb.le hab
  rw [hz]
  have hP : 1 - (a * b / T a b ^ 2) ^ 2 = S a b / T a b ^ 2 := by
    simpa only [coordinates_product ha.le hb.le hab] using coordinates_P ha.le hb.le hab
  rw [hP]
  field_simp
  <;> ring

/-- Blueprint `lem:Videntity`, the normalized derivative of `e`. -/
theorem hasDerivAt_e_fixed {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    HasDerivAt (fun a => e a b (u / a))
      (-(a * (T a b ^ 2 + b ^ 2)) / (T a b * S a b) * (1 - wCoord a b u)) a := by
  have hT := (spatial_quantities_pos ha.le hb.le hab).2.2.1.ne'
  have hdT := hasDerivAt_T ha hb hab
  have hd := hdT.add ((hasDerivAt_const a (u * b)).div hdT hT)
  have he : (fun a => e a b (u / a)) =ᶠ[nhds a] (fun a => T a b + u * b / T a b) := by
    filter_upwards [isOpen_Ioo.mem_nhds (show a ∈ Set.Ioo 0 (1 - b) by constructor <;> linarith)] with x hx
    exact e_explicit hx.1 hb (by linarith [hx.2]) u
  convert! hd.congr_of_eventuallyEq he using 1
  unfold wCoord
  ring

/-- The relation `by=(Y-Z)/P` used in blueprint `lem:Videntity`. -/
theorem coordinate_Y_sub_Z {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) :
    YCoord a b - ZCoord a b = b * yCoord a b * PCoord a b := by
  have hi := (coordinates_inverse ha hb hab).2
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have he := (eq_div_iff hr.2.2.2.2.2.2.2.2.ne').mp hi
  have hv : |vCoord a b| ≤ 1 := by rw [abs_of_pos hc.1.1]; exact hc.1.2.le
  rw [r_sq hv] at he
  unfold YCoord ZCoord zCoord PCoord
  dsimp only [ZCoord, zCoord]
  nlinarith [congrArg (yCoord a b * ·) he]

/-- Blueprint `lem:Videntity`, equation (Bnormalized). -/
theorem B_normalized {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    PCoord a b * (T a b ^ 2 + b ^ 2) / 2 * B a b (u / a) =
      A (ZCoord a b) (YCoord a b) - wCoord a b u * E (ZCoord a b) (YCoord a b) := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  rw [B_explicit ha hb hab, (LJ_eq_H ha hb hab).1, (LJ_eq_H ha hb hab).2,
    E_eq_H (Z := ZCoord a b) (Y := YCoord a b) hr.2.2.2.1 hr.2.2.2.2.1 hr.2.2.2.2.2.1, A]
  have hP : 1 - ZCoord a b = S a b / T a b ^ 2 := coordinates_P ha.le hb.le hab
  have hyq : 1 - YCoord a b = S a b / (T a b ^ 2 + b ^ 2) := by
    have hs := (coordinates_root_sq ha hb hab).2
    rw [r_sq (by rw [abs_of_pos hc.2.1]; exact hc.2.2.le)] at hs
    exact hs
  rw [coordinate_Y_sub_Z ha hb hab, hyq]
  change (1 - ZCoord a b) * (T a b ^ 2 + b ^ 2) / 2 * _ = _
  rw [hP]
  generalize H (YCoord a b) = HY
  generalize H (ZCoord a b) = HZ
  unfold wCoord yCoord zCoord PCoord
  rw [coordinates_product ha.le hb.le hab, hP]
  have hp := spatial_quantities_pos ha.le hb.le hab
  have hT := hp.2.2.1.ne'
  have hS := hp.2.2.2.ne'
  have hDb : T a b ^ 2 + b ^ 2 ≠ 0 :=
    (add_pos_of_pos_of_nonneg (sq_pos_of_pos hp.2.2.1) (sq_nonneg b)).ne'
  field_simp
  <;> ring

/-- Blueprint `lem:Videntity`: since `u-b` is fixed, `C` has the derivative of `e`. -/
theorem hasDerivAt_C_fixed {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    HasDerivAt (fun a => C a b (u / a))
      (-(a * (T a b ^ 2 + b ^ 2)) / (T a b * S a b) * (1 - wCoord a b u)) a := by
  have hd := (hasDerivAt_e_fixed ha hb hab u).const_add (1 - r (u - b))
  apply hd.congr_of_eventuallyEq
  filter_upwards [isOpen_Ioi.mem_nhds ha] with x hx
  unfold C
  have he : u / x * x = u := by field_simp [(show 0 < x from hx).ne']
  rw [he]

/-- Blueprint `lem:Videntity`, equation (Videntity): the exact derivative of `C²B`
with `b,u` fixed. -/
theorem hasDerivAt_C_sq_mul_B {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    HasDerivAt (fun a => C a b (u / a) ^ 2 * B a b (u / a))
      (4 * a * T a b * C a b (u / a) / S a b ^ 2 * V a b u) a := by
  have hd := ((hasDerivAt_C_fixed ha hb hab u).fun_pow 2).mul (hasDerivAt_B_normalized ha hb hab u)
  convert! hd using 1
  unfold V Xi
  rw [← B_normalized ha hb hab]
  have hP : PCoord a b = S a b / T a b ^ 2 := coordinates_P ha.le hb.le hab
  rw [hP]
  have hp := spatial_quantities_pos ha.le hb.le hab
  have hT := hp.2.2.1.ne'
  have hS := hp.2.2.2.ne'
  field_simp
  <;> ring

/-- Blueprint `def:Phi`: lower bound for `M`. -/
noncomputable def Mminus (Z : ℝ) : ℝ := 1 + (1 - Z) / 3

/-- Blueprint `def:Phi`: upper bound for `M`. -/
noncomputable def Mplus (Z : ℝ) : ℝ := 1 + (1 - Z) * (2 + Z) / 6

/-- Blueprint `def:Phi`: upper bound for `A`. -/
noncomputable def Astar (Z Y : ℝ) : ℝ :=
  (1 - Z) * ((7 + Y) / 15 + 8 / (15 * Real.sqrt (1 - Y)))

/-- Blueprint `def:Phi`, equation (Phiminus). -/
noncomputable def PhiMinus (a b u : ℝ) : ℝ :=
  (1 - wCoord a b u * Mminus (ZCoord a b)) * Xi a b u -
    (1 - wCoord a b u) * (Astar (ZCoord a b) (YCoord a b) -
      wCoord a b u * (2 + YCoord a b) / 3)

/-- Blueprint `def:Phi`, equation (Phiplus). -/
noncomputable def PhiPlus (a b u : ℝ) : ℝ :=
  (1 - wCoord a b u * Mplus (ZCoord a b)) * Xi a b u -
    (1 - wCoord a b u) * (Astar (ZCoord a b) (YCoord a b) -
      wCoord a b u * (2 * PCoord a b / 3))

/-- The upper bound on `A` used in blueprint `lem:Phi`. -/
theorem A_le_Astar {Z Y : ℝ} (hZ : Z < 1) (hY : Y ∈ Set.Ico 0 1) : A Z Y ≤ Astar Z Y :=
  mul_le_mul_of_nonneg_left (H_upper_bound hY) (sub_pos.mpr hZ).le

private theorem normalized_comparison_neg {w ξ m m₀ α α₀ ε ε₀ : ℝ}
    (hw : w ≤ 0) (hξ : 0 ≤ ξ) (hm : m₀ ≤ m) (hα : α ≤ α₀) (hε : ε ≤ ε₀) :
    (1 - w * m₀) * ξ - (1 - w) * (α₀ - w * ε₀) ≤
      (1 - w * m) * ξ - (1 - w) * (α - w * ε) := by
  have h₁ := mul_nonneg (mul_nonneg (neg_nonneg.mpr hw) hξ) (sub_nonneg.mpr hm)
  have h₂ := mul_nonneg (show 0 ≤ 1 - w by linarith) (sub_nonneg.mpr hα)
  have h₃ := mul_nonneg (mul_nonneg (neg_nonneg.mpr hw) (show 0 ≤ 1 - w by linarith))
    (sub_nonneg.mpr hε)
  nlinarith only [h₁, h₂, h₃]

private theorem normalized_comparison_pos {w ξ m m₀ α α₀ ε ε₀ : ℝ}
    (hw : 0 ≤ w) (hw₁ : w ≤ 1) (hξ : 0 ≤ ξ) (hm : m ≤ m₀) (hα : α ≤ α₀) (hε : ε₀ ≤ ε) :
    (1 - w * m₀) * ξ - (1 - w) * (α₀ - w * ε₀) ≤
      (1 - w * m) * ξ - (1 - w) * (α - w * ε) := by
  have h₁ := mul_nonneg (mul_nonneg hw hξ) (sub_nonneg.mpr hm)
  have h₂ := mul_nonneg (sub_nonneg.mpr hw₁) (sub_nonneg.mpr hα)
  have h₃ := mul_nonneg (mul_nonneg hw (sub_nonneg.mpr hw₁)) (sub_nonneg.mpr hε)
  nlinarith only [h₁, h₂, h₃]

/-- Blueprint `lem:Phi`: for `t=u/a ≤ 0`, `V ≥ PhiMinus`. -/
theorem PhiMinus_le_V {a b u : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1)
    (hu : |u| ≤ a) (ht : u / a ≤ 0) : PhiMinus a b u ≤ V a b u := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hz : ZCoord a b ∈ Set.Ico 0 1 := ⟨hr.2.2.2.1.le, hr.2.2.2.2.1.trans hr.2.2.2.2.2.1⟩
  have hy : YCoord a b ∈ Set.Ico 0 1 := ⟨sq_nonneg _, hr.2.2.2.2.2.1⟩
  have hw : wCoord a b u ≤ 0 := by
    rw [wCoord_eq ha hb hab]
    exact mul_nonpos_of_nonpos_of_nonneg ht hr.1.le
  have hXi := (Xi_bounds ha hb hab hu).2.trans_le (Xi_bounds ha hb hab hu).1
  have he := normalized_comparison_neg hw hXi.le (M_bounds hz).1
    (A_le_Astar hz.2 hy) (E_bounds hz hy).2
  simpa only [PhiMinus, V, Mminus, mul_div_assoc] using he

/-- Blueprint `lem:Phi`: for `t=u/a ≥ 0`, `V ≥ PhiPlus`. -/
theorem PhiPlus_le_V {a b u : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1)
    (hu : |u| ≤ a) (ht : 0 ≤ u / a) : PhiPlus a b u ≤ V a b u := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hz : ZCoord a b ∈ Set.Ico 0 1 := ⟨hr.2.2.2.1.le, hr.2.2.2.2.1.trans hr.2.2.2.2.2.1⟩
  have hy : YCoord a b ∈ Set.Ico 0 1 := ⟨sq_nonneg _, hr.2.2.2.2.2.1⟩
  have hw : 0 ≤ wCoord a b u := by
    rw [wCoord_eq ha hb hab]
    exact mul_nonneg ht hr.1.le
  have hw₁ := (le_abs_self (wCoord a b u)).trans
    ((wCoord_bounds ha hb hab hu).1.trans (wCoord_bounds ha hb hab hu).2.le)
  have hXi := (Xi_bounds ha hb hab hu).2.trans_le (Xi_bounds ha hb hab hu).1
  exact normalized_comparison_pos hw hw₁ hXi.le (M_bounds hz).2
    (A_le_Astar hz.2 hy) (E_bounds hz hy).1

/-- Blueprint `def:Psi`, equation (Psidef): the sharper lower bound. -/
noncomputable def Psi (a b u : ℝ) : ℝ :=
  (1 - wCoord a b u * Mplus (ZCoord a b)) * Xi a b u -
    PCoord a b * (1 - wCoord a b u) ^ 2 * (1 + ZCoord a b / 3) -
    (1 - wCoord a b u) * PCoord a b *
      (YCoord a b - ZCoord a b + wCoord a b u * (1 - YCoord a b)) *
      (1 / (2 * r (vCoord a b) * r (yCoord a b)) - 1 / 6)

/-- Blueprint `lem:Psi`, equation (Gamma): the coefficient of `H(Z)`. -/
noncomputable def Gamma (Z w ξ : ℝ) : ℝ :=
  (1 - Z) * (w * (1 - Z) * ξ / (2 * Z) - (1 - w) ^ 2)

/-- Blueprint `lem:Psi`, equation (Gamma): the quantitative positive lower bound. -/
theorem Gamma_lower_bound {Z w ξ : ℝ} (hZ : 1 / 3 < Z) (hZ₁ : Z < 1)
    (hw : Z ≤ w) (hw₁ : w ≤ 1) (hξ : 1 + w ≤ ξ) :
    (1 - Z) ^ 2 * (3 * Z - 1) / 2 ≤ Gamma Z w ξ ∧
      0 < (1 - Z) ^ 2 * (3 * Z - 1) / 2 := by
  have hz : 0 < Z := by linarith
  have hP : 0 < 1 - Z := by linarith
  have hmul : Z * (1 + Z) ≤ w * ξ :=
    mul_le_mul hw (by linarith) (by linarith) (by linarith)
  have hq : (1 + Z) / 2 ≤ w * ξ / (2 * Z) := by
    apply (le_div_iff₀ (by positivity)).mpr
    nlinarith
  have hs : (1 - w) ^ 2 ≤ (1 - Z) ^ 2 := by nlinarith
  constructor
  · unfold Gamma
    have he : w * (1 - Z) * ξ / (2 * Z) = (1 - Z) * (w * ξ / (2 * Z)) := by ring
    rw [he]
    have hh := mul_nonneg hP.le (sub_nonneg.mpr hq)
    have hh' := mul_nonneg hP.le (show 0 ≤ (1 - Z) * (w * ξ / (2 * Z)) -
        (1 - w) ^ 2 - (1 - Z) * (3 * Z - 1) / 2 by nlinarith only [hh, hs])
    nlinarith only [hh']
  · exact div_pos (mul_pos (sq_pos_of_pos hP) (by linarith)) (by norm_num)

/-- Blueprint `lem:Psi`, equation (AEsplit): separate the difference of `H`. -/
theorem A_sub_wE_split {Z Y : ℝ} (hZ : 0 < Z) (hZY : Z < Y) (hY : Y < 1) (w : ℝ) :
    A Z Y - w * E Z Y = (1 - Z) * (1 - w) * H Z +
      (1 - Z) * (1 + w * (1 - Y) / (Y - Z)) * (H Y - H Z) := by
  rw [A, E_eq_H hZ hZY hY]
  have hd := (sub_pos.mpr hZY).ne'
  field_simp
  <;> ring

/-- Blueprint `lem:Psi`, equation (Vsplit): collect the coefficient of `H(Z)`. -/
theorem normalized_V_split {Z Y : ℝ} (hZ : 0 < Z) (hZY : Z < Y) (hY : Y < 1) (w ξ : ℝ) :
    (1 - w * M Z) * ξ - (1 - w) * (A Z Y - w * E Z Y) =
      (1 - w - w * (1 - Z) / (2 * Z)) * ξ + Gamma Z w ξ * H Z -
        (1 - w) * (1 - Z) * (1 + w * (1 - Y) / (Y - Z)) * (H Y - H Z) := by
  rw [A_sub_wE_split hZ hZY hY, M_eq_H ⟨hZ, hZY.trans hY⟩]
  unfold Gamma
  field_simp
  <;> ring

/-- Blueprint `lem:Psi`, equation (Psicoefficient). -/
theorem Psi_coefficient {Z : ℝ} (hZ : 0 < Z) (w : ℝ) :
    1 - w - w * (1 - Z) / (2 * Z) +
      w * (1 - Z) ^ 2 / (2 * Z) * (1 + Z / 3) = 1 - w * Mplus Z := by
  unfold Mplus
  field_simp
  <;> ring

/-- The strengthened difference estimate used in blueprint `lem:Psi`. -/
theorem H_difference_coordinates {v y : ℝ} (hv : v ∈ Set.Ioo 0 1) (hy : y ∈ Set.Ioo 0 1) :
    H (y ^ 2) - H ((v * y) ^ 2) ≤
      (y ^ 2 - (v * y) ^ 2) * (1 / (2 * r v * r y) - 1 / 6) := by
  have hr := coordinate_ranges hv hy
  have hd := (H_difference_bounds hr.2.2.2.1 hr.2.2.2.2.1 hr.2.2.2.2.2.1).1.trans
    (H_difference_bounds hr.2.2.2.1 hr.2.2.2.2.1 hr.2.2.2.2.2.1).2
  apply hd.trans
  apply mul_le_mul_of_nonneg_left _ (sub_pos.mpr hr.2.2.2.2.1).le
  apply sub_le_sub_right
  have hrv := hr.2.2.2.2.2.2.1
  have hry := hr.2.2.2.2.2.2.2.1
  have hp : r v ≤ Real.sqrt (1 - (v * y) ^ 2) := by
    apply Real.sqrt_le_sqrt
    nlinarith [mul_nonneg (sq_nonneg v) (show 0 ≤ 1 - y ^ 2 by linarith [hr.2.2.2.2.2.1])]
  apply one_div_le_one_div_of_le (mul_pos (mul_pos (by norm_num) hrv) hry)
  change 2 * r v * r y ≤ 2 * Real.sqrt (1 - (v * y) ^ 2) * r y
  exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hp (by norm_num)) hry.le

private theorem normalized_Psi_comparison {Z Y w ξ Q : ℝ} (hZ : 1 / 3 < Z)
    (hZY : Z < Y) (hY : Y < 1) (hw : Z ≤ w) (hw₁ : w ≤ 1) (hξ : 1 + w ≤ ξ)
    (hΔ : H Y - H Z ≤ (Y - Z) * Q) :
    (1 - w * Mplus Z) * ξ - (1 - Z) * (1 - w) ^ 2 * (1 + Z / 3) -
        (1 - w) * (1 - Z) * (Y - Z + w * (1 - Y)) * Q ≤
      (1 - w * M Z) * ξ - (1 - w) * (A Z Y - w * E Z Y) := by
  have hz : 0 < Z := by linarith
  have hP : 0 < 1 - Z := by linarith
  have hGamma := (Gamma_lower_bound hZ (hZY.trans hY) hw hw₁ hξ).2.trans_le
    (Gamma_lower_bound hZ (hZY.trans hY) hw hw₁ hξ).1
  have hcoef : 0 ≤ (1 - w) * (1 - Z) * (1 + w * (1 - Y) / (Y - Z)) := by
    apply mul_nonneg (mul_nonneg (sub_nonneg.mpr hw₁) hP.le)
    have : 0 ≤ w * (1 - Y) / (Y - Z) := div_nonneg
      (mul_nonneg (by linarith) (by linarith)) (by linarith)
    linarith
  have h₁ := mul_le_mul_of_nonneg_left (H_lower_bound ⟨hz.le, hZY.trans hY⟩) hGamma.le
  have h₂ := mul_le_mul_of_nonneg_left hΔ hcoef
  have he : (1 - w * Mplus Z) * ξ - (1 - Z) * (1 - w) ^ 2 * (1 + Z / 3) -
      (1 - w) * (1 - Z) * (Y - Z + w * (1 - Y)) * Q =
      (1 - w - w * (1 - Z) / (2 * Z)) * ξ + Gamma Z w ξ * (1 + Z / 3) -
        (1 - w) * (1 - Z) * (1 + w * (1 - Y) / (Y - Z)) * ((Y - Z) * Q) := by
    unfold Gamma Mplus
    have hd := (sub_pos.mpr hZY).ne'
    field_simp
    <;> ring
  rw [he, normalized_V_split hz hZY hY]
  linarith only [h₁, h₂]

/-- Blueprint `lem:Psi`: in the region `v,y ≥ 4/5` and `z ≤ t ≤ 1`, the sharper
comparison satisfies `Psi ≤ V`. -/
theorem Psi_le_V {a b u : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1)
    (hu : |u| ≤ a) (hv : 4 / 5 ≤ vCoord a b) (hy : 4 / 5 ≤ yCoord a b)
    (ht : zCoord a b ≤ u / a) : Psi a b u ≤ V a b u := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hzlow : 16 / 25 ≤ zCoord a b := by
    have := mul_le_mul hv hy (by norm_num) hc.1.1.le
    norm_num at this
    exact this
  have hZlow : 256 / 625 ≤ ZCoord a b := by
    change 256 / 625 ≤ zCoord a b ^ 2
    nlinarith
  have hZw : ZCoord a b ≤ wCoord a b u := by
    rw [wCoord_eq ha hb hab]
    change zCoord a b ^ 2 ≤ (u / a) * zCoord a b
    nlinarith [mul_nonneg (sub_nonneg.mpr ht) hr.1.le]
  have hw₁ := (le_abs_self (wCoord a b u)).trans
    ((wCoord_bounds ha hb hab hu).1.trans (wCoord_bounds ha hb hab hu).2.le)
  exact normalized_Psi_comparison (by linarith : 1 / 3 < ZCoord a b)
    hr.2.2.2.2.1 hr.2.2.2.2.2.1 hZw hw₁ (Xi_bounds ha hb hab hu).1
    (H_difference_coordinates hc.1 hc.2)

/-- Blueprint `def:poly`: the real value of a monomial. -/
def monomialEval (e : Exponent) (x : ℝ × ℝ × ℝ) : ℝ :=
  x.1 ^ e.1 * x.2.1 ^ e.2.1 * x.2.2 ^ e.2.2

/-- Blueprint `def:poly`, equation (polyeval): finite-list real evaluation. -/
def polyEval : IntPolynomial → (ℝ × ℝ × ℝ) → ℝ
  | [], _ => 0
  | (e, c) :: p, x => (c : ℝ) * monomialEval e x + polyEval p x

theorem polySortMerge_perm (fuel : ℕ) (p q : IntPolynomial) :
    (polySortMerge fuel p q).Perm (p ++ q) := by
  induction fuel generalizing p q with
  | zero => exact List.Perm.refl _
  | succ fuel ih =>
      cases p with
      | nil => simp [polySortMerge]
      | cons t p =>
          cases q with
          | nil => simp [polySortMerge]
          | cons s q =>
              simp only [polySortMerge]
              split
              · exact (List.Perm.cons s (ih (t :: p) q)).trans List.perm_middle.symm
              · exact List.Perm.cons t (ih p (s :: q))

theorem polySort_perm (fuel : ℕ) (p : IntPolynomial) : (polySort fuel p).Perm p := by
  induction fuel generalizing p with
  | zero => exact List.Perm.refl _
  | succ fuel ih =>
      simp only [polySort]
      split
      · exact List.Perm.refl _
      · have h := (polySortMerge_perm
          ((polySort fuel (p.take (p.length / 2))).length +
            (polySort fuel (p.drop (p.length / 2))).length) _ _).trans
          ((ih (p.take (p.length / 2))).append (ih (p.drop (p.length / 2))))
        simpa only [List.take_append_drop] using h

/-- Blueprint `lem:polyops`: a sum of exponents multiplies monomial values. -/
theorem monomialEval_add (e f : Exponent) (x : ℝ × ℝ × ℝ) :
    monomialEval (e + f) x = monomialEval e x * monomialEval f x := by
  simp only [monomialEval, Prod.fst_add, Prod.snd_add, pow_add]
  ring

/-- Blueprint `lem:polyops`: insertion adds precisely the inserted monomial. -/
theorem polyEval_insert (t : Exponent × ℤ) (p : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyInsert t p) x = (t.2 : ℝ) * monomialEval t.1 x + polyEval p x := by
  induction p with
  | nil =>
      by_cases hc : t.2 = 0 <;> simp [polyInsert, polyEval, hc]
  | cons h p ih =>
      rcases t with ⟨e, c⟩
      rcases h with ⟨f, d⟩
      dsimp only at *
      by_cases hc : c = 0
      · simp [polyInsert, polyEval, hc]
      by_cases ho : exponentGreater e f
      · simp [polyInsert, polyEval, hc, ho]
      by_cases he : e = f
      · subst f
        by_cases hz : c + d = 0
        · have hz' : (c : ℝ) + (d : ℝ) = 0 := by exact_mod_cast hz
          simp only [polyInsert, hc, ho, ite_false, ite_true, hz, polyEval]
          linear_combination -(monomialEval e x) * hz'
        · simp [polyInsert, hc, ho, hz, polyEval, Int.cast_add]
          <;> ring
      · simp only [polyInsert, hc, ho, he, ite_false, polyEval, ih]
        ring

private theorem polyEval_foldInsert (p q : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (p.foldl (fun q t => polyInsert t q) q) x = polyEval q x + polyEval p x := by
  induction p generalizing q with
  | nil => simp [polyEval]
  | cons t p ih =>
      rw [List.foldl_cons, ih, polyEval_insert]
      rcases t with ⟨e, c⟩
      simp only [polyEval]
      ring

/-- Blueprint `lem:polyops`: normalization preserves real evaluation. -/
private theorem polyEval_perm {p q : IntPolynomial} (h : p.Perm q) (x : ℝ × ℝ × ℝ) :
    polyEval p x = polyEval q x := by
  induction h with
  | nil => rfl
  | cons t h ih => rcases t with ⟨e, c⟩; simp only [polyEval, ih]
  | swap t s p =>
      rcases t with ⟨e, c⟩
      rcases s with ⟨f, d⟩
      simp only [polyEval]
      ring
  | trans h₁ h₂ ih₁ ih₂ => exact ih₁.trans ih₂

private theorem polyEval_foldrInsert (p : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (p.foldr polyInsert []) x = polyEval p x := by
  induction p with
  | nil => rfl
  | cons t p ih =>
      rcases t with ⟨e, c⟩
      simp only [List.foldr_cons, polyEval_insert, ih, polyEval]

/-- Finite-sum concatenation in blueprint `lem:polyops`. -/
theorem polyEval_append (p q : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (p ++ q) x = polyEval p x + polyEval q x := by
  induction p with
  | nil => simp [polyEval]
  | cons t p ih => rcases t with ⟨e, c⟩; simp [polyEval, ih, add_assoc]

theorem polyEval_mergeAux (fuel : ℕ) (p q : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyMergeAux fuel p q) x = polyEval p x + polyEval q x := by
  induction fuel generalizing p q with
  | zero => exact polyEval_append p q x
  | succ fuel ih =>
      cases p with
      | nil => simp [polyMergeAux, polyEval]
      | cons t p =>
          cases q with
          | nil => simp [polyMergeAux, polyEval]
          | cons s q =>
              rcases t with ⟨e, c⟩
              rcases s with ⟨f, d⟩
              by_cases he : e = f
              · subst f
                by_cases hz : c + d = 0
                · have hz' : (c : ℝ) + (d : ℝ) = 0 := by exact_mod_cast hz
                  simp only [polyMergeAux, ite_true, hz, ih, polyEval]
                  linear_combination -(monomialEval e x) * hz'
                · simp only [polyMergeAux, ite_true, hz, ite_false, polyEval, ih, Int.cast_add]
                  ring
              · simp only [polyMergeAux, he, ite_false]
                split <;> simp only [polyEval, ih] <;> ring

theorem polyEval_merge (p q : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyMerge p q) x = polyEval p x + polyEval q x := polyEval_mergeAux _ _ _ _

theorem polyEval_normalizeAux (fuel : ℕ) (p : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyNormalizeAux fuel p) x = polyEval p x := by
  induction fuel generalizing p with
  | zero => exact polyEval_foldrInsert p x
  | succ fuel ih =>
      rw [polyNormalizeAux]
      split
      · exact polyEval_foldrInsert p x
      · rw [polyEval_merge, ih, ih, ← polyEval_append, List.take_append_drop]

/-- Blueprint `lem:polyops`: normalization preserves real evaluation. -/
theorem polyEval_normalize (p : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyNormalize p) x = polyEval p x := polyEval_normalizeAux _ _ _

/-- Blueprint `lem:polyops`: soundness of polynomial addition. -/
theorem polyEval_add (p q : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyAdd p q) x = polyEval p x + polyEval q x := by
  rw [polyAdd, polyEval_normalize, polyEval_append]

/-- Blueprint `lem:polyops`: soundness of coefficient negation. -/
theorem polyEval_neg (p : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyNeg p) x = -polyEval p x := by
  induction p with
  | nil => simp [polyNeg, polyEval]
  | cons t p ih =>
      rcases t with ⟨e, c⟩
      simp only [polyNeg, List.map_cons, polyEval, Int.cast_neg] at *
      rw [ih]
      ring

private theorem polyEval_map_mul_term (t : Exponent × ℤ) (q : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (q.map (fun s => (t.1 + s.1, t.2 * s.2))) x =
      (t.2 : ℝ) * monomialEval t.1 x * polyEval q x := by
  induction q with
  | nil => simp [polyEval]
  | cons s q ih =>
      rcases s with ⟨f, d⟩
      simp only [List.map_cons, polyEval, Int.cast_mul, monomialEval_add, ih]
      ring

theorem polyEval_mulRows (p q : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyMulRows p q) x = polyEval p x * polyEval q x := by
  unfold polyMulRows
  induction p with
  | nil => simp [polyEval]
  | cons t p ih =>
      rcases t with ⟨e, c⟩
      rw [List.foldr_cons, polyEval_merge, polyEval_map_mul_term, ih]
      simp only [polyEval]
      ring

/-- Blueprint `lem:polyops`, equation (polymul): soundness of polynomial multiplication. -/
theorem polyEval_mul (p q : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyMul p q) x = polyEval p x * polyEval q x := by
  rw [polyMul, polyEval_mulRows, polyEval_normalize, polyEval_normalize]

/-- Blueprint `lem:polyops`: evaluation of an integer constant. -/
theorem polyEval_const (c : ℤ) (x : ℝ × ℝ × ℝ) : polyEval (polyConst c) x = (c : ℝ) := by
  by_cases hc : c = 0 <;> simp [polyConst, hc, polyEval, monomialEval]

/-- Blueprint `lem:polyops`: soundness of natural-number powers. -/
theorem polyEval_pow (p : IntPolynomial) (n : ℕ) (x : ℝ × ℝ × ℝ) :
    polyEval (polyPow p n) x = polyEval p x ^ n := by
  induction n with
  | zero => simp [polyPow, polyEval_const]
  | succ n ih => rw [polyPow, polyEval_mul, ih, pow_succ]

/-- Blueprint `lem:polyops`: soundness of integer scaling. -/
theorem polyEval_scale (c : ℤ) (p : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (polyScale c p) x = (c : ℝ) * polyEval p x := by
  unfold polyScale
  rw [polyEval_normalize]
  induction p with
  | nil => simp [polyEval]
  | cons t p ih =>
      rcases t with ⟨e, d⟩
      simp only [List.map_cons, polyEval, Int.cast_mul, ih]
      ring

/-- Blueprint `def:poly`: coordinatewise exponent bounds. -/
def polyBound (p : IntPolynomial) (n : Exponent) : Prop := ∀ t ∈ p, t.1 ≤ n

private theorem polyBound_cons (t : Exponent × ℤ) (p : IntPolynomial) (n : Exponent) :
    polyBound (t :: p) n ↔ t.1 ≤ n ∧ polyBound p n := by
  simp [polyBound]

private theorem polyBound_mono {p : IntPolynomial} {m n : Exponent}
    (hp : polyBound p m) (hmn : m ≤ n) : polyBound p n :=
  fun t ht => (hp t ht).trans hmn

/-- Blueprint `lem:polyops`: the computed coordinate degree bounds every exponent. -/
theorem polyBound_degree (p : IntPolynomial) : polyBound p (polyDegree p) := by
  induction p with
  | nil => simp [polyBound]
  | cons t p ih =>
      apply (polyBound_cons _ _ _).mpr
      exact ⟨le_sup_left, polyBound_mono ih le_sup_right⟩

/-- Blueprint `lem:polyops`: insertion cannot increase a verified exponent bound. -/
theorem polyBound_insert {t : Exponent × ℤ} {p : IntPolynomial} {n : Exponent}
    (ht : t.1 ≤ n) (hp : polyBound p n) : polyBound (polyInsert t p) n := by
  induction p with
  | nil =>
      simp only [polyInsert]
      split_ifs <;> simp_all [polyBound]
  | cons h p ih =>
      have hh := ((polyBound_cons h p n).mp hp).1
      have htail := ((polyBound_cons h p n).mp hp).2
      simp only [polyInsert]
      split_ifs with hc ho he hz
      · exact hp
      · exact (polyBound_cons _ _ _).mpr ⟨ht, hp⟩
      · exact htail
      · exact (polyBound_cons _ _ _).mpr ⟨ht, htail⟩
      · exact (polyBound_cons _ _ _).mpr ⟨hh, ih htail⟩

private theorem polyBound_foldInsert {p q : IntPolynomial} {n : Exponent}
    (hp : polyBound p n) (hq : polyBound q n) :
    polyBound (p.foldl (fun q t => polyInsert t q) q) n := by
  induction p generalizing q with
  | nil => exact hq
  | cons t p ih =>
      have ht := (polyBound_cons t p n).mp hp
      exact ih ht.2 (polyBound_insert ht.1 hq)

/-- Merging polynomial rows preserves their common exponent bound. -/
theorem polyBound_mergeAux (fuel : ℕ) {p q : IntPolynomial} {n : Exponent}
    (hp : polyBound p n) (hq : polyBound q n) : polyBound (polyMergeAux fuel p q) n := by
  induction fuel generalizing p q with
  | zero =>
      intro t ht
      exact (List.mem_append.mp ht).elim (hp t) (hq t)
  | succ fuel ih =>
      cases p with
      | nil => exact hq
      | cons t p =>
          cases q with
          | nil => exact hp
          | cons s q =>
              rcases t with ⟨e, c⟩
              rcases s with ⟨f, d⟩
              have ht := (polyBound_cons _ _ _).mp hp
              have hs := (polyBound_cons _ _ _).mp hq
              simp only [polyMergeAux]
              split_ifs
              · exact ih ht.2 hs.2
              · exact (polyBound_cons _ _ _).mpr ⟨ht.1, ih ht.2 hs.2⟩
              · exact (polyBound_cons _ _ _).mpr ⟨ht.1, ih ht.2 hq⟩
              · exact (polyBound_cons _ _ _).mpr ⟨hs.1, ih hp hs.2⟩

private theorem polyBound_foldrInsert {p : IntPolynomial} {n : Exponent}
    (hp : polyBound p n) : polyBound (p.foldr polyInsert []) n := by
  induction p with
  | nil => simp [polyBound]
  | cons t p ih =>
      have ht := (polyBound_cons t p n).mp hp
      exact polyBound_insert ht.1 (ih ht.2)

theorem polyBound_normalizeAux (fuel : ℕ) {p : IntPolynomial} {n : Exponent}
    (hp : polyBound p n) : polyBound (polyNormalizeAux fuel p) n := by
  induction fuel generalizing p with
  | zero => exact polyBound_foldrInsert hp
  | succ fuel ih =>
      rw [polyNormalizeAux]
      split
      · exact polyBound_foldrInsert hp
      · apply polyBound_mergeAux
        · apply ih
          intro t ht
          exact hp t (List.mem_of_mem_take ht)
        · apply ih
          intro t ht
          exact hp t (List.mem_of_mem_drop ht)

/-- Blueprint `lem:polyops`: normalization retains the input exponent bound. -/
theorem polyBound_normalize {p : IntPolynomial} {n : Exponent} (hp : polyBound p n) :
    polyBound (polyNormalize p) n := polyBound_normalizeAux _ hp

/-- Blueprint `lem:polyops`: sums are bounded by the coordinatewise maximum. -/
theorem polyBound_add (p q : IntPolynomial) :
    polyBound (polyAdd p q) (polyDegree p ⊔ polyDegree q) := by
  apply polyBound_normalize
  intro t ht
  rcases List.mem_append.mp ht with ht | ht
  · exact (polyBound_degree p t ht).trans le_sup_left
  · exact (polyBound_degree q t ht).trans le_sup_right

theorem polyBound_mulRows {p q : IntPolynomial} {m n : Exponent}
    (hp : polyBound p m) (hq : polyBound q n) : polyBound (polyMulRows p q) (m + n) := by
  induction p with
  | nil => simp [polyMulRows, polyBound]
  | cons t p ih =>
      have ht := (polyBound_cons _ _ _).mp hp
      apply polyBound_mergeAux
      · intro s hs
        rcases List.mem_map.mp hs with ⟨u, hu, rfl⟩
        have hu' := hq u hu
        exact ⟨Nat.add_le_add ht.1.1 hu'.1, Nat.add_le_add ht.1.2.1 hu'.2.1,
          Nat.add_le_add ht.1.2.2 hu'.2.2⟩
      · exact ih ht.2

/-- Blueprint `lem:polyops`: product exponents are bounded by the coordinatewise
sum of the two input degrees. -/
theorem polyBound_mul (p q : IntPolynomial) :
    polyBound (polyMul p q) (polyDegree p + polyDegree q) := by
  exact polyBound_mulRows (polyBound_normalize (polyBound_degree p))
    (polyBound_normalize (polyBound_degree q))

/-- Blueprint `lem:polyops`: equal normalized lists have equal real evaluations. -/
theorem polyEval_of_normalize_eq {p q : IntPolynomial} (h : polyNormalize p = polyNormalize q)
    (x : ℝ × ℝ × ℝ) : polyEval p x = polyEval q x := by
  rw [← polyEval_normalize p x, ← polyEval_normalize q x, h]

/-- Blueprint `def:poly`: the three variable polynomials evaluate to their coordinates. -/
theorem polyEval_variables (x : ℝ × ℝ × ℝ) :
    polyEval polyJ x = x.1 ∧ polyEval polyK x = x.2.1 ∧ polyEval polyTau x = x.2.2 := by
  simp [polyJ, polyK, polyTau, polyEval, monomialEval]

/-- Blueprint `lem:division`, equation (division-sound): a successful reconstruction
check certifies the real product identity at every point. -/
theorem polyDivisionCheck_sound {p q h : IntPolynomial} (hc : polyDivisionCheck p q h = true)
    (x : ℝ × ℝ × ℝ) : polyEval p x = polyEval q x * polyEval h x := by
  have he : polyMul q h = polyNormalize p := of_decide_eq_true hc
  have he' := congrArg (fun p => polyEval p x) he
  rwa [polyEval_mul, polyEval_normalize, eq_comm] at he'

/-- Blueprint `lem:division`: positive divisors preserve and reflect the signs
of the checked numerator and quotient. -/
theorem polyDivisionCheck_sign {p q h : IntPolynomial} (hc : polyDivisionCheck p q h = true)
    (x : ℝ × ℝ × ℝ) (hq : 0 < polyEval q x) :
    (0 < polyEval p x ↔ 0 < polyEval h x) ∧
    (0 ≤ polyEval p x ↔ 0 ≤ polyEval h x) ∧
    (polyEval p x = 0 ↔ polyEval h x = 0) ∧
    (polyEval p x < 0 ↔ polyEval h x < 0) := by
  rw [polyDivisionCheck_sound hc x]
  exact ⟨mul_pos_iff_of_pos_left hq, mul_nonneg_iff_of_pos_left hq,
    mul_eq_zero_iff_left hq.ne', by
      simpa only [not_le] using not_congr (mul_nonneg_iff_of_pos_left hq (b := polyEval h x))⟩

/-- Blueprint `def:rational`, equation (rational-eval). -/
noncomputable def rationalEval (p : RationalPolynomial) (x : ℝ × ℝ × ℝ) : ℝ :=
  polyEval p.numerator x / ((p.denominator : ℝ) * (1 + x.1 ^ 2) ^ p.a * (1 + x.2.1 ^ 2) ^ p.b)

/-- Blueprint `lem:rational`: every represented denominator is positive. -/
theorem rational_denominator_pos (p : RationalPolynomial) (x : ℝ × ℝ × ℝ) :
    0 < (p.denominator : ℝ) * (1 + x.1 ^ 2) ^ p.a * (1 + x.2.1 ^ 2) ^ p.b := by
  have hd : 0 < (p.denominator : ℝ) := by exact_mod_cast p.denominator_pos
  positivity

/-- Blueprint `lem:rational`: embedding a polynomial preserves evaluation. -/
theorem rationalEval_ofPolynomial (p : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    rationalEval (rationalOfPolynomial p) x = polyEval p x := by
  simp [rationalEval, rationalOfPolynomial]

/-- Blueprint `lem:rational`: rational negation preserves meaning. -/
theorem rationalEval_neg (p : RationalPolynomial) (x : ℝ × ℝ × ℝ) :
    rationalEval (rationalNeg p) x = -rationalEval p x := by
  simp only [rationalEval, rationalNeg, polyEval_neg, neg_div]

/-- Blueprint `lem:rational`: rational multiplication preserves meaning. -/
theorem rationalEval_mul (p q : RationalPolynomial) (x : ℝ × ℝ × ℝ) :
    rationalEval (rationalMul p q) x = rationalEval p x * rationalEval q x := by
  simp only [rationalEval, rationalMul, polyEval_mul, Nat.cast_mul, pow_add]
  rw [div_mul_div_comm]
  congr 1
  ring

/-- Blueprint `lem:rational`: division by a positive integer preserves meaning. -/
theorem rationalEval_divNat (p : RationalPolynomial) (n : ℕ) (hn : 0 < n) (x : ℝ × ℝ × ℝ) :
    rationalEval (rationalDivNat p n hn) x = rationalEval p x / (n : ℝ) := by
  simp only [rationalEval, rationalDivNat, Nat.cast_mul]
  rw [div_div]
  congr 1
  ring

/-- Blueprint `lem:rational`: powers preserve meaning. -/
theorem rationalEval_pow (p : RationalPolynomial) (n : ℕ) (x : ℝ × ℝ × ℝ) :
    rationalEval (rationalPow p n) x = rationalEval p x ^ n := by
  induction n with
  | zero => simp [rationalPow, rationalEval_ofPolynomial, polyEval_const]
  | succ n ih => rw [rationalPow, rationalEval_mul, ih, pow_succ]

/-- Evaluations of the positive base polynomials in blueprint `def:rational`. -/
theorem polyEval_bases (x : ℝ × ℝ × ℝ) :
    polyEval polyA0 x = 1 + x.1 ^ 2 ∧ polyEval polyB0 x = 1 + x.2.1 ^ 2 := by
  simp [polyA0, polyB0, polyEval_add, polyEval_const, polyEval_pow, (polyEval_variables x).1,
    (polyEval_variables x).2.1]

private theorem rational_common_denominator {d e A B : ℝ} (hd : d ≠ 0) (he : e ≠ 0)
    (hA : A ≠ 0) (hB : B ≠ 0) (p : ℝ) {a b m n : ℕ} (ha : a ≤ m) (hb : b ≤ n) :
    (e * p * A ^ (m - a) * B ^ (n - b)) / (d * e * A ^ m * B ^ n) = p / (d * A ^ a * B ^ b) := by
  have hma : m = (m - a) + a := (Nat.sub_add_cancel ha).symm
  have hnb : n = (n - b) + b := (Nat.sub_add_cancel hb).symm
  conv_lhs => rhs; rw [hma, hnb, pow_add, pow_add]
  field_simp
  <;> ring

/-- Blueprint `lem:rational`: the prescribed common-denominator addition preserves meaning. -/
theorem rationalEval_add (p q : RationalPolynomial) (x : ℝ × ℝ × ℝ) :
    rationalEval (rationalAdd p q) x = rationalEval p x + rationalEval q x := by
  simp only [rationalEval, rationalAdd, polyEval_add, polyEval_mul, polyEval_scale, polyEval_pow,
    (polyEval_bases x).1, (polyEval_bases x).2, Nat.cast_mul, Int.cast_natCast, add_div]
  have hd : (p.denominator : ℝ) ≠ 0 := by exact_mod_cast p.denominator_pos.ne'
  have he : (q.denominator : ℝ) ≠ 0 := by exact_mod_cast q.denominator_pos.ne'
  have hA : 1 + x.1 ^ 2 ≠ 0 := by positivity
  have hB : 1 + x.2.1 ^ 2 ≠ 0 := by positivity
  rw [rational_common_denominator hd he hA hB _ (Nat.le_max_left _ _) (Nat.le_max_left _ _)]
  rw [mul_comm (p.denominator : ℝ) (q.denominator : ℝ)]
  rw [rational_common_denominator he hd hA hB _ (Nat.le_max_right _ _) (Nat.le_max_right _ _)]

/-- Blueprint `lem:rational`: a successful denominator-conversion check preserves
the represented real rational expression. -/
theorem rationalConversionCheck_sound (p : RationalPolynomial) (F : IntPolynomial)
    (d a b : ℕ) (hd : 0 < d) (hc : rationalConversionCheck p F d a b = true)
    (x : ℝ × ℝ × ℝ) :
    polyEval F x / ((d : ℝ) * (1 + x.1 ^ 2) ^ a * (1 + x.2.1 ^ 2) ^ b) = rationalEval p x := by
  have he := congrArg (fun q => polyEval q x) (of_decide_eq_true hc)
  simp only [polyEval_mul, polyEval_scale, polyEval_pow, (polyEval_bases x).1,
    (polyEval_bases x).2, Int.cast_natCast] at he
  have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  have hp : (p.denominator : ℝ) ≠ 0 := by exact_mod_cast p.denominator_pos.ne'
  have hA : 1 + x.1 ^ 2 ≠ 0 := by positivity
  have hB : 1 + x.2.1 ^ 2 ≠ 0 := by positivity
  unfold rationalEval
  rw [← rational_common_denominator hd' hp hA hB _ (Nat.le_max_right p.a a) (Nat.le_max_right p.b b),
    ← rational_common_denominator hp hd' hA hB _ (Nat.le_max_left p.a a) (Nat.le_max_left p.b b)]
  rw [he, mul_comm (d : ℝ) (p.denominator : ℝ)]

/-- Blueprint `lem:bernstein`: the one-variable monomial expansion obtained from
the binomial theorem, with the lower index restriction explicit. -/
theorem monomial_bernstein_expansion (x : ℝ) {a n : ℕ} (ha : a ≤ n) :
    x ^ a = ∑ k ∈ Finset.range (n + 1),
      (if a ≤ k then ((n - a).choose (k - a) : ℝ) else 0) * x ^ k * (1 - x) ^ (n - k) := by
  have hn : n + 1 = a + (n - a + 1) := by omega
  rw [hn, Finset.sum_range_add]
  have hzero : (∑ k ∈ Finset.range a,
      (if a ≤ k then ((n - a).choose (k - a) : ℝ) else 0) * x ^ k * (1 - x) ^ (n - k)) = 0 := by
    apply Finset.sum_eq_zero
    intro k hk
    simp [show ¬a ≤ k by have := Finset.mem_range.mp hk; omega]
  rw [hzero, zero_add]
  simp only [Nat.le_add_right, ite_true, Nat.add_sub_cancel_left, Nat.sub_add_eq, pow_add]
  have he := add_pow x (1 - x) (n - a)
  have he' := congrArg (x ^ a * ·) he
  simp only [add_sub_cancel, one_pow, mul_one, Finset.mul_sum] at he'
  conv_lhs => rw [he']
  apply Finset.sum_congr rfl
  intro k hk
  ring

/-- Membership in the finite exponent box means precisely the coordinate bound. -/
theorem mem_exponentBox (e n : Exponent) : e ∈ exponentBox n ↔ e ≤ n := by
  simp [exponentBox, Nat.lt_succ_iff, Prod.le_def]

/-- Blueprint `def:bernstein`: the three binomial factors, zero unless the input
exponent is coordinatewise at most the output index. -/
def bernsteinWeight (n e β : Exponent) : ℤ :=
  if e ≤ β then ((n.1 - e.1).choose (β.1 - e.1) : ℤ) *
    ((n.2.1 - e.2.1).choose (β.2.1 - e.2.1) : ℤ) *
    ((n.2.2 - e.2.2).choose (β.2.2 - e.2.2) : ℤ) else 0

/-- Blueprint `def:bernstein`, equation (bernstein-coeff): sum the integer
contributions of the input monomials, including repeated exponents. -/
def bernsteinCoefficient : IntPolynomial → Exponent → Exponent → ℤ
  | [], _, _ => 0
  | (e, c) :: p, n, β => c * bernsteinWeight n e β + bernsteinCoefficient p n β

/-- Blueprint `lem:bernstein`: the basis product without binomial normalization. -/
def bernsteinBasis (n β : Exponent) (x : ℝ × ℝ × ℝ) : ℝ :=
  (x.1 ^ β.1 * (1 - x.1) ^ (n.1 - β.1)) *
    (x.2.1 ^ β.2.1 * (1 - x.2.1) ^ (n.2.1 - β.2.1)) *
    (x.2.2 ^ β.2.2 * (1 - x.2.2) ^ (n.2.2 - β.2.2))

/-- Blueprint `lem:bernstein`: the three-coordinate expansion of a monomial. -/
theorem monomial_bernstein_expansion_three (x : ℝ × ℝ × ℝ) {e n : Exponent} (he : e ≤ n) :
    monomialEval e x = ∑ β ∈ exponentBox n, (bernsteinWeight n e β : ℝ) * bernsteinBasis n β x := by
  unfold monomialEval
  rw [monomial_bernstein_expansion x.1 he.1, monomial_bernstein_expansion x.2.1 he.2.1,
    monomial_bernstein_expansion x.2.2 he.2.2]
  simp only [exponentBox, Finset.sum_product, Finset.sum_mul, Finset.mul_sum]
  conv_lhs =>
    rw [Finset.sum_comm]
    arg 2
    ext j
    rw [Finset.sum_comm]
  conv_lhs => rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  apply Finset.sum_congr rfl
  intro k hk
  by_cases h₁ : e.1 ≤ i <;> by_cases h₂ : e.2.1 ≤ j <;> by_cases h₃ : e.2.2 ≤ k <;>
    simp [bernsteinWeight, bernsteinBasis, Prod.le_def, h₁, h₂, h₃, Int.cast_mul] <;> ring

/-- Blueprint `lem:bernstein`, equation (bernstein-id): the exact integer
Bernstein expansion for every polynomial with verified coordinate degrees. -/
theorem polyEval_bernstein {p : IntPolynomial} {n : Exponent} (hp : polyBound p n)
    (x : ℝ × ℝ × ℝ) :
    polyEval p x = ∑ β ∈ exponentBox n, (bernsteinCoefficient p n β : ℝ) * bernsteinBasis n β x := by
  induction p with
  | nil => simp [polyEval, bernsteinCoefficient]
  | cons t p ih =>
      rcases t with ⟨e, c⟩
      have ht := (polyBound_cons (e, c) p n).mp hp
      simp only [polyEval, bernsteinCoefficient, Int.cast_add, Int.cast_mul, add_mul, Finset.sum_add_distrib]
      rw [ih ht.2]
      congr 1
      rw [monomial_bernstein_expansion_three x ht.1, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro β hβ
      ring

/-- Blueprint `lem:bernstein`: all basis products are nonnegative on the closed cube. -/
theorem bernsteinBasis_nonneg (n β : Exponent) {x : ℝ × ℝ × ℝ}
    (hx : x.1 ∈ Set.Icc 0 1 ∧ x.2.1 ∈ Set.Icc 0 1 ∧ x.2.2 ∈ Set.Icc 0 1) :
    0 ≤ bernsteinBasis n β x := by
  unfold bernsteinBasis
  exact mul_nonneg (mul_nonneg
    (mul_nonneg (pow_nonneg hx.1.1 _) (pow_nonneg (sub_nonneg.mpr hx.1.2) _))
    (mul_nonneg (pow_nonneg hx.2.1.1 _) (pow_nonneg (sub_nonneg.mpr hx.2.1.2) _)))
    (mul_nonneg (pow_nonneg hx.2.2.1 _) (pow_nonneg (sub_nonneg.mpr hx.2.2.2) _))

/-- Blueprint `lem:bernstein`: nonnegative integer coefficients imply nonnegativity
on the closed cube, including all coordinate faces. -/
theorem polyEval_nonneg_of_bernstein {p : IntPolynomial} {n : Exponent} (hp : polyBound p n)
    (hc : ∀ β ∈ exponentBox n, 0 ≤ bernsteinCoefficient p n β) {x : ℝ × ℝ × ℝ}
    (hx : x.1 ∈ Set.Icc 0 1 ∧ x.2.1 ∈ Set.Icc 0 1 ∧ x.2.2 ∈ Set.Icc 0 1) : 0 ≤ polyEval p x := by
  rw [polyEval_bernstein hp x]
  apply Finset.sum_nonneg
  intro β hβ
  exact mul_nonneg (by exact_mod_cast hc β hβ) (bernsteinBasis_nonneg n β hx)

/-- Blueprint `lem:bernstein`: one positive summand certifies strict positivity,
while all other Bernstein summands are nonnegative. -/
theorem polyEval_pos_of_bernstein {p : IntPolynomial} {n : Exponent} (hp : polyBound p n)
    (hc : ∀ β ∈ exponentBox n, 0 ≤ bernsteinCoefficient p n β) {x : ℝ × ℝ × ℝ}
    (hx : x.1 ∈ Set.Icc 0 1 ∧ x.2.1 ∈ Set.Icc 0 1 ∧ x.2.2 ∈ Set.Icc 0 1)
    (β : Exponent) (hβ : β ∈ exponentBox n) (hbc : 0 < bernsteinCoefficient p n β)
    (hbx : 0 < bernsteinBasis n β x) : 0 < polyEval p x := by
  rw [polyEval_bernstein hp x]
  apply Finset.sum_pos'
  · intro γ hγ
    exact mul_nonneg (by exact_mod_cast hc γ hγ) (bernsteinBasis_nonneg n γ hx)
  · exact ⟨β, hβ, mul_pos (by exact_mod_cast hbc) hbx⟩

/-- Blueprint `def:bernstein`, equation (bernstein-coeff): the list computation
equals the prescribed sum over the coefficient box. -/
theorem bernsteinCoefficient_eq_box (p : IntPolynomial) (n β : Exponent) :
    bernsteinCoefficient p n β = ∑ α ∈ exponentBox β, polyCoefficient p α *
      ((n.1 - α.1).choose (β.1 - α.1) : ℤ) *
      ((n.2.1 - α.2.1).choose (β.2.1 - α.2.1) : ℤ) *
      ((n.2.2 - α.2.2).choose (β.2.2 - α.2.2) : ℤ) := by
  induction p with
  | nil => simp [bernsteinCoefficient, polyCoefficient]
  | cons t p ih =>
      rcases t with ⟨e, c⟩
      simp only [bernsteinCoefficient, polyCoefficient, add_mul, Finset.sum_add_distrib]
      rw [ih]
      congr 1
      simp [bernsteinWeight, ite_mul, Finset.sum_ite_eq, mem_exponentBox, mul_ite, mul_assoc]

/-- Blueprint `spec:bernstein-compute`: zero padding to the verified coordinate box. -/
def paddedCoefficients (p : IntPolynomial) (n α : Exponent) : ℤ :=
  if α ≤ n then polyCoefficient p α else 0

/-- Blueprint `spec:bernstein-compute`: the three passes in their prescribed order. -/
def bernsteinTransform (p : IntPolynomial) (n : Exponent) : Exponent → ℤ :=
  bernsteinPass3 n (bernsteinPass2 n (bernsteinPass1 n (paddedCoefficients p n)))

/-- Blueprint `lem:bernstein-compute`: expansion of the three consecutive passes. -/
theorem bernsteinPasses_eq_box (n β : Exponent) (c : Exponent → ℤ) :
    bernsteinPass3 n (bernsteinPass2 n (bernsteinPass1 n c)) β =
      ∑ α ∈ exponentBox β, c α * ((n.1 - α.1).choose (β.1 - α.1) : ℤ) *
        ((n.2.1 - α.2.1).choose (β.2.1 - α.2.1) : ℤ) *
        ((n.2.2 - α.2.2).choose (β.2.2 - α.2.2) : ℤ) := by
  simp only [bernsteinPass1, bernsteinPass2, bernsteinPass3, Finset.sum_mul,
    exponentBox, Finset.sum_product]
  conv_lhs =>
    rw [Finset.sum_comm]
    arg 2
    ext j
    rw [Finset.sum_comm]
  conv_lhs => rw [Finset.sum_comm]

/-- Blueprint `lem:bernstein-compute`: the computed entries are exactly the
integer Bernstein coefficients for every index in the output box. -/
theorem bernsteinTransform_eq_coefficient (p : IntPolynomial) (n β : Exponent) (hβ : β ≤ n) :
    bernsteinTransform p n β = bernsteinCoefficient p n β := by
  rw [bernsteinTransform, bernsteinPasses_eq_box, bernsteinCoefficient_eq_box]
  apply Finset.sum_congr rfl
  intro α hα
  have hαn := ((mem_exponentBox α β).mp hα).trans hβ
  simp [paddedCoefficients, hαn]

/-- Coefficient-box evaluation used in blueprint `lem:homogeneous-eval`. -/
theorem polyEval_eq_coefficient_sum {p : IntPolynomial} {n : Exponent} (hp : polyBound p n)
    (x : ℝ × ℝ × ℝ) : polyEval p x =
      ∑ e ∈ exponentBox n, (polyCoefficient p e : ℝ) * monomialEval e x := by
  induction p with
  | nil => simp [polyEval, polyCoefficient]
  | cons t p ih =>
      rcases t with ⟨e, c⟩
      have ht := (polyBound_cons (e, c) p n).mp hp
      simp only [polyEval, polyCoefficient, Int.cast_add, add_mul, Finset.sum_add_distrib]
      rw [ih ht.2]
      congr 1
      simp [ite_mul, Finset.sum_ite_eq, (mem_exponentBox e n).mpr ht.1]

private theorem homogeneous_power (r s : ℝ) (hs : s ≠ 0) {e n : ℕ} (he : e ≤ n) :
    s ^ n * (r / s) ^ e = r ^ e * s ^ (n - e) := by
  conv_lhs => lhs; rw [← Nat.sub_add_cancel he, pow_add]
  rw [div_pow]
  field_simp

/-- Blueprint `lem:homogeneous-eval`, equation (homogeneous-id): multiplying by
the positive denominator powers gives exactly the computed integer numerator. -/
theorem homogeneousEval_eq {p : IntPolynomial} {n : Exponent} (hp : polyBound p n)
    (r s : ℤ × ℤ × ℤ) (hs : 0 < s.1 ∧ 0 < s.2.1 ∧ 0 < s.2.2) :
    (homogeneousEval p n r s : ℝ) =
      ((s.1 : ℝ) ^ n.1 * (s.2.1 : ℝ) ^ n.2.1 * (s.2.2 : ℝ) ^ n.2.2) *
        polyEval p ((r.1 : ℝ) / s.1, (r.2.1 : ℝ) / s.2.1, (r.2.2 : ℝ) / s.2.2) := by
  rw [homogeneousEval, polyEval_eq_coefficient_sum hp, Finset.mul_sum]
  push_cast
  apply Finset.sum_congr rfl
  intro e he
  have hen := (mem_exponentBox e n).mp he
  have hs₁ : (s.1 : ℝ) ≠ 0 := by exact_mod_cast hs.1.ne'
  have hs₂ : (s.2.1 : ℝ) ≠ 0 := by exact_mod_cast hs.2.1.ne'
  have hs₃ : (s.2.2 : ℝ) ≠ 0 := by exact_mod_cast hs.2.2.ne'
  rw [← homogeneous_power (r.1 : ℝ) (s.1 : ℝ) hs₁ hen.1,
    ← homogeneous_power (r.2.1 : ℝ) (s.2.1 : ℝ) hs₂ hen.2.1,
    ← homogeneous_power (r.2.2 : ℝ) (s.2.2 : ℝ) hs₃ hen.2.2]
  unfold monomialEval
  ring

/-- Blueprint `lem:homogeneous-eval`: signs of a rational-point evaluation can be
checked using the integer numerator alone. -/
theorem homogeneousEval_sign {p : IntPolynomial} {n : Exponent} (hp : polyBound p n)
    (r s : ℤ × ℤ × ℤ) (hs : 0 < s.1 ∧ 0 < s.2.1 ∧ 0 < s.2.2) :
    (0 < homogeneousEval p n r s ↔
      0 < polyEval p ((r.1 : ℝ) / s.1, (r.2.1 : ℝ) / s.2.1, (r.2.2 : ℝ) / s.2.2)) ∧
    (0 ≤ homogeneousEval p n r s ↔
      0 ≤ polyEval p ((r.1 : ℝ) / s.1, (r.2.1 : ℝ) / s.2.1, (r.2.2 : ℝ) / s.2.2)) ∧
    (homogeneousEval p n r s = 0 ↔
      polyEval p ((r.1 : ℝ) / s.1, (r.2.1 : ℝ) / s.2.1, (r.2.2 : ℝ) / s.2.2) = 0) := by
  have hpos : 0 < (s.1 : ℝ) ^ n.1 * (s.2.1 : ℝ) ^ n.2.1 * (s.2.2 : ℝ) ^ n.2.2 := by
    have h₁ : 0 < (s.1 : ℝ) := by exact_mod_cast hs.1
    have h₂ : 0 < (s.2.1 : ℝ) := by exact_mod_cast hs.2.1
    have h₃ : 0 < (s.2.2 : ℝ) := by exact_mod_cast hs.2.2
    positivity
  have he := homogeneousEval_eq hp r s hs
  constructor
  · have := mul_pos_iff_of_pos_left hpos
      (b := polyEval p ((r.1 : ℝ) / s.1, (r.2.1 : ℝ) / s.2.1, (r.2.2 : ℝ) / s.2.2))
    rw [← he] at this
    exact_mod_cast this
  constructor
  · have := mul_nonneg_iff_of_pos_left hpos
      (b := polyEval p ((r.1 : ℝ) / s.1, (r.2.1 : ℝ) / s.2.1, (r.2.2 : ℝ) / s.2.2))
    rw [← he] at this
    exact_mod_cast this
  · have := mul_eq_zero_iff_left hpos.ne'
      (b := polyEval p ((r.1 : ℝ) / s.1, (r.2.1 : ℝ) / s.2.1, (r.2.2 : ℝ) / s.2.2))
    rw [← he] at this
    exact_mod_cast this

/-- Blueprint `lem:substitutions`: a substituted monomial has the stated value. -/
theorem monomialEval_substitute (e m₁ m₂ m₃ : Exponent) (x : ℝ × ℝ × ℝ) :
    monomialEval (exponentSubstitute e m₁ m₂ m₃) x =
      monomialEval e (monomialEval m₁ x, monomialEval m₂ x, monomialEval m₃ x) := by
  simp only [monomialEval, exponentSubstitute, pow_add, pow_mul, mul_pow]
  ring

/-- Blueprint `lem:substitutions`: monomial substitution preserves its real meaning. -/
theorem polyEval_monomialSubstitute (p : IntPolynomial) (m₁ m₂ m₃ : Exponent) (x : ℝ × ℝ × ℝ) :
    polyEval (polyMonomialSubstitute p m₁ m₂ m₃) x =
      polyEval p (monomialEval m₁ x, monomialEval m₂ x, monomialEval m₃ x) := by
  unfold polyMonomialSubstitute
  rw [polyEval_normalize]
  induction p with
  | nil => simp [polyEval]
  | cons t p ih =>
      rcases t with ⟨e, c⟩
      simp only [List.map_cons, polyEval, monomialEval_substitute, ih]

private theorem polyEval_fold_add {α : Type*} (l : List α) (f : α → IntPolynomial)
    (q : IntPolynomial) (x : ℝ × ℝ × ℝ) :
    polyEval (l.foldl (fun q t => polyMerge q (f t)) q) x =
      polyEval q x + (l.map (fun t => polyEval (f t) x)).sum := by
  induction l generalizing q with
  | nil => simp
  | cons t l ih => simp [List.foldl_cons, ih, polyEval_merge, add_assoc]

/-- Blueprint `lem:substitutions`, equation (tau-clear-sound): clearing the rational
third-coordinate substitution has exactly the specified evaluation. -/
theorem polyEval_clearSubstitute {p : IntPolynomial} (U D : IntPolynomial) {n : ℕ}
    (hp : ∀ t ∈ p, t.1.2.2 ≤ n) (x : ℝ × ℝ × ℝ) (hD : polyEval D x ≠ 0) :
    polyEval (polyClearSubstitute p U D n) x =
      polyEval D x ^ n * polyEval p (x.1, x.2.1, polyEval U x / polyEval D x) := by
  unfold polyClearSubstitute
  rw [polyEval_fold_add]
  simp only [polyEval, zero_add]
  induction p with
  | nil => simp [polyEval]
  | cons t p ih =>
      rcases t with ⟨e, c⟩
      have he : e.2.2 ≤ n := hp (e, c) (by simp)
      have htail : ∀ t ∈ p, t.1.2.2 ≤ n := fun t ht => hp t (by simp [ht])
      simp only [List.map_cons, List.sum_cons, polyEval_mul, polyEval_pow, polyEval, monomialEval,
        pow_zero, mul_one, add_zero] at ih ⊢
      rw [ih htail]
      have hpow := homogeneous_power (polyEval U x) (polyEval D x) hD he
      linear_combination (c : ℝ) * x.1 ^ e.1 * x.2.1 ^ e.2.1 * hpow.symm

private theorem halfZero_monomial (e : Exponent) (i : Fin 3) (n : ℕ)
    (he : tripleCoordinate e i ≤ n) (x : ℝ × ℝ × ℝ) :
    (2 : ℝ) ^ (n - tripleCoordinate e i) * monomialEval e x =
      (2 : ℝ) ^ n * monomialEval e (tripleReplace x i (tripleCoordinate x i / 2)) := by
  have hp (r : ℝ) (e : ℕ) (he : e ≤ n) :
      (2 : ℝ) ^ n * (r / 2) ^ e = r ^ e * 2 ^ (n - e) := by
    conv_lhs => lhs; rw [← Nat.sub_add_cancel he, pow_add]
    rw [div_pow]
    field_simp
  fin_cases i <;> simp only [tripleCoordinate, tripleReplace, Fin.reduceFinMk,
    ite_true, ite_false, show (1 : Fin 3) ≠ 0 by decide,
    show (2 : Fin 3) ≠ 0 by decide, show (2 : Fin 3) ≠ 1 by decide] at he ⊢
  · simp only [monomialEval]
    linear_combination -(x.2.1 ^ e.2.1 * x.2.2 ^ e.2.2) * (hp x.1 e.1 he)
  · simp only [monomialEval]
    linear_combination -(x.1 ^ e.1 * x.2.2 ^ e.2.2) * (hp x.2.1 e.2.1 he)
  · simp only [monomialEval]
    linear_combination -(x.1 ^ e.1 * x.2.1 ^ e.2.1) * (hp x.2.2 e.2.2 he)

/-- Direct coefficient scaling has the required half-interval evaluation. -/
theorem polyEval_halfZero (p : IntPolynomial) (i : Fin 3) (x : ℝ × ℝ × ℝ) :
    polyEval (polyHalfZero p i) x = (2 : ℝ) ^ tripleCoordinate (polyDegree p) i *
      polyEval p (tripleReplace x i (tripleCoordinate x i / 2)) := by
  have hbound : ∀ t ∈ p, tripleCoordinate t.1 i ≤ tripleCoordinate (polyDegree p) i := by
    intro t ht
    have he := polyBound_degree p t ht
    fin_cases i <;> simp only [tripleCoordinate, Fin.reduceFinMk, ite_true, ite_false,
      show (1 : Fin 3) ≠ 0 by decide, show (2 : Fin 3) ≠ 0 by decide,
      show (2 : Fin 3) ≠ 1 by decide] <;> first | exact he.1 | exact he.2.1 | exact he.2.2
  unfold polyHalfZero
  rw [polyEval_normalize]
  generalize tripleCoordinate (polyDegree p) i = n at *
  induction p with
  | nil => simp [polyEval]
  | cons t p ih =>
      rw [List.map_cons]
      simp only [polyEval, Int.cast_mul, Int.cast_pow, Int.cast_ofNat]
      rw [ih (fun t ht => hbound t (by simp [ht]))]
      have hm := halfZero_monomial t.1 i n (hbound t (by simp)) x
      linear_combination (t.2 : ℝ) * hm

private theorem polyEval_map_range (f : ℕ → Exponent × ℤ) (n : ℕ) (x : ℝ × ℝ × ℝ) :
    polyEval ((List.range n).map f) x = ∑ h ∈ Finset.range n,
      ((f h).2 : ℝ) * monomialEval (f h).1 x := by
  induction n with
  | zero => simp [polyEval]
  | succ n ih =>
      rw [List.range_succ, List.map_append, polyEval_append, ih, Finset.sum_range_succ]
      rcases hf : f n with ⟨e, c⟩
      simp [polyEval, hf]

private theorem half_power_expansion (x δ : ℝ) {e n : ℕ} (he : e ≤ n) :
    (∑ h ∈ Finset.range (e + 1), (2 : ℝ) ^ (n - e) * (e.choose h : ℝ) * δ ^ (e - h) * x ^ h) =
      (2 : ℝ) ^ n * ((x + δ) / 2) ^ e := by
  rw [homogeneous_power (x + δ) 2 (by norm_num) he, add_pow, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro h hh
  ring

private theorem monomialEval_replace_exponent (e : Exponent) (i : Fin 3) (h : ℕ) (x : ℝ × ℝ × ℝ) :
    monomialEval (tripleReplace e i h) x =
      monomialEval (tripleReplace e i 0) x * tripleCoordinate x i ^ h := by
  fin_cases i <;> simp [tripleReplace, tripleCoordinate, monomialEval] <;> ring

private theorem monomialEval_replace_coordinate (e : Exponent) (i : Fin 3) (v : ℝ) (x : ℝ × ℝ × ℝ) :
    monomialEval e (tripleReplace x i v) =
      monomialEval (tripleReplace e i 0) x * v ^ tripleCoordinate e i := by
  fin_cases i <;> simp [tripleReplace, tripleCoordinate, monomialEval] <;> ring

/-- Blueprint `lem:substitutions`: the half-interval coefficient formula has
the required value for one monomial. The identity holds for every integer shift. -/
theorem polyEval_halfMonomial (t : Exponent × ℤ) (i : Fin 3) (δ : ℤ) (n : ℕ)
    (he : tripleCoordinate t.1 i ≤ n) (x : ℝ × ℝ × ℝ) :
    polyEval (halfMonomial t i δ n) x = (2 : ℝ) ^ n *
      ((t.2 : ℝ) * monomialEval t.1 (tripleReplace x i ((tripleCoordinate x i + δ) / 2))) := by
  rw [halfMonomial, polyEval_map_range, monomialEval_replace_coordinate]
  simp only [Int.cast_mul, Int.cast_pow, Int.cast_ofNat, Int.cast_natCast]
  conv_lhs =>
    arg 2
    ext h
    rw [monomialEval_replace_exponent]
  calc
    _ = (t.2 : ℝ) * monomialEval (tripleReplace t.1 i 0) x *
        ∑ h ∈ Finset.range (tripleCoordinate t.1 i + 1),
          (2 : ℝ) ^ (n - tripleCoordinate t.1 i) *
            (Nat.choose (tripleCoordinate t.1 i) h : ℝ) *
            (δ : ℝ) ^ (tripleCoordinate t.1 i - h) * tripleCoordinate x i ^ h := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro h hh
      ring
    _ = _ := by rw [half_power_expansion _ _ he]; ring

/-- Blueprint `lem:substitutions`: a half-interval substitution evaluates to
`2^n` times the original polynomial at the substituted point, where `n` is its
current coordinate degree. In particular this covers the prescribed shifts 0 and 1. -/
theorem polyEval_halfSubstitute (p : IntPolynomial) (i : Fin 3) (δ : ℤ) (x : ℝ × ℝ × ℝ) :
    polyEval (polyHalfSubstitute p i δ) x = (2 : ℝ) ^ tripleCoordinate (polyDegree p) i *
      polyEval p (tripleReplace x i ((tripleCoordinate x i + δ) / 2)) := by
  unfold polyHalfSubstitute
  split_ifs with hδ
  · subst δ
    simpa using polyEval_halfZero p i x
  ·
    have hbound : ∀ t ∈ p, tripleCoordinate t.1 i ≤ tripleCoordinate (polyDegree p) i := by
      intro t ht
      have he := polyBound_degree p t ht
      fin_cases i <;> simp only [tripleCoordinate, Fin.reduceFinMk, ite_true, ite_false,
        show (1 : Fin 3) ≠ 0 by decide, show (2 : Fin 3) ≠ 0 by decide,
        show (2 : Fin 3) ≠ 1 by decide] <;> first | exact he.1 | exact he.2.1 | exact he.2.2
    unfold polyHalfRows
    generalize tripleCoordinate (polyDegree p) i = n at *
    induction p with
    | nil => simp [polyEval]
    | cons t p ih =>
        rcases t with ⟨e, c⟩
        rw [List.foldr_cons, polyEval_merge, polyEval_normalize, polyEval_halfMonomial _ _ _ _ (hbound _ (by simp)),
          ih (fun t ht => hbound t (by simp [ht]))]
        simp only [polyEval]
        ring

/-- Blueprint `lem:rational-param`: the corresponding rational square root. -/
noncomputable def rationalRoot (j : ℝ) : ℝ := (1 - j ^ 2) / (1 + j ^ 2)

/-- Blueprint `lem:rational-param`: inverse parameter `j=v/(1+rho)`. -/
noncomputable def rootParameter (v : ℝ) : ℝ := v / (1 + r v)

/-- Blueprint `lem:rational-param`: the inverse parameter belongs to `(0,1)`. -/
theorem rootParameter_mem {v : ℝ} (hv : v ∈ Set.Ioo 0 1) : rootParameter v ∈ Set.Ioo 0 1 := by
  have hp : 0 < 1 + r v := by linarith [r_nonneg v]
  exact ⟨div_pos hv.1 hp, (div_lt_one hp).mpr (by linarith [r_nonneg v, hv.2])⟩

/-- Blueprint `lem:rational-param`, forward direction of (rational-param). -/
theorem rational_parameter_inverse {v : ℝ} (hv : v ∈ Set.Ioo 0 1) :
    rationalV (rootParameter v) = v ∧ rationalRoot (rootParameter v) = r v := by
  have hp : 1 + r v ≠ 0 := by linarith [r_nonneg v]
  have hs := r_sq (by rw [abs_of_pos hv.1]; exact hv.2.le)
  have hd : 1 + (v / (1 + r v)) ^ 2 = 2 / (1 + r v) := by
    field_simp
    nlinarith
  have hn : 1 - (v / (1 + r v)) ^ 2 = 2 * r v / (1 + r v) := by
    field_simp
    nlinarith
  unfold rationalV rationalRoot rootParameter
  rw [hd, hn]
  constructor <;> field_simp

/-- Blueprint `lem:rational-param`, converse: `2j/(1+j²)` belongs to `(0,1)`. -/
theorem rationalV_mem {j : ℝ} (hj : j ∈ Set.Ioo 0 1) : rationalV j ∈ Set.Ioo 0 1 := by
  have hd : 0 < 1 + j ^ 2 := by positivity
  refine ⟨div_pos (mul_pos (by norm_num) hj.1) hd, (div_lt_one hd).mpr ?_⟩
  nlinarith [sq_pos_of_pos (sub_pos.mpr hj.2)]

/-- Blueprint `lem:rational-param`, converse: the positive root is rational. -/
theorem r_rationalV {j : ℝ} (hj : j ∈ Set.Ioo 0 1) : r (rationalV j) = rationalRoot j := by
  have hv := rationalV_mem hj
  have hd : 0 < 1 + j ^ 2 := by positivity
  have hn : 0 < 1 - j ^ 2 := by nlinarith [hj.1, hj.2]
  apply (sq_eq_sq₀ (r_nonneg _) (div_pos hn hd).le).mp
  rw [r_sq (by rw [abs_of_pos hv.1]; exact hv.2.le)]
  dsimp only [rationalV, rationalRoot]
  field_simp
  <;> ring

/-- Blueprint `lem:rational-param`: the difference from `4/5` factors with a
strictly positive factor besides `2j-1`. -/
theorem rationalV_threshold_factor (j : ℝ) :
    rationalV j - 4 / 5 = (2 * j - 1) * (2 * (2 - j) / (5 * (1 + j ^ 2))) := by
  unfold rationalV
  have hd : 1 + j ^ 2 ≠ 0 := by positivity
  field_simp
  <;> ring

/-- Blueprint `lem:rational-param`: the two threshold equivalences, including equality. -/
theorem rationalV_thresholds {j : ℝ} (hj : j ∈ Set.Ioo 0 1) :
    (rationalV j ≤ 4 / 5 ↔ j ≤ 1 / 2) ∧ (4 / 5 ≤ rationalV j ↔ 1 / 2 ≤ j) := by
  have hp : 0 < 2 * (2 - j) / (5 * (1 + j ^ 2)) := by
    apply div_pos (mul_pos (by norm_num) (by linarith [hj.2]))
    positivity
  constructor
  · rw [← sub_nonpos, rationalV_threshold_factor]
    have hh := not_congr (mul_pos_iff_of_pos_right hp (a := 2 * j - 1))
    simp only [not_lt] at hh
    rw [hh]
    constructor <;> intro h <;> linarith
  · rw [← sub_nonneg, rationalV_threshold_factor, mul_nonneg_iff_of_pos_right hp]
    constructor <;> intro h <;> linarith

/-- Blueprint `def:FKQ`, equation (KQdef): the coefficient `K`, expressed using
the signed parameter `t = epsilon * tau`. -/
noncomputable def rootK (c : CertificateCase) (v y t : ℝ) : ℝ :=
  1 - (t * (v * y)) * (if c = .minus then Mminus ((v * y) ^ 2) else Mplus ((v * y) ^ 2))

/-- Blueprint `def:FKQ`, equation (KQdef): the polynomial expression under the
remaining square root, with the two spatial roots supplied as parameters. -/
def rootQ (v y ρ σ t : ℝ) : ℝ :=
  (1 - (v * y) ^ 2) ^ 2 - (t * v * σ ^ 2 - y * ρ ^ 2) ^ 2

/-- Blueprint `def:FKQ`, equations (Fpm) and (Fb): the expression `F` for each case. -/
noncomputable def rootF (c : CertificateCase) (v y ρ σ t : ℝ) : ℝ :=
  let z := v * y
  let Z := z ^ 2
  let Y := y ^ 2
  let P := 1 - Z
  let w := t * z
  let K := rootK c v y t
  if c = .boundary then
    K * (P + (1 + w) * ρ * σ) - P * ρ * σ * (1 - w) ^ 2 * (1 + Z / 3) -
      (1 - w) * P * (Y - Z + w * σ ^ 2) * (1 / 2 - ρ * σ / 6)
  else
    K * (P + (1 + w) * ρ * σ) - (1 - w) *
      (P * ρ * (σ * (7 + Y) + 8) / 15 -
        w * (if c = .minus then (2 + Y) / 3 else 2 * P / 3) * ρ * σ)

/-- Blueprint `def:FKQ`: the rational `F` built from `j,k,tau`. -/
noncomputable def rationalF (c : CertificateCase) (j k τ : ℝ) : ℝ :=
  rootF c (rationalV j) (rationalV k) (rationalRoot j) (rationalRoot k) (certificateSign c * τ)

/-- Blueprint `def:FKQ`: the rational `K` built from `j,k,tau`. -/
noncomputable def rationalK (c : CertificateCase) (j k τ : ℝ) : ℝ :=
  rootK c (rationalV j) (rationalV k) (certificateSign c * τ)

/-- Blueprint `def:FKQ`: the rational `Q` built from `j,k,tau`. -/
noncomputable def rationalQ (c : CertificateCase) (j k τ : ℝ) : ℝ :=
  rootQ (rationalV j) (rationalV k) (rationalRoot j) (rationalRoot k) (certificateSign c * τ)

/-- Blueprint `lem:remove-root`: the remaining square-root argument stays in
the open semicircle domain. -/
theorem remaining_root_domain {a b u : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1)
    (hu : |u| ≤ a) : |u - b| < 1 := by
  calc |u - b| ≤ |u| + |b| := abs_sub _ _
       _ ≤ a + b := by rw [abs_of_pos hb]; linarith
       _ < 1 := hab

/-- Blueprint `lem:remove-root`: the exact squared identity for `Q`. -/
theorem rootQ_coordinates {a b : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (u : ℝ) :
    rootQ (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (u / a) =
      PCoord a b ^ 2 * (1 - (u - b) ^ 2) := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hP : PCoord a b ≠ 0 := hr.2.2.2.2.2.2.2.2.ne'
  have hi := coordinates_inverse ha hb hab
  have he₁ : a * PCoord a b = vCoord a b * r (yCoord a b) ^ 2 := (eq_div_iff hP).mp hi.1
  have he₂ : b * PCoord a b = yCoord a b * r (vCoord a b) ^ 2 := (eq_div_iff hP).mp hi.2
  have he : u / a * vCoord a b * r (yCoord a b) ^ 2 - yCoord a b * r (vCoord a b) ^ 2 =
      PCoord a b * (u - b) := by
    rw [mul_assoc (u / a), ← he₁, ← he₂]
    field_simp
    <;> ring
  unfold rootQ
  rw [he]
  change PCoord a b ^ 2 - (PCoord a b * (u - b)) ^ 2 = _
  ring

/-- Blueprint `lem:remove-root`: `Q` is positive, and its positive square root
is exactly `P * r(u-b)`. -/
theorem rootQ_pos_sqrt {a b u : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1)
    (hu : |u| ≤ a) :
    0 < rootQ (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (u / a) ∧
    Real.sqrt (rootQ (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (u / a)) =
      PCoord a b * r (u - b) := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hP : 0 < PCoord a b := hr.2.2.2.2.2.2.2.2
  have hx := remaining_root_domain ha hb hab hu
  rw [rootQ_coordinates ha hb hab, ← r_sq hx.le]
  constructor
  · exact mul_pos (sq_pos_of_pos hP) (sq_pos_of_pos (r_pos hx))
  · rw [← mul_pow, Real.sqrt_sq (mul_pos hP (r_pos hx)).le]

/-- Blueprint `lem:remove-root`: select the lower bound associated with each case. -/
noncomputable def certificateLower (c : CertificateCase) (a b u : ℝ) : ℝ :=
  match c with
  | .minus => PhiMinus a b u
  | .plus => PhiPlus a b u
  | .boundary => Psi a b u

/-- The expression for `Xi` after removal of the square root in blueprint `lem:remove-root`. -/
theorem Xi_rootQ {a b u : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (hu : |u| ≤ a) :
    Xi a b u = (r (vCoord a b) * r (yCoord a b) * (1 + wCoord a b u) + PCoord a b -
      Real.sqrt (rootQ (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (u / a))) /
      (r (vCoord a b) * r (yCoord a b)) := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hP : PCoord a b ≠ 0 := hr.2.2.2.2.2.2.2.2.ne'
  have hTP : T a b * PCoord a b = r (vCoord a b) * r (yCoord a b) :=
    (eq_div_iff hP).mp (coordinates_T ha hb hab)
  rw [Xi_explicit ha hb hab, (rootQ_pos_sqrt ha hb hab hu).2, ← hTP]
  have hT := (spatial_quantities_pos ha.le hb.le hab).2.2.1.ne'
  field_simp
  <;> ring

/-- Blueprint `lem:remove-root`, all three case-specific identities in (rational-lower). -/
theorem certificateLower_root_identity (c : CertificateCase) {a b u : ℝ}
    (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (hu : |u| ≤ a) :
    r (vCoord a b) * r (yCoord a b) * certificateLower c a b u =
      rootF c (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (u / a) -
        rootK c (vCoord a b) (yCoord a b) (u / a) *
          Real.sqrt (rootQ (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (u / a)) := by
  have hc := coordinates_mem ha hb hab
  have hr := coordinate_ranges hc.1 hc.2
  have hρ := hr.2.2.2.2.2.2.1.ne'
  have hσ := hr.2.2.2.2.2.2.2.1.ne'
  have hw : u / a * (vCoord a b * yCoord a b) = wCoord a b u := (wCoord_eq ha hb hab u).symm
  have hs : r (yCoord a b) ^ 2 = 1 - YCoord a b :=
    r_sq (by rw [abs_of_pos hc.2.1]; exact hc.2.2.le)
  have hσ' : Real.sqrt (1 - YCoord a b) = r (yCoord a b) := rfl
  cases c <;>
    simp [certificateLower, PhiMinus, PhiPlus, Psi, rootF, rootK,
      hw, Xi_rootQ ha hb hab hu, Astar, hσ']
  all_goals
    dsimp only [PCoord, ZCoord, zCoord, YCoord] at *
    try rw [hs]
    field_simp
    <;> ring

/-- Blueprint `lem:remove-root`: strict positivity is recovered from `F>0` and
the strict squared inequality without a sign assumption on `K`. -/
theorem positive_of_squared_gap {F K Q : ℝ} (hQ : 0 < Q) (hF : 0 < F)
    (hgap : 0 < F ^ 2 - K ^ 2 * Q) : 0 < F - K * Real.sqrt Q := by
  have hs : 0 ≤ Real.sqrt Q := Real.sqrt_nonneg Q
  have hsq := Real.sq_sqrt hQ.le
  have hp : |K| * Real.sqrt Q < F := by
    have hn := mul_nonneg (abs_nonneg K) hs
    have he : (|K| * Real.sqrt Q) ^ 2 = K ^ 2 * Q := by rw [mul_pow, sq_abs, hsq]
    nlinarith
  have hk := mul_le_mul_of_nonneg_right (le_abs_self K) hs
  linarith

/-- Blueprint `lem:remove-root`: the squared certificate implies strict positivity
of the selected analytic lower bound. -/
theorem certificateLower_pos_of_squared (c : CertificateCase) {a b u : ℝ}
    (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (hu : |u| ≤ a)
    (hF : 0 < rootF c (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (u / a))
    (hgap : 0 < rootF c (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (u / a) ^ 2 -
      rootK c (vCoord a b) (yCoord a b) (u / a) ^ 2 *
        rootQ (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (u / a)) :
    0 < certificateLower c a b u := by
  have hp := positive_of_squared_gap (rootQ_pos_sqrt ha hb hab hu).1 hF hgap
  rw [← certificateLower_root_identity c ha hb hab hu] at hp
  have hr := coordinate_ranges (coordinates_mem ha hb hab).1 (coordinates_mem ha hb hab).2
  exact (mul_pos_iff_of_pos_left (mul_pos hr.2.2.2.2.2.2.1 hr.2.2.2.2.2.2.2.1)).mp hp

/-- The inverse-coordinate recovery used when specializing blueprint
`lem:remove-root` to arbitrary rational parameters. -/
theorem inverse_coordinates_recover {v y : ℝ} (hv : v ∈ Set.Ioo 0 1) (hy : y ∈ Set.Ioo 0 1) :
    let a := v * r y ^ 2 / (1 - (v * y) ^ 2)
    let b := y * r v ^ 2 / (1 - (v * y) ^ 2)
    vCoord a b = v ∧ yCoord a b = y := by
  let a := v * r y ^ 2 / (1 - (v * y) ^ 2)
  let b := y * r v ^ 2 / (1 - (v * y) ^ 2)
  change vCoord a b = v ∧ yCoord a b = y
  have hd := inverse_coordinates_domain hv hy
  have hp := spatial_quantities_pos hd.1.le hd.2.1.le hd.2.2
  have heT : T a b = r v * r y / (1 - (v * y) ^ 2) := (inverse_coordinates_values hv hy).2.2.1
  have hDa : T a b ^ 2 + a ^ 2 ≠ 0 :=
    (add_pos_of_pos_of_nonneg (sq_pos_of_pos hp.2.2.1) (sq_nonneg a)).ne'
  have hDb : T a b ^ 2 + b ^ 2 ≠ 0 :=
    (add_pos_of_pos_of_nonneg (sq_pos_of_pos hp.2.2.1) (sq_nonneg b)).ne'
  have hr := coordinate_ranges hv hy
  have hP := hr.2.2.2.2.2.2.2.2.ne'
  have hP' : 1 - v ^ 2 * y ^ 2 ≠ 0 := by simpa only [mul_pow] using hP
  have hvq := r_sq (by rw [abs_of_pos hv.1]; exact hv.2.le)
  have hyq := r_sq (by rw [abs_of_pos hy.1]; exact hy.2.le)
  have hP'' : 1 - y ^ 2 * v ^ 2 ≠ 0 := by simpa only [mul_comm] using hP'
  constructor
  · unfold vCoord
    apply (div_eq_iff hDa).mpr
    rw [heT]
    dsimp only [a]
    simp only [div_pow, mul_pow, hvq, hyq]
    field_simp [hP, hP']
    <;> ring
  · unfold yCoord
    apply (div_eq_iff hDb).mpr
    rw [heT]
    dsimp only [b]
    simp only [div_pow, mul_pow, hvq, hyq]
    field_simp [hP, hP', hP'']
    <;> ring

/-- Blueprint `lem:remove-root`: positivity of the remaining radical for all
interior coordinate parameters and every signed parameter in `[-1,1]`. -/
theorem rootQ_pos {v y t : ℝ} (hv : v ∈ Set.Ioo 0 1) (hy : y ∈ Set.Ioo 0 1) (ht : |t| ≤ 1) :
    0 < rootQ v y (r v) (r y) t := by
  let a := v * r y ^ 2 / (1 - (v * y) ^ 2)
  let b := y * r v ^ 2 / (1 - (v * y) ^ 2)
  have hd := inverse_coordinates_domain hv hy
  have hu : |t * a| ≤ a := by
    rw [abs_mul, abs_of_pos hd.1]
    nlinarith [mul_nonneg (sub_nonneg.mpr ht) hd.1.le]
  have ha : a ≠ 0 := hd.1.ne'
  have he : t * a / a = t := by field_simp [ha]
  have hp := (rootQ_pos_sqrt hd.1 hd.2.1 hd.2.2 hu).1
  have hv' : vCoord a b = v := (inverse_coordinates_recover hv hy).1
  have hy' : yCoord a b = y := (inverse_coordinates_recover hv hy).2
  change 0 < rootQ (vCoord a b) (yCoord a b) (r (vCoord a b)) (r (yCoord a b)) (t * a / a) at hp
  simpa only [hv', hy', he] using hp

/-- Blueprint `lem:remove-root`: the rational expression `Q` is positive throughout
the stated open spatial square and closed `tau` interval. -/
theorem rationalQ_pos (c : CertificateCase) {j k τ : ℝ} (hj : j ∈ Set.Ioo 0 1)
    (hk : k ∈ Set.Ioo 0 1) (hτ : τ ∈ Set.Icc 0 1) : 0 < rationalQ c j k τ := by
  unfold rationalQ
  rw [← r_rationalV hj, ← r_rationalV hk]
  apply rootQ_pos (rationalV_mem hj) (rationalV_mem hk)
  cases c <;> simpa [certificateSign, abs_of_nonneg hτ.1] using hτ.2

/-- Blueprint `lem:chartfactors`: evaluations of the denominator and numerator polynomials. -/
theorem chart_factor_evaluations (x : ℝ × ℝ × ℝ) :
    polyEval polyD0 x = (1 + x.1 ^ 2) * (1 + x.2.1 ^ 2) ∧
    polyEval polyN0 x = 4 * x.1 * x.2.1 ∧
    polyEval polyPminus x = polyEval polyD0 x - polyEval polyN0 x ∧
    polyEval polyPplus x = polyEval polyD0 x + polyEval polyN0 x ∧
    polyEval polyP0 x = polyEval polyPminus x * polyEval polyPplus x := by
  simp [polyD0, polyN0, polyPminus, polyPplus, polyP0, polyEval_mul, polyEval_scale,
    polyEval_add, polyEval_neg, (polyEval_bases x).1, (polyEval_bases x).2,
    (polyEval_variables x).1, (polyEval_variables x).2.1, mul_assoc, sub_eq_add_neg]

/-- Blueprint `lem:chartfactors`: all removed nonmonomial factors are positive
on the open spatial square. -/
theorem chart_factors_pos {j k : ℝ} (hj : j ∈ Set.Ioo 0 1) (hk : k ∈ Set.Ioo 0 1) (τ : ℝ) :
    0 < polyEval polyA0 (j, k, τ) ∧ 0 < polyEval polyB0 (j, k, τ) ∧
    0 < polyEval polyD0 (j, k, τ) ∧ 0 < polyEval polyN0 (j, k, τ) ∧
    0 < polyEval polyPminus (j, k, τ) ∧ 0 < polyEval polyPplus (j, k, τ) ∧
    0 < polyEval polyP0 (j, k, τ) := by
  have hA : 0 < polyEval polyA0 (j, k, τ) := by rw [(polyEval_bases _).1]; positivity
  have hB : 0 < polyEval polyB0 (j, k, τ) := by rw [(polyEval_bases _).2]; positivity
  have hd : 0 < polyEval polyD0 (j, k, τ) := by rw [polyD0, polyEval_mul]; exact mul_pos hA hB
  have he := chart_factor_evaluations (j, k, τ)
  have hn : 0 < polyEval polyN0 (j, k, τ) := by
    rw [he.2.1]
    exact mul_pos (mul_pos (by norm_num) hj.1) hk.1
  have hm : 0 < polyEval polyPminus (j, k, τ) := by
    rw [he.2.2.1, he.1, he.2.1]
    have hjk : j * k < 1 := by nlinarith [mul_pos hj.1 (sub_pos.mpr hk.2), hj.2]
    nlinarith [sq_nonneg (j - k), sq_pos_of_pos (sub_pos.mpr hjk)]
  have hp : 0 < polyEval polyPplus (j, k, τ) := by rw [he.2.2.2.1]; exact add_pos hd hn
  exact ⟨hA, hB, hd, hn, hm, hp, by rw [he.2.2.2.2]; exact mul_pos hm hp⟩

/-- Blueprint `lem:chartfactors`: the ratio `N₀/D₀` is the product coordinate `z`
and belongs to `(0,1)`. -/
theorem chart_z_mem {j k : ℝ} (hj : j ∈ Set.Ioo 0 1) (hk : k ∈ Set.Ioo 0 1) (τ : ℝ) :
    polyEval polyN0 (j, k, τ) / polyEval polyD0 (j, k, τ) = rationalV j * rationalV k ∧
    polyEval polyN0 (j, k, τ) / polyEval polyD0 (j, k, τ) ∈ Set.Ioo 0 1 := by
  have he := chart_factor_evaluations (j, k, τ)
  have hp := chart_factors_pos hj hk τ
  constructor
  · rw [he.1, he.2.1, rationalV, rationalV, div_mul_div_comm]
    congr 1
    ring
  · refine ⟨div_pos hp.2.2.2.1 hp.2.2.1, (div_lt_one hp.2.2.1).mpr ?_⟩
    have hm := hp.2.2.2.2.1
    rw [he.2.2.1] at hm
    linarith

/-- Closed parameter cube in blueprint `lem:coverage`. -/
def InUnitCube (x : ℝ × ℝ × ℝ) : Prop :=
  x.1 ∈ Set.Icc 0 1 ∧ x.2.1 ∈ Set.Icc 0 1 ∧ x.2.2 ∈ Set.Icc 0 1

/-- Blueprint `lem:coverage`: the old-parameter region for each row. -/
noncomputable def chartRegion (c : Chart) (x : ℝ × ℝ × ℝ) : Prop :=
  match c with
  | .N1 => x.1 ≤ x.2.1
  | .N2 => x.2.1 ≤ x.1 * x.2.2 ∧ x.2.1 ≤ x.1
  | .N3 => x.1 * x.2.2 ≤ x.2.1 ∧ x.2.1 ≤ x.1
  | .P1 => x.1 ≤ 1 / 2
  | .P2 => 1 / 2 ≤ x.1 ∧ x.2.1 ≤ 1 / 2
  | .P3 => x.2.2 ≤ chartZ x.1 x.2.1
  | .B1 => 1 / 2 ≤ x.1 ∧ 1 / 2 ≤ x.2.1 ∧ chartZ x.1 x.2.1 ≤ x.2.2

/-- Blueprint `lem:coverage`: the three negative rows cover the whole required
domain, including interfaces. -/
theorem negative_chart_coverage {j k τ : ℝ} (hj : j ∈ Set.Ioo 0 1) (hk : k ∈ Set.Ioo 0 1)
    (hτ : τ ∈ Set.Icc 0 1) :
    ∃ c x, (c = Chart.N1 ∨ c = Chart.N2 ∨ c = Chart.N3) ∧ InUnitCube x ∧
      chartMap c x = (j, k, τ) ∧ chartRegion c (j, k, τ) := by
  by_cases hjk : j ≤ k
  · refine ⟨.N1, (j / k, k, τ), Or.inl rfl,
      ⟨⟨(div_pos hj.1 hk.1).le, (div_le_one hk.1).mpr hjk⟩, ⟨hk.1.le, hk.2.le⟩, hτ⟩, ?_, hjk⟩
    apply Prod.ext
    · dsimp only [chartMap]
      field_simp [hk.1.ne']
    · rfl
  have hkj : k ≤ j := (lt_of_not_ge hjk).le
  by_cases hkt : k ≤ j * τ
  · have htpos : 0 < τ := by nlinarith [hk.1, hj.1]
    have hden := mul_pos hj.1 htpos
    refine ⟨.N2, (j, k / (j * τ), τ), Or.inr (Or.inl rfl),
      ⟨⟨hj.1.le, hj.2.le⟩, ⟨(div_pos hk.1 hden).le, (div_le_one hden).mpr hkt⟩, hτ⟩, ?_, hkt, hkj⟩
    refine Prod.ext ?_ ?_
    · rfl
    apply Prod.ext
    · dsimp only [chartMap]
      field_simp [hj.1.ne', htpos.ne']
    · rfl
  · have htk : j * τ ≤ k := (lt_of_not_ge hkt).le
    refine ⟨.N3, (j, k / j, j * τ / k), Or.inr (Or.inr rfl),
      ⟨⟨hj.1.le, hj.2.le⟩, ⟨(div_pos hk.1 hj.1).le, (div_le_one hj.1).mpr hkj⟩,
        ⟨div_nonneg (mul_nonneg hj.1.le hτ.1) hk.1.le, (div_le_one hk.1).mpr htk⟩⟩, ?_, htk, hkj⟩
    refine Prod.ext ?_ ?_
    · rfl
    apply Prod.ext <;> dsimp only [chartMap] <;> field_simp [hj.1.ne', hk.1.ne']

/-- Blueprint `lem:coverage`: the four positive/boundary rows cover the whole
required domain with their stated region restrictions. -/
theorem positive_chart_coverage {j k τ : ℝ} (hj : j ∈ Set.Ioo 0 1) (hk : k ∈ Set.Ioo 0 1)
    (hτ : τ ∈ Set.Icc 0 1) :
    ∃ c x, (c = Chart.P1 ∨ c = Chart.P2 ∨ c = Chart.P3 ∨ c = Chart.B1) ∧ InUnitCube x ∧
      chartMap c x = (j, k, τ) ∧ chartRegion c (j, k, τ) := by
  by_cases hjh : j ≤ 1 / 2
  · refine ⟨.P1, (2 * j, k, τ), Or.inl rfl,
      ⟨⟨by linarith [hj.1], by linarith⟩, ⟨hk.1.le, hk.2.le⟩, hτ⟩, ?_, hjh⟩
    simp [chartMap]
  have hjh' : 1 / 2 ≤ j := (lt_of_not_ge hjh).le
  by_cases hkh : k ≤ 1 / 2
  · refine ⟨.P2, (2 * j - 1, 2 * k, τ), Or.inr (Or.inl rfl),
      ⟨⟨by linarith, by linarith [hj.2]⟩, ⟨by linarith [hk.1], by linarith⟩, hτ⟩, ?_, hjh', hkh⟩
    apply Prod.ext <;> dsimp only [chartMap]
    · ring
    · apply Prod.ext <;> ring
  have hkh' : 1 / 2 ≤ k := (lt_of_not_ge hkh).le
  have hz : chartZ j k ∈ Set.Ioo 0 1 := by
    unfold chartZ
    rw [← (chart_z_mem hj hk τ).1]
    exact (chart_z_mem hj hk τ).2
  by_cases hτz : τ ≤ chartZ j k
  · refine ⟨.P3, (j, k, τ / chartZ j k), Or.inr (Or.inr (Or.inl rfl)),
      ⟨⟨hj.1.le, hj.2.le⟩, ⟨hk.1.le, hk.2.le⟩,
        ⟨div_nonneg hτ.1 hz.1.le, (div_le_one hz.1).mpr hτz⟩⟩, ?_, hτz⟩
    refine Prod.ext ?_ ?_
    · rfl
    refine Prod.ext ?_ ?_
    · rfl
    dsimp only [chartMap]
    field_simp [hz.1.ne']
  · have hzτ : chartZ j k ≤ τ := (lt_of_not_ge hτz).le
    have hd : 0 < 1 - chartZ j k := sub_pos.mpr hz.2
    refine ⟨.B1, (2 * j - 1, 2 * k - 1, (τ - chartZ j k) / (1 - chartZ j k)),
      Or.inr (Or.inr (Or.inr rfl)),
      ⟨⟨by linarith, by linarith [hj.2]⟩, ⟨by linarith, by linarith [hk.2]⟩,
        ⟨div_nonneg (sub_nonneg.mpr hzτ) hd.le, (div_le_one hd).mpr (by linarith [hτ.2])⟩⟩,
      ?_, hjh', hkh', hzτ⟩
    have hj' : (1 + (2 * j - 1)) / 2 = j := by ring
    have hk' : (1 + (2 * k - 1)) / 2 = k := by ring
    simp only [chartMap, hj', hk']
    refine Prod.ext ?_ ?_
    · rfl
    refine Prod.ext ?_ ?_
    · rfl
    field_simp [hd.ne']
    <;> ring

/-- Blueprint `lem:chart-domain`, additional restrictions in Table 6. -/
def chartRestrictions (c : Chart) (x : ℝ × ℝ × ℝ) : Prop :=
  match c with
  | .N1 | .P1 => 0 < x.1 ∧ x.2.1 ∈ Set.Ioo 0 1
  | .N2 => x.1 ∈ Set.Ioo 0 1 ∧ 0 < x.2.1 ∧ 0 < x.2.2
  | .N3 => x.1 ∈ Set.Ioo 0 1 ∧ 0 < x.2.1
  | .P2 => x.1 < 1 ∧ 0 < x.2.1
  | .P3 => x.1 ∈ Set.Ioo 0 1 ∧ x.2.1 ∈ Set.Ioo 0 1
  | .B1 => x.1 < 1 ∧ x.2.1 < 1

/-- Blueprint `lem:chart-domain`: interior old spatial coordinates force the
listed restrictions, even when new coordinates lie on a face. -/
theorem chart_restrictions (c : Chart) {x : ℝ × ℝ × ℝ} (hx : InUnitCube x)
    (hj : (chartMap c x).1 ∈ Set.Ioo 0 1)
    (hk : (chartMap c x).2.1 ∈ Set.Ioo 0 1) : chartRestrictions c x := by
  rcases x with ⟨j, k, τ⟩
  rcases hx with ⟨⟨hj0, hj1⟩, ⟨hk0, hk1⟩, ⟨ht0, ht1⟩⟩
  cases c <;> simp only [chartMap, Set.mem_Ioo, chartRestrictions] at hj hk ⊢
  · exact ⟨by nlinarith [hj.1], hk⟩
  · refine ⟨hj, ?_, ?_⟩
    · by_contra h
      have : k = 0 := le_antisymm (not_lt.mp h) hk0
      simp [this] at hk
    · by_contra h
      have : τ = 0 := le_antisymm (not_lt.mp h) ht0
      simp [this] at hk
  · exact ⟨hj, by nlinarith [hk.1]⟩
  · exact ⟨by linarith [hj.1], hk⟩
  · exact ⟨by linarith [hj.2], by linarith [hk.1]⟩
  · exact ⟨hj, hk⟩
  · exact ⟨by linarith [hj.2], by linarith [hk.2]⟩

/-- The final monomial factors in the blueprint's chart table. -/
def chartMonomial (c : Chart) (x : ℝ × ℝ × ℝ) : ℝ :=
  match c with
  | .N1 | .P3 => x.2.1 ^ 2
  | .N2 => x.1 ^ 2 * x.2.2 ^ 2
  | .N3 => x.1 ^ 2 * x.2.1 ^ 2
  | .P1 | .P2 | .B1 => 1

/-- Blueprint `lem:chart-domain`: every removed monomial is strictly positive
at every point needed for the original interior domain. -/
theorem chart_monomial_pos (c : Chart) {x : ℝ × ℝ × ℝ}
    (h : chartRestrictions c x) : 0 < chartMonomial c x := by
  cases c <;> simp only [chartRestrictions, chartMonomial] at h ⊢
  · exact sq_pos_of_pos h.2.1
  · exact mul_pos (sq_pos_of_pos h.1.1) (sq_pos_of_pos h.2.2)
  · exact mul_pos (sq_pos_of_pos h.1.1) (sq_pos_of_pos h.2)
  · norm_num
  · norm_num
  · exact sq_pos_of_pos h.2.1
  · norm_num

private theorem mul_mem_open_unit {a b : ℝ} (ha : a ∈ Set.Ioo 0 1)
    (hb : b ∈ Set.Ioo 0 1) : a * b ∈ Set.Ioo 0 1 :=
  ⟨mul_pos ha.1 hb.1, lt_trans (mul_lt_of_lt_one_right ha.1 hb.2) ha.2⟩

private theorem chartZ_mem {j k : ℝ} (hj : j ∈ Set.Ioo 0 1)
    (hk : k ∈ Set.Ioo 0 1) : chartZ j k ∈ Set.Ioo 0 1 :=
  mul_mem_open_unit (rationalV_mem hj) (rationalV_mem hk)

/-- Blueprint `lem:chart-domain`: the open new cube maps into the interior
spatial square, the closed time interval, and the indicated old region. -/
theorem chart_open_domain (c : Chart) {j k τ : ℝ}
    (hj : j ∈ Set.Ioo 0 1) (hk : k ∈ Set.Ioo 0 1) (ht : τ ∈ Set.Ioo 0 1) :
    (chartMap c (j, k, τ)).1 ∈ Set.Ioo 0 1 ∧
    (chartMap c (j, k, τ)).2.1 ∈ Set.Ioo 0 1 ∧
    (chartMap c (j, k, τ)).2.2 ∈ Set.Icc 0 1 ∧
    chartRegion c (chartMap c (j, k, τ)) := by
  have hjk := mul_mem_open_unit hj hk
  have hkt := mul_mem_open_unit hk ht
  have hjkt := mul_mem_open_unit hjk ht
  have hjhalf : j / 2 ∈ Set.Ioo 0 1 := ⟨by linarith [hj.1], by linarith [hj.2]⟩
  have hkhalf : k / 2 ∈ Set.Ioo 0 1 := ⟨by linarith [hk.1], by linarith [hk.2]⟩
  have hjupper : (1 + j) / 2 ∈ Set.Ioo 0 1 := ⟨by linarith [hj.1], by linarith [hj.2]⟩
  have hkupper : (1 + k) / 2 ∈ Set.Ioo 0 1 := ⟨by linarith [hk.1], by linarith [hk.2]⟩
  cases c <;> simp only [chartMap, chartRegion]
  · exact ⟨mul_mem_open_unit hk hj, hk, ⟨ht.1.le, ht.2.le⟩,
      (mul_lt_of_lt_one_right hk.1 hj.2).le⟩
  · refine ⟨hj, hjkt, ⟨ht.1.le, ht.2.le⟩, ?_, ?_⟩
    · nlinarith [mul_pos hj.1 ht.1, mul_pos (mul_pos hj.1 ht.1) (sub_pos.mpr hk.2)]
    · exact (lt_trans (mul_lt_of_lt_one_right hjk.1 ht.2)
        (mul_lt_of_lt_one_right hj.1 hk.2)).le
  · refine ⟨hj, hjk, ⟨hkt.1.le, hkt.2.le⟩, ?_,
      (mul_lt_of_lt_one_right hj.1 hk.2).le⟩
    nlinarith [mul_lt_of_lt_one_right hjk.1 ht.2]
  · exact ⟨hjhalf, hk, ⟨ht.1.le, ht.2.le⟩, by linarith [hj.2]⟩
  · exact ⟨hjupper, hkhalf, ⟨ht.1.le, ht.2.le⟩,
      by linarith [hj.1], by linarith [hk.2]⟩
  · have hz := chartZ_mem hj hk
    have hzt := mul_mem_open_unit hz ht
    exact ⟨hj, hk, ⟨hzt.1.le, hzt.2.le⟩,
      (mul_lt_of_lt_one_right hz.1 ht.2).le⟩
  · have hz := chartZ_mem hjupper hkupper
    have hp := mul_pos (sub_pos.mpr hz.2) ht.1
    have hlt := mul_lt_of_lt_one_right (sub_pos.mpr hz.2) ht.2
    exact ⟨hjupper, hkupper, ⟨by linarith [hz.1], by linarith⟩,
      by linarith [hj.1], by linarith [hk.1], by linarith⟩

/-- The rational spatial parametrization has a positive denominator everywhere. -/
theorem continuous_rationalV : Continuous rationalV := by
  unfold rationalV
  fun_prop (disch := intro x; positivity)

/-- Blueprint `lem:chart-domain`: all chart maps are continuous, hence their
restrictions to the line segments used for sign recovery are continuous. -/
theorem continuous_chartMap (c : Chart) : Continuous (chartMap c) := by
  have hz : Continuous (fun x : ℝ × ℝ => chartZ x.1 x.2) :=
    (continuous_rationalV.comp continuous_fst).mul (continuous_rationalV.comp continuous_snd)
  cases c <;> unfold chartMap <;> fun_prop

local infixl:65 " +ᵣ " => rationalAdd
local infixl:65 " -ᵣ " => ratSub
local infixl:70 " *ᵣ " => rationalMul
local infixr:80 " ^ᵣ " => rationalPow

theorem rationalEval_const (n : ℤ) (x : ℝ × ℝ × ℝ) : rationalEval (ratConst n) x = n := by
  rw [ratConst, rationalEval_ofPolynomial, polyEval_const]

theorem rationalEval_sub (p q : RationalPolynomial) (x : ℝ × ℝ × ℝ) :
    rationalEval (ratSub p q) x = rationalEval p x - rationalEval q x := by
  simp [ratSub, rationalEval_add, rationalEval_neg, sub_eq_add_neg]

theorem rationalEval_inputs (x : ℝ × ℝ × ℝ) :
    rationalEval ratV x = rationalV x.1 ∧ rationalEval ratY x = rationalV x.2.1 ∧
    rationalEval ratRho x = rationalRoot x.1 ∧ rationalEval ratSigma x = rationalRoot x.2.1 := by
  simp [ratV, ratY, ratRho, ratSigma, rationalEval, polyEval_scale, polyEval_add,
    polyEval_neg, polyEval_const, polyEval_pow, (polyEval_variables x).1,
    (polyEval_variables x).2.1, rationalV, rationalRoot, sub_eq_add_neg]

theorem rationalEval_time (c : CertificateCase) (x : ℝ × ℝ × ℝ) :
    rationalEval (ratTime c) x = certificateSign c * x.2.2 := by
  cases c <;> simp [ratTime, certificateSign, rationalEval_neg, rationalEval_ofPolynomial,
    (polyEval_variables x).2.2]

/-- The integer expression for K evaluates to precisely the source rational function. -/
theorem rationalEval_K (c : CertificateCase) (x : ℝ × ℝ × ℝ) :
    rationalEval (ratK c) x = rationalK c x.1 x.2.1 x.2.2 := by
  cases c <;> simp [ratK, rationalEval_sub, rationalEval_add, rationalEval_mul,
    rationalEval_pow, rationalEval_const, rationalEval_divNat, rationalEval_time,
    (rationalEval_inputs x).1, (rationalEval_inputs x).2.1, rationalK, rootK, Mminus, Mplus]

/-- The integer expression for Q evaluates to precisely the source rational function. -/
theorem rationalEval_Q (c : CertificateCase) (x : ℝ × ℝ × ℝ) :
    rationalEval (ratQ c) x = rationalQ c x.1 x.2.1 x.2.2 := by
  simp [ratQ, rationalEval_sub, rationalEval_mul, rationalEval_pow, rationalEval_const,
    rationalEval_time, (rationalEval_inputs x).1, (rationalEval_inputs x).2.1,
    (rationalEval_inputs x).2.2.1, (rationalEval_inputs x).2.2.2, rationalQ, rootQ]

/-- The fixed arithmetic tree for F is connected to (Fpm) or (Fb), not merely
to an unrelated polynomial with similar coefficient data. -/
theorem rationalEval_F (c : CertificateCase) (x : ℝ × ℝ × ℝ) :
    rationalEval (ratF c) x = rationalF c x.1 x.2.1 x.2.2 := by
  cases c <;> simp [ratF, rationalEval_sub, rationalEval_add, rationalEval_mul,
    rationalEval_pow, rationalEval_const, rationalEval_divNat, rationalEval_time,
    rationalEval_K, (rationalEval_inputs x).1, (rationalEval_inputs x).2.1,
    (rationalEval_inputs x).2.2.1, (rationalEval_inputs x).2.2.2, rationalF, rootF, rationalK]

theorem rationalEval_gap (c : CertificateCase) (x : ℝ × ℝ × ℝ) :
    rationalEval (ratGap c) x = rationalF c x.1 x.2.1 x.2.2 ^ 2 -
      rationalK c x.1 x.2.1 x.2.2 ^ 2 * rationalQ c x.1 x.2.1 x.2.2 := by
  simp [ratGap, rationalEval_sub, rationalEval_pow, rationalEval_mul,
    rationalEval_F, rationalEval_K, rationalEval_Q]

/-- Linear merge for the candidate division loop. The final reconstruction
check supplies soundness even if candidate inputs were not normalized. -/
def divisionMerge : IntPolynomial → IntPolynomial → IntPolynomial
  | [], q => q
  | p, [] => p
  | (e, c) :: p, (f, d) :: q =>
    if exponentGreater e f then (e, c) :: divisionMerge p ((f, d) :: q)
    else if e = f then
      if c + d = 0 then divisionMerge p q else (e, c + d) :: divisionMerge p q
    else (f, d) :: divisionMerge ((e, c) :: p) q
termination_by p q => p.length + q.length

/-- Blueprint `spec:divide`: bounded leading-term division. Its output remains
an untrusted candidate until the separate reconstruction check succeeds. -/
def polyDivideAux : ℕ → IntPolynomial → IntPolynomial → IntPolynomial → Option IntPolynomial
  | 0, _, _, _ => none
  | _ + 1, [], _, acc => some (polyNormalize acc)
  | fuel + 1, (e, c) :: p, q, acc =>
    match q with
    | [] => none
    | (f, d) :: _ =>
      if f ≤ e ∧ d ≠ 0 ∧ c % d = 0 then
        let shift : Exponent := (e.1 - f.1, e.2.1 - f.2.1, e.2.2 - f.2.2)
        let coefficient := c / d
        let subtractor := q.map fun t => (shift + t.1, -(coefficient * t.2))
        polyDivideAux fuel (divisionMerge ((e, c) :: p) subtractor) q ((shift, coefficient) :: acc)
      else none

/-- Blueprint `spec:divide`: total, reconstruction-checked quotient generation. -/
def polyDivide (p q : IntPolynomial) : Option IntPolynomial := do
  let candidate ← polyDivideAux 100000 (polyNormalize p) (polyNormalize q) []
  if polyDivisionCheck p q candidate then some candidate else none

/-- No property of the candidate-generation algorithm is trusted for division. -/
theorem polyDivide_sound {p q h : IntPolynomial} (hs : polyDivide p q = some h) :
    polyDivisionCheck p q h = true := by
  unfold polyDivide at hs
  simp only [bind, Option.bind] at hs
  split at hs
  · simp_all
  · dsimp only at hs
    split at hs <;> simp_all

/-- Blueprint `def:basepoly`: numerator conversion with the prescribed product
denominator and an explicit failure result. -/
def rationalConvert (p : RationalPolynomial) (d a b : ℕ) : Option IntPolynomial := do
  let lhs := polyMul (polyMul (polyScale (d : ℤ) p.numerator)
    (polyPow polyA0 (max p.a a - p.a))) (polyPow polyB0 (max p.b b - p.b))
  let divisor := polyMul (polyScale (p.denominator : ℤ) (polyPow polyA0 (max p.a a - a)))
    (polyPow polyB0 (max p.b b - b))
  let candidate ← polyDivide lhs divisor
  if rationalConversionCheck p candidate d a b then some candidate else none

/-- The conversion checker explicitly verifies success and reconstruction. -/
theorem rationalConvert_sound {p : RationalPolynomial} {d a b : ℕ} {F : IntPolynomial}
    (hs : rationalConvert p d a b = some F) : rationalConversionCheck p F d a b = true := by
  unfold rationalConvert at hs
  dsimp only at hs
  simp only [bind, Option.bind] at hs
  split at hs
  · simp_all
  · dsimp only at hs
    split at hs <;> simp_all

theorem rationalConvertCandidate_sound {p : RationalPolynomial} {candidate F : IntPolynomial}
    {d a b : ℕ} (h : rationalConvertCandidate p candidate d a b = some F) :
    rationalConversionCheck p F d a b = true := by
  unfold rationalConvertCandidate at h
  split at h <;> simp_all

theorem polyDivideCandidate_sound {p q candidate h : IntPolynomial}
    (hs : polyDivideCandidate p q candidate = some h) : polyDivisionCheck p q h = true := by
  unfold polyDivideCandidate at hs
  split at hs <;> simp_all

theorem mem_exponentList (e n : Exponent) : e ∈ exponentList n ↔ e ≤ n := by
  rcases e with ⟨i, j, k⟩
  simp [exponentList, Nat.lt_succ_iff, Prod.le_def]

/-- Sparse initialization equals the source's complete zero-padded box. -/
theorem coefficientSeed_eq_padded (p : IntPolynomial) (n : Exponent) :
    coefficientSeed p n = coefficientArray n (paddedCoefficients p n) := by
  rw [coefficientSeed_eq]
  apply coefficientArray_congr
  intro β hβ
  simp [paddedCoefficients, hβ]

def cachedBernstein (p : IntPolynomial) (n : Exponent) : Exponent → ℤ :=
  coefficientLookup (bernsteinArray p n)

/-- All cached entries are the actual coefficients, by induction over the three
passes and their checked input boxes. -/
theorem cachedBernstein_eq (p : IntPolynomial) (n β : Exponent) (hβ : β ≤ n) :
    cachedBernstein p n β = bernsteinCoefficient p n β := by
  unfold cachedBernstein bernsteinArray
  rw [coefficientSeed_eq_padded]
  change cacheBox n (bernsteinPass3 n (cacheBox n (bernsteinPass2 n
    (cacheBox n (bernsteinPass1 n (cacheBox n (paddedCoefficients p n))))))) β = _
  rw [cacheBox_eq _ _ _ hβ, ← bernsteinTransform_eq_coefficient p n β hβ]
  apply bernsteinPass3_congr _ hβ
  intro γ hγ
  rw [cacheBox_eq _ _ _ hγ]
  apply bernsteinPass2_congr _ hγ
  intro δ hδ
  rw [cacheBox_eq _ _ _ hδ]
  apply bernsteinPass1_congr _ hδ
  exact cacheBox_eq n (paddedCoefficients p n)

/-- Blueprint `lem:check-sound`: Boolean conjunction reflects every list entry. -/
theorem all_check_sound {α : Type*} (l : List α) (f : α → Bool) :
    l.all f = true ↔ ∀ a ∈ l, f a = true := by
  induction l with
  | nil => simp
  | cons a l ih => simp [ih]

theorem supportCheck_sound {p : IntPolynomial} {n : Exponent}
    (h : supportCheck p n = true) : polyBound p n := by
  simpa [supportCheck, all_check_sound, polyBound] using h

/-- Checked transform signs are signs of the actual Bernstein coefficients. -/
theorem coefficientCheck_sound {p : IntPolynomial} {n : Exponent}
    (hp : polyBound p n) (h : coefficientCheck p n = true) :
    ∀ β ∈ exponentBox n, 0 ≤ bernsteinCoefficient p n β := by
  intro β hβ
  have hn := (mem_exponentBox β n).mp hβ
  have hb := (all_check_sound _ _).mp h β ((mem_exponentList β n).mpr hn)
  have he := cachedBernstein_eq p n β hn
  exact he ▸ of_decide_eq_true hb

theorem witnessCheck_sound {p : IntPolynomial} {n : Exponent} {w : List (Exponent × ℤ)}
    (hp : polyBound p n) (h : witnessCheck p n w = true) :
    ∀ t ∈ w, t.1 ∈ exponentBox n ∧ 0 < t.2 ∧ bernsteinCoefficient p n t.1 = t.2 := by
  intro t ht
  have hc : t.1 ≤ n ∧ 0 < t.2 ∧ cachedBernstein p n t.1 = t.2 :=
    of_decide_eq_true ((all_check_sound _ _).mp h t ht)
  exact ⟨(mem_exponentBox _ _).mpr hc.1, hc.2.1,
    (cachedBernstein_eq p n t.1 hc.1).symm.trans hc.2.2⟩

/-- Blueprint `lem:check-sound`: the entire row check yields ordinary
propositions about the fixed generators and all actual Bernstein coefficients. -/
theorem chartCheck_sound (c : Chart) (h : chartCheck c = true) :
    (baseFResult (chartCase c)).isSome = true ∧
    (baseHResult (chartCase c)).isSome = true ∧
    (chartPolynomialResult c).isSome = true ∧
    polyDegree (baseF (chartCase c)) = baseFDegree (chartCase c) ∧
    polyDegree (baseH (chartCase c)) = baseHDegree (chartCase c) ∧
    polyBound (chartPolynomial c) (chartDegree c) ∧
    (∀ β ∈ exponentBox (chartDegree c),
      0 ≤ bernsteinCoefficient (chartPolynomial c) (chartDegree c) β) ∧
    coefficientCounts (chartPolynomial c) (chartDegree c) = chartCounts c ∧
    (∀ t ∈ chartWitnesses c, t.1 ∈ exponentBox (chartDegree c) ∧ 0 < t.2 ∧
      bernsteinCoefficient (chartPolynomial c) (chartDegree c) t.1 = t.2) ∧
    homogeneousEval (baseF (chartCase c)) (baseFDegree (chartCase c))
      (chartCenterData c).1 (chartCenterData c).2.1 = (chartCenterData c).2.2 := by
  simp only [chartCheck, Bool.and_eq_true, decide_eq_true_eq, and_assoc] at h
  rcases h with ⟨hf, hh, hc, hfd, hhd, hs, hb, hn, hw, he⟩
  have hp := supportCheck_sound hs
  exact ⟨hf, hh, hc, hfd, hhd, hp, coefficientCheck_sound hp hb, hn,
    witnessCheck_sound hp hw, he⟩

/-- Successful F generation reconstructs the precise prescribed rational expression. -/
theorem baseF_reconstruction (c : CertificateCase) (h : (baseFResult c).isSome = true)
    (x : ℝ × ℝ × ℝ) :
    polyEval (baseF c) x /
      ((baseDenominator c).1 * (1 + x.1 ^ 2) ^ (baseDenominator c).2.1 *
        (1 + x.2.1 ^ 2) ^ (baseDenominator c).2.2) = rationalF c x.1 x.2.1 x.2.2 := by
  have hs : baseFResult c = some (baseF c) := by
    cases he : baseFResult c <;> simp_all [baseF]
  rw [baseFResult_eq_generate] at hs
  have hd : 0 < (baseDenominator c).1 := by cases c <;> decide
  exact (rationalConversionCheck_sound _ _ _ _ _ hd (rationalConvertCandidate_sound hs) x).trans
    (rationalEval_F c x)

/-- Successful H generation reconstructs the exact squared gap with the square
of the prescribed denominator. -/
theorem baseH_reconstruction (c : CertificateCase) (h : (baseHResult c).isSome = true)
    (x : ℝ × ℝ × ℝ) :
    polyEval (baseH c) x /
      (((baseDenominator c).1 : ℝ) ^ 2 * (1 + x.1 ^ 2) ^ (2 * (baseDenominator c).2.1) *
        (1 + x.2.1 ^ 2) ^ (2 * (baseDenominator c).2.2)) =
      rationalF c x.1 x.2.1 x.2.2 ^ 2 - rationalK c x.1 x.2.1 x.2.2 ^ 2 *
        rationalQ c x.1 x.2.1 x.2.2 := by
  have hs : baseHResult c = some (baseH c) := by
    cases he : baseHResult c <;> simp_all [baseH]
  rw [baseHResult_eq_generate] at hs
  have hd : 0 < (baseDenominator c).1 ^ 2 := by cases c <;> decide
  have he := (rationalConversionCheck_sound _ _ _ _ _ hd (rationalConvertCandidate_sound hs) x).trans
    (rationalEval_gap c x)
  simpa only [Nat.cast_pow] using he

/-- The center coordinates in the expected-data table are the exact chart images. -/
theorem chart_center_image (c : Chart) :
    chartMap c (1 / 2, 1 / 2, 1 / 2) =
      (((chartCenterData c).1.1 : ℝ) / (chartCenterData c).2.1.1,
        ((chartCenterData c).1.2.1 : ℝ) / (chartCenterData c).2.1.2.1,
        ((chartCenterData c).1.2.2 : ℝ) / (chartCenterData c).2.1.2.2) := by
  cases c <;> norm_num [chartMap, chartZ, rationalV, chartCenterData]

