/-- Blueprint `lem:chart-strict`: a prescribed witness has positive Bernstein basis
on every required face, including zero or unit time and spatial boundary faces. -/
theorem chart_positive_witness (c : Chart) {x : ℝ × ℝ × ℝ}
    (hx : InUnitCube x) (hr : chartRestrictions c x) :
    ∃ t ∈ chartWitnesses c, 0 < bernsteinBasis (chartDegree c) t.1 x := by
  rcases x with ⟨j, k, τ⟩
  have ht0 : 0 ≤ τ := hx.2.2.1
  cases c with
  | N1 =>
    rcases hr with ⟨hj, hk0, hk1⟩
    have hsk : 0 < 1 - k := sub_pos.mpr hk1
    by_cases ht : τ = 0
    · refine ⟨((20, 1, 0), 12600), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree, ht]
      positivity
    · have htpos : 0 < τ := lt_of_le_of_ne ht0 (Ne.symm ht)
      refine ⟨((20, 1, 4), 25200), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree]
      positivity
  | N2 =>
    rcases hr with ⟨⟨hj0, hj1⟩, hk, ht⟩
    have hsj : 0 < 1 - j := sub_pos.mpr hj1
    refine ⟨((1, 24, 24), 25200), by simp [chartWitnesses], ?_⟩
    norm_num [bernsteinBasis, chartDegree]
    positivity
  | N3 =>
    rcases hr with ⟨⟨hj0, hj1⟩, hk⟩
    have hsj : 0 < 1 - j := sub_pos.mpr hj1
    by_cases ht : τ = 0
    · refine ⟨((1, 24, 0), 12600), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree, ht]
      positivity
    · have htpos : 0 < τ := lt_of_le_of_ne ht0 (Ne.symm ht)
      refine ⟨((1, 24, 4), 25200), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree]
      positivity
  | P1 =>
    rcases hr with ⟨hj, hk0, hk1⟩
    have hsk : 0 < 1 - k := sub_pos.mpr hk1
    by_cases ht : τ = 0
    · refine ⟨((24, 2, 0), 109335937500), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree, ht]
      positivity
    · have htpos : 0 < τ := lt_of_le_of_ne ht0 (Ne.symm ht)
      refine ⟨((24, 2, 4), 8254492187500), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree]
      positivity
  | P2 =>
    rcases hr with ⟨hj1, hk⟩
    have hsj : 0 < 1 - j := sub_pos.mpr hj1
    by_cases ht : τ = 0
    · refine ⟨((0, 24, 0), 3658583003906250000), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree, ht]
      positivity
    · have htpos : 0 < τ := lt_of_le_of_ne ht0 (Ne.symm ht)
      refine ⟨((0, 24, 4), 325224219836275200), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree]
      positivity
  | P3 =>
    rcases hr with ⟨⟨hj0, hj1⟩, hk0, hk1⟩
    have hsj : 0 < 1 - j := sub_pos.mpr hj1
    have hsk : 0 < 1 - k := sub_pos.mpr hk1
    by_cases ht : τ = 0
    · refine ⟨((1, 1, 0), 288000), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree, ht]
      positivity
    · have htpos : 0 < τ := lt_of_le_of_ne ht0 (Ne.symm ht)
      refine ⟨((1, 1, 4), 288000), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree]
      positivity
  | B1 =>
    rcases hr with ⟨hj1, hk1⟩
    have hsj : 0 < 1 - j := sub_pos.mpr hj1
    have hsk : 0 < 1 - k := sub_pos.mpr hk1
    by_cases ht : τ = 0
    · refine ⟨((0, 0, 0), 338787737221858106544), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree, ht]
      positivity
    · have htpos : 0 < τ := lt_of_le_of_ne ht0 (Ne.symm ht)
      refine ⟨((0, 0, 4), 62644543774312500000), by simp [chartWitnesses], ?_⟩
      norm_num [bernsteinBasis, chartDegree]
      positivity

/-- Blueprint `lem:chart-strict`: the transformed polynomial is strictly positive
on the closed cube whenever both old spatial coordinates are interior. -/
theorem chart_strict (c : Chart) {x : ℝ × ℝ × ℝ} (hx : InUnitCube x)
    (hj : (chartMap c x).1 ∈ Set.Ioo 0 1)
    (hk : (chartMap c x).2.1 ∈ Set.Ioo 0 1) :
    0 < polyEval (chartPolynomial c) x := by
  rcases chartCheck_sound c (finite_certificate c).1 with
    ⟨_, _, _, _, _, hp, hc, _, hw, _⟩
  obtain ⟨t, ht, hpos⟩ := chart_positive_witness c hx (chart_restrictions c hx hj hk)
  rcases hw t ht with ⟨hbox, hv, he⟩
  exact polyEval_pos_of_bernstein hp hc hx t.1 hbox (by rw [he]; exact hv) hpos

/-- Blueprint `lem:disc-positive`: recover positivity before a checked division. -/
theorem polyDivideCandidate_positive {p q candidate h : IntPolynomial}
    (hs : polyDivideCandidate p q candidate = some h) (x : ℝ × ℝ × ℝ)
    (hq : 0 < polyEval q x) (hh : 0 < polyEval h x) : 0 < polyEval p x := by
  rw [polyDivisionCheck_sound (polyDivideCandidate_sound hs) x]
  exact mul_pos hq hh

/-- Blueprint `lem:disc-positive`: remove the positive power-of-two multiplier. -/
theorem positive_of_halfSubstitute {p : IntPolynomial} (i : Fin 3) (δ : ℤ)
    (x : ℝ × ℝ × ℝ) (h : 0 < polyEval (polyHalfSubstitute p i δ) x) :
    0 < polyEval p (tripleReplace x i ((tripleCoordinate x i + δ) / 2)) := by
  rw [polyEval_halfSubstitute] at h
  exact (mul_pos_iff_of_pos_left (pow_pos (by norm_num : (0 : ℝ) < 2) _)).mp h

/-- Blueprint `lem:disc-positive`: remove the positive denominator power. -/
theorem positive_of_clearSubstitute {p : IntPolynomial} (U D : IntPolynomial)
    (x : ℝ × ℝ × ℝ) (hD : 0 < polyEval D x)
    (h : 0 < polyEval (polyClearSubstitute p U D (polyDegree p).2.2) x) :
    0 < polyEval p (x.1, x.2.1, polyEval U x / polyEval D x) := by
  rw [polyEval_clearSubstitute U D (fun t ht => (polyBound_degree p t ht).2.2) x hD.ne'] at h
  exact (mul_pos_iff_of_pos_left (pow_pos hD _)).mp h

/-- Blueprint `lem:finite-certificate`: expose the successful generator without
unfolding the closed certificate computations. -/
theorem chart_generator_success (c : Chart) :
    chartPolynomialGenerate c = some (chartPolynomial c) := by
  have hc := (chartCheck_sound c (finite_certificate c).1).2.2.1
  have he : chartPolynomialGenerate c = chartPolynomialResult c := by cases c <;> rfl
  rw [he]
  cases hs : chartPolynomialResult c <;> simp_all [chartPolynomial]

/-- Blueprint `lem:disc-positive`: reverse each negative monomial chart. -/
theorem negative_baseH_positive (c : Chart)
    (hc : c = .N1 ∨ c = .N2 ∨ c = .N3)
    {x : ℝ × ℝ × ℝ} (hx : InUnitCube x)
    (hj : (chartMap c x).1 ∈ Set.Ioo 0 1)
    (hk : (chartMap c x).2.1 ∈ Set.Ioo 0 1) :
    0 < polyEval (baseH (chartCase c)) (chartMap c x) := by
  have hp := chart_strict c hx hj hk
  have hr := chart_restrictions c hx hj hk
  have hs := chart_generator_success c
  unfold chartPolynomialGenerate at hs
  obtain ⟨h, hh, hs⟩ := Option.bind_eq_some_iff.mp hs
  have he : baseH (chartCase c) = h := by simp [baseH, hh]
  rw [he]
  rcases hc with rfl | rfl | rfl
  · have hq : 0 < polyEval (polyPow polyK 2) x := by
      rw [polyEval_pow, (polyEval_variables x).2.1]
      exact sq_pos_of_pos hr.2.1
    have ht := polyDivideCandidate_positive hs x hq hp
    simpa [polyEval_monomialSubstitute, monomialEval, chartMap, mul_comm] using ht
  · have hq : 0 < polyEval (polyMul (polyPow polyJ 2) (polyPow polyTau 2)) x := by
      rw [polyEval_mul, polyEval_pow, polyEval_pow,
        (polyEval_variables x).1, (polyEval_variables x).2.2]
      exact mul_pos (sq_pos_of_pos hr.1.1) (sq_pos_of_pos hr.2.2)
    have ht := polyDivideCandidate_positive hs x hq hp
    simpa [polyEval_monomialSubstitute, monomialEval, chartMap, mul_comm] using ht
  · have hq : 0 < polyEval (polyMul (polyPow polyJ 2) (polyPow polyK 2)) x := by
      rw [polyEval_mul, polyEval_pow, polyEval_pow,
        (polyEval_variables x).1, (polyEval_variables x).2.1]
      exact mul_pos (sq_pos_of_pos hr.1.1) (sq_pos_of_pos hr.2)
    have ht := polyDivideCandidate_positive hs x hq hp
    simpa [polyEval_monomialSubstitute, monomialEval, chartMap, mul_comm] using ht

/-- Blueprint `lem:disc-positive`: the cleared positive time coordinate. -/
theorem positive_clear_point (x : ℝ × ℝ × ℝ) :
    (x.1, x.2.1, polyEval (polyMul polyN0 polyTau) x / polyEval polyD0 x) =
      chartMap .P3 x := by
  change (_, _, _) = (x.1, x.2.1, chartZ x.1 x.2.1 * x.2.2)
  apply congrArg (fun t : ℝ => (x.1, x.2.1, t))
  simp only [polyEval_mul, (polyEval_variables x).2.2,
    (chart_factor_evaluations x).1, (chart_factor_evaluations x).2.1,
    chartZ, rationalV]
  field_simp
  <;> ring

/-- Blueprint `lem:disc-positive`: the cleared boundary time coordinate. -/
theorem boundary_clear_point (y : ℝ × ℝ × ℝ) :
    (y.1, y.2.1,
      polyEval (polyAdd polyN0 (polyMul polyPminus polyTau)) y / polyEval polyD0 y) =
      (y.1, y.2.1, chartZ y.1 y.2.1 + (1 - chartZ y.1 y.2.1) * y.2.2) := by
  apply congrArg (fun t : ℝ => (y.1, y.2.1, t))
  have hjd : 1 + y.1 ^ 2 ≠ 0 := by positivity
  have hkd : 1 + y.2.1 ^ 2 ≠ 0 := by positivity
  simp only [polyEval_add, polyEval_mul, (polyEval_variables y).2.2,
    (chart_factor_evaluations y).2.2.1,
    (chart_factor_evaluations y).1, (chart_factor_evaluations y).2.1,
    chartZ, rationalV]
  field_simp
  <;> ring

/-- Blueprint `lem:disc-positive`: reverse the positive and boundary charts,
restoring the boundary factor at the half-substituted spatial coordinates. -/
theorem positive_baseH_positive (c : Chart)
    (hc : c = .P1 ∨ c = .P2 ∨ c = .P3 ∨ c = .B1)
    {x : ℝ × ℝ × ℝ} (hx : InUnitCube x)
    (hj : (chartMap c x).1 ∈ Set.Ioo 0 1)
    (hk : (chartMap c x).2.1 ∈ Set.Ioo 0 1) :
    0 < polyEval (baseH (chartCase c)) (chartMap c x) := by
  have hp := chart_strict c hx hj hk
  have hr := chart_restrictions c hx hj hk
  have hs := chart_generator_success c
  unfold chartPolynomialGenerate at hs
  obtain ⟨h, hh, hs⟩ := Option.bind_eq_some_iff.mp hs
  have he : baseH (chartCase c) = h := by simp [baseH, hh]
  rw [he]
  have hP0 : 0 < polyEval polyP0 (chartMap c x) :=
    (chart_factors_pos hj hk (chartMap c x).2.2).2.2.2.2.2.2
  rcases hc with rfl | rfl | rfl | rfl
  · obtain ⟨p, hdiv, hlast⟩ := Option.bind_eq_some_iff.mp hs
    have hhalf := polyDivideCandidate_positive hlast x (by simp [polyEval_const]) hp
    have hpos := positive_of_halfSubstitute 0 0 x hhalf
    have hpos' : 0 < polyEval p (chartMap .P1 x) := by
      simpa [tripleReplace, tripleCoordinate, chartMap] using hpos
    exact polyDivideCandidate_positive hdiv _ hP0 hpos'
  · obtain ⟨p, hdiv, hlast⟩ := Option.bind_eq_some_iff.mp hs
    have hhalf := polyDivideCandidate_positive hlast x (by simp [polyEval_const]) hp
    have hkhalf := positive_of_halfSubstitute 1 0 x hhalf
    have hjhalf := positive_of_halfSubstitute 0 1 _ hkhalf
    have hpos : 0 < polyEval p (chartMap .P2 x) := by
      simpa [tripleReplace, tripleCoordinate, chartMap, add_comm] using hjhalf
    exact polyDivideCandidate_positive hdiv _ hP0 hpos
  · obtain ⟨p, hdiv, hlast⟩ := Option.bind_eq_some_iff.mp hs
    have hq : 0 < polyEval (polyPow polyK 2) x := by
      rw [polyEval_pow, (polyEval_variables x).2.1]
      exact sq_pos_of_pos hr.2.1
    have hclear := polyDivideCandidate_positive hlast x hq hp
    have hD := (chart_factors_pos hr.1 hr.2 x.2.2).2.2.1
    have hpos := positive_of_clearSubstitute (polyMul polyN0 polyTau) polyD0 x hD hclear
    rw [positive_clear_point] at hpos
    exact polyDivideCandidate_positive hdiv _ hP0 hpos
  · obtain ⟨p, hdiv, hrest⟩ := Option.bind_eq_some_iff.mp hs
    obtain ⟨q, hmiddle, hlast⟩ := Option.bind_eq_some_iff.mp hrest
    have hhalf := polyDivideCandidate_positive hlast x (by simp [polyEval_const]) hp
    have hkhalf := positive_of_halfSubstitute 1 1 x hhalf
    have hjhalf := positive_of_halfSubstitute 0 1 _ hkhalf
    let y : ℝ × ℝ × ℝ := ((1 + x.1) / 2, (1 + x.2.1) / 2, x.2.2)
    have hq : 0 < polyEval q y := by
      simpa [y, tripleReplace, tripleCoordinate, add_comm] using hjhalf
    have hyj : y.1 ∈ Set.Ioo 0 1 := hj
    have hyk : y.2.1 ∈ Set.Ioo 0 1 := hk
    have hf := chart_factors_pos hyj hyk y.2.2
    have hD : 0 < polyEval polyD0 y := hf.2.2.1
    have hm : 0 < polyEval (polyPow polyPminus 2) y := by
      rw [polyEval_pow]; exact sq_pos_of_pos hf.2.2.2.2.1
    have hclear := polyDivideCandidate_positive hmiddle y hm hq
    have hpos := positive_of_clearSubstitute
      (polyAdd polyN0 (polyMul polyPminus polyTau)) polyD0 y hD hclear
    rw [boundary_clear_point] at hpos
    exact polyDivideCandidate_positive hdiv _ hP0 hpos

/-- Blueprint `lem:rational`: the prescribed base-F denominator is positive. -/
theorem baseF_denominator_pos (c : CertificateCase) (x : ℝ × ℝ × ℝ) :
    0 < ((baseDenominator c).1 : ℝ) *
      (1 + x.1 ^ 2) ^ (baseDenominator c).2.1 *
      (1 + x.2.1 ^ 2) ^ (baseDenominator c).2.2 := by
  have hd : (0 : ℝ) < (baseDenominator c).1 := by cases c <;> norm_num [baseDenominator]
  positivity

/-- Blueprint `lem:rational`: the prescribed squared-gap denominator is positive. -/
theorem baseH_denominator_pos (c : CertificateCase) (x : ℝ × ℝ × ℝ) :
    0 < ((baseDenominator c).1 : ℝ) ^ 2 *
      (1 + x.1 ^ 2) ^ (2 * (baseDenominator c).2.1) *
      (1 + x.2.1 ^ 2) ^ (2 * (baseDenominator c).2.2) := by
  have hd : (0 : ℝ) < (baseDenominator c).1 := by cases c <;> norm_num [baseDenominator]
  positivity

/-- Blueprint `lem:disc-positive`: at every point represented by a required chart,
the original rational expression satisfies F² - K² Q > 0. Combined with the
coverage lemmas, this includes every required old-parameter region. -/
theorem disc_positive (c : Chart) {x : ℝ × ℝ × ℝ} (hx : InUnitCube x)
    (hj : (chartMap c x).1 ∈ Set.Ioo 0 1)
    (hk : (chartMap c x).2.1 ∈ Set.Ioo 0 1) :
    0 < rationalF (chartCase c) (chartMap c x).1 (chartMap c x).2.1 (chartMap c x).2.2 ^ 2 -
      rationalK (chartCase c) (chartMap c x).1 (chartMap c x).2.1 (chartMap c x).2.2 ^ 2 *
      rationalQ (chartCase c) (chartMap c x).1 (chartMap c x).2.1 (chartMap c x).2.2 := by
  have hp : 0 < polyEval (baseH (chartCase c)) (chartMap c x) := by
    cases c
    · exact negative_baseH_positive _ (Or.inl rfl) hx hj hk
    · exact negative_baseH_positive _ (Or.inr (Or.inl rfl)) hx hj hk
    · exact negative_baseH_positive _ (Or.inr (Or.inr rfl)) hx hj hk
    · exact positive_baseH_positive _ (Or.inl rfl) hx hj hk
    · exact positive_baseH_positive _ (Or.inr (Or.inl rfl)) hx hj hk
    · exact positive_baseH_positive _ (Or.inr (Or.inr (Or.inl rfl))) hx hj hk
    · exact positive_baseH_positive _ (Or.inr (Or.inr (Or.inr rfl))) hx hj hk
  rw [← baseH_reconstruction (chartCase c)
    (chartCheck_sound c (finite_certificate c).1).2.1 (chartMap c x)]
  exact div_pos hp (baseH_denominator_pos _ _)

/-- Blueprint `lem:Fpositive`: evaluation of a fixed integer polynomial is continuous. -/
theorem continuous_polyEval (p : IntPolynomial) : Continuous (polyEval p) := by
  induction p with
  | nil => simpa only [polyEval] using (continuous_const : Continuous (fun _ : ℝ × ℝ × ℝ => (0 : ℝ)))
  | cons t p ih =>
    change Continuous (fun x : ℝ × ℝ × ℝ => (t.2 : ℝ) * monomialEval t.1 x + polyEval p x)
    apply Continuous.add _ ih
    unfold monomialEval
    fun_prop

/-- Blueprint `lem:Fpositive`: checked reconstruction gives continuity of F. -/
theorem continuous_chartF (c : Chart) :
    Continuous (fun x : ℝ × ℝ × ℝ => rationalF (chartCase c) x.1 x.2.1 x.2.2) := by
  have hh := (chartCheck_sound c (finite_certificate c).1).1
  have he := funext (baseF_reconstruction (chartCase c) hh)
  rw [← he]
  apply (continuous_polyEval _).div
  · fun_prop
  · intro x; exact (baseF_denominator_pos _ x).ne'

/-- Blueprint `lem:Fpositive`: the integer center certificate fixes the sign of F. -/
theorem chartF_center_pos (c : Chart) :
    0 < rationalF (chartCase c) (chartMap c (1/2, 1/2, 1/2)).1
      (chartMap c (1/2, 1/2, 1/2)).2.1 (chartMap c (1/2, 1/2, 1/2)).2.2 := by
  rcases chartCheck_sound c (finite_certificate c).1 with
    ⟨hf, _, _, hdeg, _, _, _, _, _, he⟩
  have hb : polyBound (baseF (chartCase c)) (baseFDegree (chartCase c)) := by
    rw [← hdeg]; exact polyBound_degree _
  have hs : 0 < (chartCenterData c).2.1.1 ∧ 0 < (chartCenterData c).2.1.2.1 ∧
      0 < (chartCenterData c).2.1.2.2 := by cases c <;> norm_num [chartCenterData]
  have hp := (homogeneousEval_sign hb (chartCenterData c).1 (chartCenterData c).2.1 hs).1.mp
    (show 0 < homogeneousEval (baseF (chartCase c)) (baseFDegree (chartCase c))
      (chartCenterData c).1 (chartCenterData c).2.1 by
        rw [he]; exact (finite_certificate c).2)
  rw [← chart_center_image c] at hp
  rw [← baseF_reconstruction (chartCase c) hf]
  exact div_pos hp (baseF_denominator_pos _ _)

/-- Blueprint `lem:chartfactors`: the rational time threshold lies in the open unit interval. -/
theorem chartZ_mem_open {j k : ℝ} (hj : j ∈ Set.Ioo 0 1) (hk : k ∈ Set.Ioo 0 1) :
    chartZ j k ∈ Set.Ioo 0 1 := by
  have hv := rationalV_mem hj
  have hy := rationalV_mem hk
  change rationalV j * rationalV k ∈ Set.Ioo 0 1
  exact ⟨mul_pos hv.1 hy.1, by nlinarith [hv.2, mul_pos hv.1 (sub_pos.mpr hy.2)]⟩

/-- Blueprint `lem:Fpositive`: the old time coordinate stays in the closed interval. -/
theorem chart_time_mem (c : Chart) {x : ℝ × ℝ × ℝ} (hx : InUnitCube x)
    (hj : (chartMap c x).1 ∈ Set.Ioo 0 1)
    (hk : (chartMap c x).2.1 ∈ Set.Ioo 0 1) :
    (chartMap c x).2.2 ∈ Set.Icc 0 1 := by
  rcases hx with ⟨hxj, hxk, hxt⟩
  cases c with
  | N1 => exact hxt
  | N2 => exact hxt
  | N3 =>
    change x.2.1 * x.2.2 ∈ Set.Icc 0 1
    exact ⟨mul_nonneg hxk.1 hxt.1, by nlinarith [hxt.2, mul_nonneg (sub_nonneg.mpr hxk.2) hxt.1]⟩
  | P1 => exact hxt
  | P2 => exact hxt
  | P3 =>
    have hz := chartZ_mem_open hj hk
    simp only [chartMap] at hz
    change chartZ x.1 x.2.1 * x.2.2 ∈ Set.Icc 0 1
    exact ⟨mul_nonneg hz.1.le hxt.1,
      by nlinarith [hz.1, hz.2, hxt.2, mul_nonneg (sub_nonneg.mpr hz.2.le) hxt.1]⟩
  | B1 =>
    have hz := chartZ_mem_open hj hk
    simp only [chartMap] at hz
    change chartZ ((1 + x.1)/2) ((1 + x.2.1)/2) +
      (1 - chartZ ((1 + x.1)/2) ((1 + x.2.1)/2)) * x.2.2 ∈ Set.Icc 0 1
    constructor
    · nlinarith [hz.1, hz.2, mul_nonneg (sub_nonneg.mpr hz.2.le) hxt.1]
    · nlinarith [hz.1, hz.2, mul_nonneg (sub_nonneg.mpr hz.2.le) (sub_nonneg.mpr hxt.2)]

/-- Blueprint `lem:Fpositive`, center-path: the specified segment to the cube center. -/
noncomputable def centerPath (x : ℝ × ℝ × ℝ) (t : ℝ) : ℝ × ℝ × ℝ :=
  ((1 - t) * x.1 + t / 2, (1 - t) * x.2.1 + t / 2, (1 - t) * x.2.2 + t / 2)

/-- Every noninitial coordinate of the center segment is interior. -/
theorem center_coordinate_mem {a t : ℝ} (ha : a ∈ Set.Icc 0 1)
    (ht : t ∈ Set.Ioc 0 1) : (1 - t) * a + t / 2 ∈ Set.Ioo 0 1 := by
  have h1 := mul_nonneg (sub_nonneg.mpr ht.2) ha.1
  have h2 := mul_nonneg (sub_nonneg.mpr ht.2) (sub_nonneg.mpr ha.2)
  constructor <;> nlinarith [ht.1]

/-- Blueprint `lem:Fpositive`: every point on the center path stays in the chart domain. -/
theorem centerPath_domain (c : Chart) {x : ℝ × ℝ × ℝ} (hx : InUnitCube x)
    (hj : (chartMap c x).1 ∈ Set.Ioo 0 1)
    (hk : (chartMap c x).2.1 ∈ Set.Ioo 0 1) {t : ℝ} (ht : t ∈ Set.Icc 0 1) :
    InUnitCube (centerPath x t) ∧
      (chartMap c (centerPath x t)).1 ∈ Set.Ioo 0 1 ∧
      (chartMap c (centerPath x t)).2.1 ∈ Set.Ioo 0 1 ∧
      (chartMap c (centerPath x t)).2.2 ∈ Set.Icc 0 1 := by
  by_cases hz : t = 0
  · subst t
    simpa [centerPath] using And.intro hx (And.intro hj (And.intro hk (chart_time_mem c hx hj hk)))
  · have hl : t ∈ Set.Ioc 0 1 := ⟨lt_of_le_of_ne ht.1 (Ne.symm hz), ht.2⟩
    have h1 := center_coordinate_mem hx.1 hl
    have h2 := center_coordinate_mem hx.2.1 hl
    have h3 := center_coordinate_mem hx.2.2 hl
    have hd := chart_open_domain c h1 h2 h3
    exact ⟨⟨⟨h1.1.le, h1.2.le⟩, ⟨h2.1.le, h2.2.le⟩, ⟨h3.1.le, h3.2.le⟩⟩,
      hd.1, hd.2.1, hd.2.2.1⟩

/-- Blueprint `lem:Fpositive`: F is strictly positive at every required chart
point; the continuous center path and squared gap prevent any sign change. -/
theorem Fpositive (c : Chart) {x : ℝ × ℝ × ℝ} (hx : InUnitCube x)
    (hj : (chartMap c x).1 ∈ Set.Ioo 0 1)
    (hk : (chartMap c x).2.1 ∈ Set.Ioo 0 1) :
    0 < rationalF (chartCase c) (chartMap c x).1 (chartMap c x).2.1 (chartMap c x).2.2 := by
  let f : ℝ → ℝ := fun t =>
    rationalF (chartCase c) (chartMap c (centerPath x t)).1
      (chartMap c (centerPath x t)).2.1 (chartMap c (centerPath x t)).2.2
  have hf : Continuous f := (continuous_chartF c).comp
    ((continuous_chartMap c).comp (by unfold centerPath; fun_prop))
  have h0 : f 0 = rationalF (chartCase c) (chartMap c x).1 (chartMap c x).2.1
      (chartMap c x).2.2 := by simp [f, centerPath]
  have h1 : 0 < f 1 := by simpa [f, centerPath] using chartF_center_pos c
  have hn : ∀ t ∈ Set.Icc (0 : ℝ) 1, f t ≠ 0 := by
    intro t ht
    rcases centerPath_domain c hx hj hk ht with ⟨hcube, hsj, hsk, ht⟩
    have hgap := disc_positive c hcube hsj hsk
    have hQ := rationalQ_pos (chartCase c) hsj hsk ht
    have hprod := mul_nonneg
      (sq_nonneg (rationalK (chartCase c) (chartMap c (centerPath x t)).1
        (chartMap c (centerPath x t)).2.1 (chartMap c (centerPath x t)).2.2)) hQ.le
    intro hz
    change rationalF (chartCase c) _ _ _ = 0 at hz
    rw [hz] at hgap
    nlinarith
  rw [← h0]
  by_contra h
  have hle : f 0 ≤ 0 := not_lt.mp h
  obtain ⟨t, ht, he⟩ := intermediate_value_Icc (by norm_num : (0 : ℝ) ≤ 1) hf.continuousOn
    (show (0 : ℝ) ∈ Set.Icc (f 0) (f 1) from ⟨hle, h1.le⟩)
  exact hn t ht he

/-- Blueprint `lem:Vpositive`: apply a chart certificate at the inverse rational
parameters and the matching signed time. -/
theorem certificateLower_pos_of_chart (c : Chart) {a b u τ : ℝ}
    (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1) (hu : |u| ≤ a)
    {x : ℝ × ℝ × ℝ} (hx : InUnitCube x)
    (he : chartMap c x = (rootParameter (vCoord a b), rootParameter (yCoord a b), τ))
    (ht : certificateSign (chartCase c) * τ = u / a) :
    0 < certificateLower (chartCase c) a b u := by
  have hcoord := coordinates_mem ha hb hab
  have hv := rational_parameter_inverse hcoord.1
  have hy := rational_parameter_inverse hcoord.2
  have hj : (chartMap c x).1 ∈ Set.Ioo 0 1 := by
    rw [he]; exact rootParameter_mem hcoord.1
  have hk : (chartMap c x).2.1 ∈ Set.Ioo 0 1 := by
    rw [he]; exact rootParameter_mem hcoord.2
  have hF := Fpositive c hx hj hk
  have hg := disc_positive c hx hj hk
  rw [he] at hF hg
  simp only [Prod.fst, Prod.snd, rationalF, rationalK, rationalQ, ht,
    hv.1, hv.2, hy.1, hy.2] at hF hg
  exact certificateLower_pos_of_squared _ ha hb hab hu hF hg

/-- Blueprint `lem:Vpositive`: the normalized derivative expression is strictly
positive throughout a,b>0, a+b<1, |u|≤a. -/
theorem Vpositive {a b u : ℝ} (ha : 0 < a) (hb : 0 < b) (hab : a + b < 1)
    (hu : |u| ≤ a) : 0 < V a b u := by
  have hvy := coordinates_mem ha hb hab
  have hj := rootParameter_mem hvy.1
  have hk := rootParameter_mem hvy.2
  have hv := rational_parameter_inverse hvy.1
  have hy := rational_parameter_inverse hvy.2
  have ht : |u / a| ≤ 1 := by
    rw [abs_div, abs_of_pos ha]
    exact (div_le_one ha).mpr hu
  by_cases hneg : u / a ≤ 0
  · have hτ : -(u / a) ∈ Set.Icc 0 1 := ⟨neg_nonneg.mpr hneg, by linarith [(abs_le.mp ht).1]⟩
    obtain ⟨c, x, hc, hx, he, _⟩ := negative_chart_coverage hj hk hτ
    have hsign : certificateSign (chartCase c) = -1 := by
      rcases hc with rfl | rfl | rfl <;> rfl
    have hl := certificateLower_pos_of_chart c ha hb hab hu hx he
      (by rw [hsign]; ring)
    have hcase : chartCase c = .minus := by
      rcases hc with rfl | rfl | rfl <;> rfl
    rw [hcase] at hl
    exact lt_of_lt_of_le hl (PhiMinus_le_V ha hb hab hu hneg)
  · have hτ : u / a ∈ Set.Icc 0 1 := ⟨(lt_of_not_ge hneg).le, (abs_le.mp ht).2⟩
    obtain ⟨c, x, hc, hx, he, hr⟩ := positive_chart_coverage hj hk hτ
    have hsign : certificateSign (chartCase c) = 1 := by
      rcases hc with rfl | rfl | rfl | rfl <;> rfl
    have hl := certificateLower_pos_of_chart c ha hb hab hu hx he
      (by rw [hsign]; ring)
    rcases hc with rfl | rfl | rfl | rfl
    · exact lt_of_lt_of_le hl (PhiPlus_le_V ha hb hab hu hτ.1)
    · exact lt_of_lt_of_le hl (PhiPlus_le_V ha hb hab hu hτ.1)
    · exact lt_of_lt_of_le hl (PhiPlus_le_V ha hb hab hu hτ.1)
    · change 1/2 ≤ rootParameter (vCoord a b) ∧
        1/2 ≤ rootParameter (yCoord a b) ∧
        chartZ (rootParameter (vCoord a b)) (rootParameter (yCoord a b)) ≤ u/a at hr
      have hvlarge : 4/5 ≤ vCoord a b := by
        rw [← hv.1]; exact (rationalV_thresholds hj).2.mpr hr.1
      have hylarge : 4/5 ≤ yCoord a b := by
        rw [← hy.1]; exact (rationalV_thresholds hk).2.mpr hr.2.1
      have htime : zCoord a b ≤ u/a := by
        simpa only [chartZ, hv.1, hy.1, zCoord] using hr.2.2
      exact lt_of_lt_of_le hl (Psi_le_V ha hb hab hu hvlarge hylarge htime)

/-- Blueprint `lem:Vpositive`: the full fixed-u derivative is strictly positive. -/
theorem fixed_u_derivative_pos {a b u : ℝ} (ha : 0 < a) (hb : 0 < b)
    (hab : a + b < 1) (hu : |u| ≤ a) :
    0 < 4 * a * T a b * C a b (u / a) / S a b ^ 2 * V a b u := by
  have ht : u / a ∈ Set.Icc (-1 : ℝ) 1 := by
    apply abs_le.mp
    rw [abs_div, abs_of_pos ha]
    exact (div_le_one ha).mpr hu
  have hC := C_pos ha.le hb.le hab ht
  have hsp := spatial_quantities_pos ha.le hb.le hab
  exact mul_pos (div_pos (mul_pos (mul_pos (mul_pos (by norm_num) ha) hsp.2.2.1) hC)
    (sq_pos_of_pos hsp.2.2.2)) (Vpositive ha hb hab hu)

/-- Blueprint `lem:interior-strict`: continuity of k in the first centered coordinate. -/
theorem continuousAt_k_fixed {h b : ℝ} (hh : |h| + |b| < 1) :
    ContinuousAt (fun x => k x b) h := by
  have hm := k_arguments_mem hh
  change ContinuousAt ((fun p : ℝ × ℝ => K p.1 p.2) ∘
    (fun x : ℝ => ((1 + x + b) / 2, (1 + x - b) / 2))) h
  have hmap : ContinuousAt (fun x : ℝ => ((1 + x + b) / 2, (1 + x - b) / 2)) h := by fun_prop
  exact ContinuousAt.comp (f := fun x : ℝ => ((1 + x + b) / 2, (1 + x - b) / 2))
    (x := h) (continuousAt_K hm.1 hm.2) hmap

/-- Blueprint `lem:interior-strict`: the zero-time function is continuous at zero,
using the formulas that contain no division by the varying first coordinate. -/
theorem continuousAt_zero_fixed {b : ℝ} (hb : |b| < 1) :
    ContinuousAt (fun h => C h b 0 ^ 2 * B h b 0) 0 := by
  have hk := continuousAt_k_fixed (h := 0) (by simpa using hb)
  have hkneg : ContinuousAt (fun h : ℝ => k h b) (-(0 : ℝ)) := by simpa using hk
  have hkn : ContinuousAt (fun h : ℝ => k (-h) b) 0 :=
    hkneg.comp (continuousAt_neg : ContinuousAt (fun h : ℝ => -h) 0)
  have hC : Continuous (fun h => C h b 0) := by
    unfold C e
    have hr := continuous_r
    fun_prop
  have hB : ContinuousAt (fun h => B h b 0) 0 := by
    unfold B
    fun_prop
  exact (hC.continuousAt.pow 2).mul hB

/-- Blueprint `lem:interior-strict`: the fixed-u endpoint value is k(u,b). -/
theorem fixed_u_endpoint {u b : ℝ} (hu : u ≠ 0) :
    C |u| b (u / |u|) ^ 2 * B |u| b (u / |u|) = k u b := by
  rcases lt_or_gt_of_ne hu with hneg | hpos
  · have he : u / |u| = -1 := by rw [abs_of_neg hneg]; field_simp
    rw [he, C_neg_one_t, abs_of_neg hneg]
    simp [B]
  · have he : u / |u| = 1 := by rw [abs_of_pos hpos, div_self hu]
    rw [he, C_one_t, abs_of_pos hpos]
    simp [B]

/-- Blueprint `lem:interior-strict`: monotonicity gives the strict squared margin;
the u=0 case uses a separate continuous function on [0,a]. -/
theorem fixed_u_strict_margin {a b u : ℝ} (ha : 0 < a) (hb : 0 < b)
    (hab : a + b < 1) (hu : |u| < a) :
    k u b < C a b (u / a) ^ 2 * B a b (u / a) := by
  by_cases hz : u = 0
  · subst u
    let g : ℝ → ℝ := fun h => C h b 0 ^ 2 * B h b 0
    have hg : ContinuousOn g (Set.Icc 0 a) := by
      intro h hh
      by_cases hh0 : h = 0
      · subst h
        exact (continuousAt_zero_fixed (by rw [abs_of_pos hb]; linarith)).continuousWithinAt
      · have hpos : 0 < h := lt_of_le_of_ne hh.1 (Ne.symm hh0)
        have hsum : h + b < 1 := by linarith [hh.2]
        simpa only [g, zero_div] using
          (hasDerivAt_C_sq_mul_B hpos hb hsum 0).continuousAt.continuousWithinAt
    have hmono : StrictMonoOn g (Set.Icc 0 a) :=
      strictMonoOn_of_deriv_pos (convex_Icc _ _) hg (by
        intro h hh
        rw [interior_Icc] at hh
        have hsum : h + b < 1 := by linarith [hh.2]
        have hd := hasDerivAt_C_sq_mul_B hh.1 hb hsum 0
        have hp := fixed_u_derivative_pos hh.1 hb hsum (by simpa using hh.1.le : |(0 : ℝ)| ≤ h)
        have hde := hd.deriv
        simp only [zero_div] at hde
        change 0 < deriv (fun h => C h b 0 ^ 2 * B h b 0) h
        rw [hde]
        simpa only [zero_div] using hp)
    have he : g 0 = k 0 b := by
      dsimp [g]; rw [C_zero_a]; simp [B]; ring
    have hh := hmono (show 0 ∈ Set.Icc (0 : ℝ) a from ⟨le_rfl, ha.le⟩)
      (show a ∈ Set.Icc (0 : ℝ) a from ⟨ha.le, le_rfl⟩) ha
    simpa only [he, g, zero_div] using hh
  · let g : ℝ → ℝ := fun h => C h b (u / h) ^ 2 * B h b (u / h)
    have hu0 : 0 < |u| := abs_pos.mpr hz
    have hg : ContinuousOn g (Set.Icc |u| a) := by
      intro h hh
      exact (hasDerivAt_C_sq_mul_B (hu0.trans_le hh.1) hb
        (by linarith [hh.2]) u).continuousAt.continuousWithinAt
    have hmono : StrictMonoOn g (Set.Icc |u| a) :=
      strictMonoOn_of_deriv_pos (convex_Icc _ _) hg (by
        intro h hh
        rw [interior_Icc] at hh
        have hpos : 0 < h := hu0.trans hh.1
        have hsum : h + b < 1 := by linarith [hh.2]
        rw [(hasDerivAt_C_sq_mul_B hpos hb hsum u).deriv]
        exact fixed_u_derivative_pos hpos hb hsum hh.1.le)
    have hh := hmono (show |u| ∈ Set.Icc |u| a from ⟨le_rfl, hu.le⟩)
      (show a ∈ Set.Icc |u| a from ⟨hu.le, le_rfl⟩) hu
    simpa only [g, fixed_u_endpoint hz] using hh

/-- Blueprint `lem:interior-strict`: the reduced inequality is strict when
a,b>0, a+b<1, and |t|<1. -/
theorem interior_strict {a b t : ℝ} (ha : 0 < a) (hb : 0 < b)
    (hab : a + b < 1) (ht : |t| < 1) : reducedR a b t < C a b t := by
  have htmem : t ∈ Set.Icc (-1 : ℝ) 1 := abs_le.mp ht.le
  have hu : |t * a| < a := by
    rw [abs_mul, abs_of_pos ha]
    nlinarith
  have he : t * a / a = t := by field_simp
  have hm := fixed_u_strict_margin ha hb hab hu
  rw [he] at hm
  have hB : 0 < B a b t := by linarith [B_ge_two ha.le hb.le hab htmem]
  have hC := C_pos ha.le hb.le hab htmem
  have hsq : reducedR a b t ^ 2 < C a b t ^ 2 := by
    rw [reducedR_sq ha.le hb.le hab htmem]
    exact (div_lt_iff₀ hB).mpr hm
  nlinarith [reducedR_nonneg a b t]

/-- Blueprint `lem:interior-complete`: the reduced inequality and all equality
cases on the normalized interior spatial domain. -/
theorem reduced_interior_complete {a b t : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hab : a + b < 1) (ht : t ∈ Set.Icc (-1 : ℝ) 1) :
    reducedR a b t ≤ C a b t ∧
      (reducedR a b t = C a b t ↔ a = 0 ∨ |t| = 1 ∨ (b = 0 ∧ t = 0)) := by
  by_cases ha0 : a = 0
  · subst a
    have hb' : |b| < 1 := by rw [abs_of_nonneg hb]; linarith
    simp [C_zero_a, reducedR_zero_a hb']
  · by_cases hb0 : b = 0
    · subst b
      have ha' : a ∈ Set.Ico (0 : ℝ) 1 := ⟨ha, by linarith⟩
      refine ⟨reducedR_le_C_diagonal ha' ht, ?_⟩
      rw [diagonal_equality_iff ha' ht]
      simp only [true_and]
      tauto
    · by_cases ht1 : |t| = 1
      · have hdom : |a| + |b| < 1 := by simpa [abs_of_nonneg ha, abs_of_nonneg hb] using hab
        have habs : |t| = |(1 : ℝ)| := by simpa using ht1
        rcases abs_eq_abs.mp habs with rfl | rfl
        · simp [C_one_t, reducedR_one_t hdom]
        · simp [C_neg_one_t, reducedR_neg_one_t hdom]
      · have hlt := interior_strict (lt_of_le_of_ne ha (Ne.symm ha0))
          (lt_of_le_of_ne hb (Ne.symm hb0)) hab
          (lt_of_le_of_ne (abs_le.mpr ht) ht1)
        exact ⟨hlt.le, by simp [hlt.ne, ha0, hb0, ht1]⟩

/-- Blueprint `lem:interior-complete`: exact translation of the normalized
exceptional sets, with the convention t=1-2s. -/
theorem normalized_equality_iff (s c d : ℝ) :
    (c + d - 1 = 0 ∨ |1 - 2*s| = 1 ∨ (d - c = 0 ∧ 1 - 2*s = 0)) ↔
      equalityCase s c d := by
  constructor
  · rintro (hsum | ht | ⟨hdiag, ht⟩)
    · exact Or.inr (Or.inr (Or.inl (by linarith)))
    · have he : |1 - 2*s| = |(1 : ℝ)| := by simpa using ht
      rcases abs_eq_abs.mp he with he | he
      · exact Or.inl (by linarith)
      · exact Or.inr (Or.inl (by linarith))
    · exact Or.inr (Or.inr (Or.inr ⟨by linarith, by linarith⟩))
  · rintro (hs | hs | hsum | ⟨hs, hdiag⟩)
    · right; left; simp [hs]
    · right; left; norm_num [hs]
    · left; linarith
    · right; right; constructor <;> linarith

/-- Blueprint `lem:interior-complete`: for interior c,d and closed-interval s,
the original reduced inequality holds, with exactly the four stated equality sets. -/
theorem interior_complete {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Ioo (0 : ℝ) 1) (hd : d ∈ Set.Ioo (0 : ℝ) 1) :
    R s c d ≤ originalC s c d ∧ (R s c d = originalC s c d ↔ equalityCase s c d) := by
  obtain ⟨s', c', d', hs', hc', hd', hsum, hsort, hR, hC, heq⟩ :=
    exists_normalized_triple hs hc hd
  rcases normalized_coordinates_mem hs' hd'.2 hsum hsort with ⟨ha, hb, hab, ht⟩
  have h := reduced_interior_complete ha hb hab ht
  rw [← R_eq_reducedR hs' hc' hd', C_eq_originalC] at h
  rw [normalized_equality_iff] at h
  simpa only [hR, hC, heq] using h

/-- Blueprint `lem:boundary`: the exceptional boundary branches have C=1. -/
theorem originalC_exceptional {s c d : ℝ} (h : s = 0 ∨ s = 1 ∨ c + d = 1) :
    originalC s c d = 1 := by
  rw [← C_eq_originalC]
  rcases h with rfl | rfl | hsum
  · simpa using C_one_t (c + d - 1) (d - c)
  · convert C_neg_one_t (c + d - 1) (d - c) using 1 <;> norm_num
  · rw [show c + d - 1 = 0 by linarith, C_zero_a]

/-- Blueprint `lem:boundary`: the comparison function is nonnegative. -/
theorem originalC_nonneg {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1) :
    0 ≤ originalC s c d := by
  have h1 := mul_nonneg hs.1 (r_nonneg (2*d-1))
  have h2 := mul_nonneg (sub_nonneg.mpr hs.2) (r_nonneg (2*c-1))
  unfold originalC
  linarith [r_le_one (2*q s c d-1)]

/-- Blueprint `lem:boundary`: a zero semicircle value forces an endpoint. -/
theorem endpoint_of_r_zero {c : ℝ} (hc : c ∈ Set.Icc (0 : ℝ) 1)
    (hr : r (2*c-1) = 0) : c = 0 ∨ c = 1 := by
  have ha : |2*c-1| ≤ 1 := by rw [abs_le]; constructor <;> linarith [hc.1, hc.2]
  rcases (r_eq_zero_iff ha).mp hr with he | he
  · right; linarith
  · left; linarith

/-- Blueprint `lem:boundary`: outside the exceptional branches, C=0 forces
equal endpoints and s=1/2. -/
theorem originalC_zero_forces_equality {s c d : ℝ}
    (hs : s ∈ Set.Ioo (0 : ℝ) 1) (hc : c ∈ Set.Icc (0 : ℝ) 1)
    (hd : d ∈ Set.Icc (0 : ℝ) 1) (hsum : c + d ≠ 1)
    (hzero : originalC s c d = 0) : s = 1/2 ∧ c = d := by
  have hs0 := hs.1
  have hs1 : 0 < 1-s := sub_pos.mpr hs.2
  have hrc := r_nonneg (2*c-1)
  have hrd := r_nonneg (2*d-1)
  have hqle := r_le_one (2*q s c d-1)
  have hp1 := mul_nonneg hs0.le hrd
  have hp2 := mul_nonneg hs1.le hrc
  unfold originalC at hzero
  have hcr : r (2*c-1) = 0 := by nlinarith
  have hdr : r (2*d-1) = 0 := by nlinarith
  have hqr : r (2*q s c d-1) = 1 := by nlinarith
  have hq := (r_eq_one_iff (2*q s c d-1)).mp hqr
  rcases endpoint_of_r_zero hc hcr with rfl | rfl <;>
    rcases endpoint_of_r_zero hd hdr with rfl | rfl
  · constructor
    · simp only [q, sub_zero, mul_one, mul_zero, add_zero] at hq
      linarith
    · rfl
  · norm_num at hsum
  · norm_num at hsum
  · constructor
    · simp only [q, sub_self, mul_zero, mul_one, zero_add] at hq
      linarith
    · rfl

/-- Blueprint `lem:boundary`: at a spatial boundary point, equal spatial
coordinates and s=1/2 give C=0. -/
theorem boundary_diagonal_C_zero {s c d : ℝ}
    (hc : c ∈ Set.Icc (0 : ℝ) 1) (hd : d ∈ Set.Icc (0 : ℝ) 1)
    (hboundary : ¬ (c ∈ Set.Ioo (0 : ℝ) 1 ∧ d ∈ Set.Ioo (0 : ℝ) 1))
    (hs : s = 1/2) (he : c = d) : originalC s c d = 0 := by
  subst d
  subst s
  have hend : c = 0 ∨ c = 1 := by
    by_cases h0 : c = 0
    · exact Or.inl h0
    · right
      by_contra h1
      have hi : c ∈ Set.Ioo (0 : ℝ) 1 :=
        ⟨lt_of_le_of_ne hc.1 (Ne.symm h0), lt_of_le_of_ne hc.2 h1⟩
      exact hboundary ⟨hi, hi⟩
  rcases hend with rfl | rfl <;> norm_num [originalC, q, r]

/-- Blueprint `lem:boundary`: R≤C on every spatial boundary face, with exactly
s=0, s=1, c+d=1, or s=1/2 and c=d as the equality cases. -/
theorem boundary_complete {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Icc (0 : ℝ) 1) (hd : d ∈ Set.Icc (0 : ℝ) 1)
    (hboundary : ¬ (c ∈ Set.Ioo (0 : ℝ) 1 ∧ d ∈ Set.Ioo (0 : ℝ) 1)) :
    R s c d ≤ originalC s c d ∧ (R s c d = originalC s c d ↔ equalityCase s c d) := by
  by_cases hex : s = 0 ∨ s = 1 ∨ c+d = 1
  · have hR : R s c d = 1 := by
      unfold R
      rw [ite_eq_left ⟨hs, hc, hd⟩, ite_eq_right hboundary, ite_eq_left hex]
    have hC := originalC_exceptional hex
    have he : equalityCase s c d := by
      rcases hex with h | h | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (Or.inl h))
    simp [hR, hC, he]
  · have hR : R s c d = 0 := by
      unfold R
      rw [ite_eq_left ⟨hs, hc, hd⟩, ite_eq_right hboundary, ite_eq_right hex]
    have hs0 : s ≠ 0 := fun h => hex (Or.inl h)
    have hs1 : s ≠ 1 := fun h => hex (Or.inr (Or.inl h))
    have hsum : c+d ≠ 1 := fun h => hex (Or.inr (Or.inr h))
    have hsi : s ∈ Set.Ioo (0 : ℝ) 1 :=
      ⟨lt_of_le_of_ne hs.1 (Ne.symm hs0), lt_of_le_of_ne hs.2 hs1⟩
    refine ⟨by rw [hR]; exact originalC_nonneg hs, ?_⟩
    rw [hR]
    constructor
    · intro he
      exact Or.inr (Or.inr (Or.inr (originalC_zero_forces_equality hsi hc hd hsum he.symm)))
    · rintro (he | he | he | ⟨he, hdiag⟩)
      · exact (hs0 he).elim
      · exact (hs1 he).elim
      · exact (hsum he).elim
      · exact (boundary_diagonal_C_zero hc hd hboundary he hdiag).symm

/-- Blueprint `thm:main`: the comparison inequality on the entire closed cube,
with its complete equality characterization, combining interior and boundary. -/
theorem three_point_comparison {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Icc (0 : ℝ) 1) (hd : d ∈ Set.Icc (0 : ℝ) 1) :
    R s c d ≤ originalC s c d ∧
      (R s c d = originalC s c d ↔ equalityCase s c d) := by
  by_cases hi : c ∈ Set.Ioo (0 : ℝ) 1 ∧ d ∈ Set.Ioo (0 : ℝ) 1
  · exact interior_complete hs hi.1 hi.2
  · exact boundary_complete hs hc hd hi

/-- Blueprint `thm:main`, equation (main-ineq): for every s,c,d in [0,1],
r(2q-1) - s r(2d-1) - (1-s) r(2c-1) + R(s,c,d) ≤ 1.
The definitions of K and R include the prescribed diagonal and boundary values. -/
theorem three_point_inequality {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Icc (0 : ℝ) 1) (hd : d ∈ Set.Icc (0 : ℝ) 1) :
    r (2 * q s c d - 1) - s * r (2 * d - 1) -
      (1 - s) * r (2 * c - 1) + R s c d ≤ 1 :=
  (three_point_iff_R_le_C s c d).mpr (three_point_comparison hs hc hd).1

/-- Blueprint `thm:main`, equation (main-equality): equality in the three-point
inequality holds exactly when s=0, s=1, c+d=1, or s=1/2 and c=d. -/
theorem three_point_equality_iff {s c d : ℝ} (hs : s ∈ Set.Icc (0 : ℝ) 1)
    (hc : c ∈ Set.Icc (0 : ℝ) 1) (hd : d ∈ Set.Icc (0 : ℝ) 1) :
    (r (2 * q s c d - 1) - s * r (2 * d - 1) -
      (1 - s) * r (2 * c - 1) + R s c d = 1) ↔
      s = 0 ∨ s = 1 ∨ c + d = 1 ∨ (s = 1 / 2 ∧ c = d) := by
  have he : (r (2 * q s c d - 1) - s * r (2 * d - 1) -
      (1 - s) * r (2 * c - 1) + R s c d = 1) ↔ R s c d = originalC s c d := by
    unfold originalC
    constructor <;> intro h <;> linarith
  exact he.trans (three_point_comparison hs hc hd).2

end Auto
